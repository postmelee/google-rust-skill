+#[test]
+fn names_are_validated_without_normalizing_or_reordering_them() {
+    let names = [
+        "zeta", " shared ", "shared", "Shared", "문서", "é", "e\u{301}", "α",
+    ];
+    let mut catalog = vec![
+        Value::Null,
+        json!(false),
+        json!(17),
+        json!("scalar"),
+        json!([]),
+        json!({}),
+        json!({"name": null}),
+        json!({"name": false}),
+        json!({"name": 17}),
+        json!({"name": []}),
+        json!({"name": {}}),
+        json!({"name": ""}),
+        json!({"name": " \t\r\n"}),
+        json!({"name": "\u{a0}\u{2003}\u{3000}"}),
+    ];
+    for name in names {
+        catalog.push(json!({"name": name}));
+        catalog.push(json!({"name": "\t"}));
+    }
+    for name in names.iter().rev() {
+        catalog.push(json!({"name": name}));
+    }
+    let capabilities = json!({"version": "catalog-test", "commands": catalog});
+    let body = ontology(&capabilities, &catalog);
+    let retained = actions(&body);
+    let expected: Vec<_> = ["cmd", "tool"]
+        .into_iter()
+        .flat_map(|namespace| {
+            names
+                .iter()
+                .map(move |name| (format!("rhwp:{namespace}/{name}"), *name))
+        })
+        .collect();
+    let actual: Vec<_> = retained
+        .iter()
+        .map(|node| {
+            (
+                node["@id"].as_str().expect("action ID").to_owned(),
+                node["rdfs:label"].as_str().expect("action label"),
+            )
+        })
+        .collect();
+    assert_eq!(actual, expected);
+    let env = envelope(&capabilities, &catalog);
+    assert_eq!(env["actionCount"], names.len() * 2);
+    assert_eq!(env["ontology"], body);
+    assert_eq!(env["schemaVersion"], "1.0");
+
+    let empty_env = envelope(&json!({"version": "catalog-test", "commands": []}), &[]);
+    let non_actions: Vec<_> = body["@graph"]
+        .as_array()
+        .expect("graph array")
+        .iter()
+        .filter(|node| !retained.contains(node))
+        .cloned()
+        .collect();
+    assert_eq!(json!(non_actions), empty_env["ontology"]["@graph"]);
+    assert_eq!(env["classCount"], empty_env["classCount"]);
+    assert_eq!(env["propertyCount"], empty_env["propertyCount"]);
+}
+
+#[test]
+fn invalid_or_empty_catalogs_emit_no_actions() {
+    let invalid_tools = vec![json!({}), json!({"name": "\n\u{3000}"}), json!({"name": 1})];
+    for capabilities in [
+        Value::Null,
+        json!({}),
+        json!({"commands": null}),
+        json!({"commands": {"name": "not-an-array"}}),
+        json!({"commands": []}),
+        json!({"commands": invalid_tools}),
+    ] {
+        let env = envelope(&capabilities, &invalid_tools);
+        assert!(actions(&env["ontology"]).is_empty());
+        assert_eq!(env["actionCount"], 0);
+    }
+}
