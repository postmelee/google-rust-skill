+use rhwp_contracts::ontology::{envelope, ontology};
+use serde_json::{json, Value};
+
+fn actions(body: &Value) -> Vec<&Value> {
+    body["@graph"]
+        .as_array()
+        .expect("graph array")
+        .iter()
+        .filter(|node| {
+            node["@type"]
+                .as_array()
+                .is_some_and(|types| types.iter().any(|kind| kind == "rhwp:Action"))
+        })
+        .collect()
+}
+
+#[test]
+fn first_occurrence_keeps_all_command_and_tool_metadata() {
+    let first_command = json!({
+        "name": "catalog-action",
+        "summary": " First command summary ",
+        "category": "query",
+        "json": true,
+        "batch": false,
+        "flags": ["--json", {"name": "--path", "required": true}],
+        "recordFields": ["title", {"name": "pages", "type": "integer"}],
+        "subcommands": [{"name": "nested", "flags": ["--detail"]}],
+        "requiresFeature": "catalog",
+        "available": false
+    });
+    let first_tool = json!({
+        "name": "catalog-action",
+        "description": " First tool description ",
+        "cli": {"command": "catalog-action"},
+        "inputSchema": {
+            "properties": {"path": {"type": "string"}, "options": {}},
+            "required": ["path"]
+        },
+        "outputFields": [{"name": "title", "type": "string"}],
+        "annotations": {"readOnlyHint": true, "custom": {"source": "first"}}
+    });
+    let capabilities = json!({"commands": [
+        first_command,
+        {"name": "catalog-action", "summary": "Replacement", "available": true},
+        {"name": "catalog-action"}
+    ]});
+    let tools = vec![
+        first_tool,
+        json!({
+            "name": "catalog-action",
+            "description": "Replacement",
+            "cli": {"command": "other"},
+            "annotations": {"readOnlyHint": false}
+        }),
+    ];
+    let original_capabilities = capabilities.clone();
+    let original_tools = tools.clone();
+    let body = ontology(&capabilities, &tools);
+    assert_eq!(
+        actions(&body),
+        vec![
+            &json!({
+                "@id": "rhwp:cmd/catalog-action",
+                "@type": ["rhwp:Action", "schema:Action"],
+                "rdfs:label": "catalog-action",
+                "rdfs:comment": " First command summary ",
+                "rhwp:category": "query",
+                "rhwp:json": true,
+                "rhwp:batch": false,
+                "rhwp:flags": ["--json", {"name": "--path", "required": true}],
+                "rhwp:recordFields": ["title", {"name": "pages", "type": "integer"}],
+                "rhwp:subcommands": [{"name": "nested", "flags": ["--detail"]}],
+                "rhwp:requiresFeature": "catalog",
+                "rhwp:available": false
+            }),
+            &json!({
+                "@id": "rhwp:tool/catalog-action",
+                "@type": ["rhwp:Action", "schema:Action"],
+                "rdfs:label": "catalog-action",
+                "rdfs:comment": " First tool description ",
+                "rhwp:implementsCommand": {"@id": "rhwp:cmd/catalog-action"},
+                "rhwp:inputProperties": ["options", "path"],
+                "rhwp:requiredInputs": ["path"],
+                "rhwp:outputFields": [{"name": "title", "type": "string"}],
+                "rhwp:annotations": {"readOnlyHint": true, "custom": {"source": "first"}}
+            })
+        ]
+    );
+    assert_eq!(capabilities, original_capabilities);
+    assert_eq!(tools, original_tools);
+}
