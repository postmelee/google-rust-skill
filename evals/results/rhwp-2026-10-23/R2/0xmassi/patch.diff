+#[test]
+fn names_are_validated_without_normalizing_or_sharing_namespaces() {
+    let names = [
+        "alpha", "Alpha", " alpha ", "문서", "é", "e\u{301}", "\u{200d}",
+    ];
+    let mut catalog = vec![
+        Value::Null,
+        json!("not an entry"),
+        json!({}),
+        json!({"name": null}),
+        json!({"name": false}),
+        json!({"name": 42}),
+        json!({"name": []}),
+        json!({"name": {}}),
+        json!({"name": ""}),
+        json!({"name": " \t\r\n"}),
+        json!({"name": "\u{00a0}\u{3000}"}),
+    ];
+    for name in names {
+        catalog.push(json!({"name": name}));
+    }
+    for name in names {
+        catalog.push(json!({"name": name, "summary": "Duplicate"}));
+    }
+    let capabilities = json!({"version": "test-version", "commands": catalog});
+    let original_capabilities = capabilities.clone();
+    let original_tools = catalog.clone();
+    let body = ontology::ontology(&capabilities, &catalog);
+    let envelope = ontology::envelope(&capabilities, &catalog);
+    let retained = actions(&body);
+    assert_eq!(retained.len(), names.len() * 2);
+    for (index, name) in names.iter().enumerate() {
+        assert_eq!(retained[index]["@id"], format!("rhwp:cmd/{name}"));
+        assert_eq!(retained[index]["rdfs:label"], *name);
+        assert_eq!(
+            retained[index + names.len()]["@id"],
+            format!("rhwp:tool/{name}")
+        );
+        assert_eq!(retained[index + names.len()]["rdfs:label"], *name);
+    }
+    assert_eq!(envelope["ontology"], body);
+    assert_eq!(envelope["actionCount"], names.len() * 2);
+    assert_eq!(envelope["schemaVersion"], "1.0");
+    assert_eq!(capabilities, original_capabilities);
+    assert_eq!(catalog, original_tools);
+
+    let empty = ontology::envelope(&json!({"version": "test-version"}), &[]);
+    let graph = body["@graph"].as_array().expect("ontology graph");
+    let unchanged = empty["ontology"]["@graph"].as_array().expect("empty graph");
+    assert_eq!(&graph[..unchanged.len()], unchanged);
+    assert_eq!(graph.len(), unchanged.len() + names.len() * 2);
+    assert_eq!(envelope["classCount"], empty["classCount"]);
+    assert_eq!(envelope["propertyCount"], empty["propertyCount"]);
+}
