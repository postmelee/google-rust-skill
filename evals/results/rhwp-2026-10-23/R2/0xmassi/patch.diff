+#[test]
+fn absent_or_invalid_catalogs_have_no_actions() {
+    let invalid_entries = vec![
+        json!({"name": ""}),
+        json!({"name": " \t"}),
+        json!({"name": 1}),
+    ];
+    let capabilities_cases = [
+        Value::Null,
+        json!({}),
+        json!({"commands": null}),
+        json!({"commands": {"name": "not an array"}}),
+        json!({"commands": []}),
+        json!({"commands": invalid_entries}),
+    ];
+    for capabilities in capabilities_cases {
+        let envelope = ontology::envelope(&capabilities, &invalid_entries);
+        assert!(actions(&envelope["ontology"]).is_empty());
+        assert_eq!(envelope["actionCount"], 0);
+    }
+}
