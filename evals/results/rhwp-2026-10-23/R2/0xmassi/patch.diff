+use rhwp_contracts::ontology;
+use serde_json::{json, Value};
+
+fn actions(body: &Value) -> Vec<&Value> {
+    body["@graph"]
+        .as_array()
+        .expect("ontology graph must be an array")
+        .iter()
+        .filter(|node| {
+            node["@type"]
+                .as_array()
+                .is_some_and(|types| types.iter().any(|kind| kind == "rhwp:Action"))
+        })
+        .collect()
+}
+
+#[test]
+fn command_duplicates_keep_first_metadata_and_order() {
+    let first = json!({
+        "name": "info",
+        "summary": "First description",
+        "category": "query",
+        "json": true,
+        "batch": false,
+        "flags": ["--json", {"name": "--verbose"}],
+        "recordFields": ["title", "fonts"],
+        "subcommands": [{"name": "nested"}],
+        "requiresFeature": "read",
+        "available": false
+    });
+    let capabilities = json!({"commands": [
+        first,
+        {"name": "bare"},
+        {"name": "info", "summary": "Replacement", "category": "other", "available": true},
+        {"name": "bare", "summary": "Should not be merged", "flags": ["--late"]}
+    ]});
+    let body = ontology::ontology(&capabilities, &[]);
+    let retained = actions(&body);
+    assert_eq!(retained.len(), 2);
+    assert_eq!(retained[0]["@id"], "rhwp:cmd/info");
+    assert_eq!(retained[0]["rdfs:label"], "info");
+    assert_eq!(retained[0]["rdfs:comment"], "First description");
+    assert_eq!(retained[0]["rhwp:category"], "query");
+    assert_eq!(retained[0]["rhwp:json"], true);
+    assert_eq!(retained[0]["rhwp:batch"], false);
+    assert_eq!(retained[0]["rhwp:flags"], first["flags"]);
+    assert_eq!(retained[0]["rhwp:recordFields"], first["recordFields"]);
+    assert_eq!(retained[0]["rhwp:subcommands"], first["subcommands"]);
+    assert_eq!(retained[0]["rhwp:requiresFeature"], "read");
+    assert_eq!(retained[0]["rhwp:available"], false);
+    let single = ontology::ontology(&json!({"commands": [first]}), &[]);
+    assert_eq!(retained[0], actions(&single)[0]);
+    assert!(retained[0].get("rhwp:untrustedFields").is_some());
+    assert!(retained[0].get("rhwp:provenanceNote").is_some());
+    assert_eq!(
+        retained[1],
+        &json!({
+            "@id": "rhwp:cmd/bare",
+            "@type": ["rhwp:Action", "schema:Action"],
+            "rdfs:label": "bare"
+        })
+    );
+}
+
+#[test]
+fn tool_duplicates_keep_first_metadata_and_order() {
+    let tools = vec![
+        json!({
+            "name": "reader",
+            "description": "First tool description",
+            "cli": {"command": "info"},
+            "inputSchema": {
+                "properties": {"path": {}, "format": {}},
+                "required": ["path"]
+            },
+            "outputFields": ["title"],
+            "annotations": {"readOnlyHint": true, "custom": {"nested": [1, false]}}
+        }),
+        json!({"name": "bare"}),
+        json!({
+            "name": "reader",
+            "description": "Replacement",
+            "cli": {"command": "dump"},
+            "inputSchema": {"properties": {"replacement": {}}, "required": []},
+            "outputFields": [],
+            "annotations": {"readOnlyHint": false}
+        }),
+        json!({"name": "bare", "description": "Should not be merged"}),
+    ];
+    let body = ontology::ontology(&json!({}), &tools);
+    assert_eq!(
+        actions(&body),
+        vec![
+            &json!({
+                "@id": "rhwp:tool/reader",
+                "@type": ["rhwp:Action", "schema:Action"],
+                "rdfs:label": "reader",
+                "rdfs:comment": "First tool description",
+                "rhwp:implementsCommand": {"@id": "rhwp:cmd/info"},
+                "rhwp:inputProperties": ["format", "path"],
+                "rhwp:requiredInputs": ["path"],
+                "rhwp:outputFields": ["title"],
+                "rhwp:annotations": {"readOnlyHint": true, "custom": {"nested": [1, false]}}
+            }),
+            &json!({
+                "@id": "rhwp:tool/bare",
+                "@type": ["rhwp:Action", "schema:Action"],
+                "rdfs:label": "bare"
+            })
+        ]
+    );
+}
