+#[test]
+fn valid_names_preserve_exact_spelling_order_and_separate_namespaces() {
+    let names = [
+        "zeta", "Alpha", "alpha", " alpha ", "동작", "é", "e\u{301}", "\u{200b}",
+    ];
+    let invalid = vec![
+        Value::Null,
+        json!(false),
+        json!(17),
+        json!([]),
+        json!({}),
+        json!({"name": null}),
+        json!({"name": false}),
+        json!({"name": 17}),
+        json!({"name": []}),
+        json!({"name": {}}),
+        json!({"name": ""}),
+        json!({"name": " \t\r\n"}),
+        json!({"name": "\u{00a0}\u{2003}\u{3000}"}),
+    ];
+    let mut commands = invalid.clone();
+    let mut tools = invalid.clone();
+    for name in names {
+        commands.push(json!({"name": name}));
+        commands.extend(invalid.iter().cloned());
+        commands.push(json!({"name": name, "summary": "Duplicate"}));
+    }
+    let reversed_names = names.iter().rev();
+    for name in reversed_names {
+        tools.push(json!({"name": name}));
+        tools.extend(invalid.iter().cloned());
+        tools.push(json!({"name": name, "description": "Duplicate"}));
+    }
+    let capabilities = json!({"commands": commands});
+    let envelope = ontology::envelope(&capabilities, &tools);
+    let retained = actions(&envelope["ontology"]);
+    assert_eq!(retained.len(), names.len() * 2);
+    let command_actions = retained[..names.len()].iter().zip(names);
+    for (node, name) in command_actions {
+        assert_eq!(node["@id"], format!("rhwp:cmd/{name}"));
+        assert_eq!(node["rdfs:label"], name);
+        assert!(node.get("rdfs:comment").is_none());
+    }
+    let tool_actions = retained[names.len()..].iter().zip(names.iter().rev());
+    for (node, name) in tool_actions {
+        assert_eq!(node["@id"], format!("rhwp:tool/{name}"));
+        assert_eq!(node["rdfs:label"], *name);
+        assert!(node.get("rdfs:comment").is_none());
+    }
+    assert_eq!(envelope["actionCount"], names.len() * 2);
+    assert_eq!(
+        ontology::ontology(&capabilities, &tools),
+        envelope["ontology"]
+    );
+    let baseline = ontology::envelope(&json!({}), &[]);
+    let graph = envelope["ontology"]["@graph"]
+        .as_array()
+        .expect("graph array");
+    let baseline_graph = baseline["ontology"]["@graph"]
+        .as_array()
+        .expect("baseline graph array");
+    assert_eq!(&graph[..baseline_graph.len()], baseline_graph);
+    assert_eq!(envelope["classCount"], baseline["classCount"]);
+    assert_eq!(envelope["propertyCount"], baseline["propertyCount"]);
+}
+
+#[test]
+fn invalid_only_catalogs_emit_no_actions_and_do_not_affect_later_calls() {
+    let baseline = ontology::envelope(&json!({}), &[]);
+    let invalid_tools = [json!({"name": "\t"}), json!({"name": null}), json!({})];
+    for capabilities in [
+        Value::Null,
+        json!({}),
+        json!({"commands": null}),
+        json!({"commands": "invalid"}),
+        json!({"commands": {"name": "invalid-container"}}),
+        json!({"commands": []}),
+        json!({"commands": [{"name": ""}, {"name": " \n"}, {"name": 3}]}),
+    ] {
+        assert_eq!(ontology::envelope(&capabilities, &invalid_tools), baseline);
+    }
+    let capabilities = json!({"commands": [{"name": "repeat"}, {"name": "repeat"}]});
+    let tools = [json!({"name": "repeat"}), json!({"name": "repeat"})];
+    let first = ontology::envelope(&capabilities, &tools);
+    assert_eq!(first["actionCount"], 2);
+    assert_eq!(ontology::envelope(&capabilities, &tools), first);
+}
