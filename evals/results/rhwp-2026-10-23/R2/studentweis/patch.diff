+use rhwp_contracts::ontology;
+use serde_json::{json, Value};
+
+fn actions(body: &Value) -> Vec<&Value> {
+    body["@graph"]
+        .as_array()
+        .expect("ontology graph is an array")
+        .iter()
+        .filter(|node| {
+            node["@type"]
+                .as_array()
+                .is_some_and(|types| types.iter().any(|kind| kind == "rhwp:Action"))
+        })
+        .collect()
+}
+
+#[test]
+fn first_occurrences_keep_all_metadata_without_merging_later_duplicates() {
+    let command = json!({
+        "name": "shared",
+        "summary": "First command",
+        "category": "query",
+        "json": true,
+        "batch": false,
+        "flags": ["--first"],
+        "recordFields": ["title"],
+        "subcommands": [{"name": "nested"}],
+        "requiresFeature": "feature-a",
+        "available": false
+    });
+    let tool = json!({
+        "name": "shared",
+        "description": "First tool",
+        "cli": {"command": "shared"},
+        "inputSchema": {
+            "properties": {"path": {"type": "string"}, "mode": {}},
+            "required": ["path"]
+        },
+        "outputFields": ["title", {"nested": [1, null]}],
+        "annotations": {"readOnlyHint": true, "extra": {"value": 3}}
+    });
+    let capabilities = json!({
+        "version": "test-version",
+        "commands": [
+            command,
+            {"name": "sparse"},
+            {"name": "shared", "summary": "Replacement", "available": true},
+            {"name": "sparse", "flags": ["--later"]}
+        ]
+    });
+    let tools = vec![
+        tool.clone(),
+        json!({"name": "sparse"}),
+        json!({"name": "shared", "description": "Replacement", "annotations": null}),
+        json!({"name": "sparse", "outputFields": ["later"]}),
+    ];
+    let original_capabilities = capabilities.clone();
+    let original_tools = tools.clone();
+    let expected = ontology::ontology(
+        &json!({"version": "test-version", "commands": [command, {"name": "sparse"}]}),
+        &[tool, json!({"name": "sparse"})],
+    );
+    let body = ontology::ontology(&capabilities, &tools);
+    assert_eq!(
+        body, expected,
+        "only the first occurrence may contribute metadata"
+    );
+    let retained = actions(&body);
+    assert_eq!(retained.len(), 4);
+    assert_eq!(
+        retained[0],
+        &json!({
+            "@id": "rhwp:cmd/shared",
+            "@type": ["rhwp:Action", "schema:Action"],
+            "rdfs:label": "shared",
+            "rdfs:comment": "First command",
+            "rhwp:category": "query",
+            "rhwp:json": true,
+            "rhwp:batch": false,
+            "rhwp:flags": ["--first"],
+            "rhwp:recordFields": ["title"],
+            "rhwp:subcommands": [{"name": "nested"}],
+            "rhwp:requiresFeature": "feature-a",
+            "rhwp:available": false
+        })
+    );
+    assert_eq!(
+        retained[2],
+        &json!({
+            "@id": "rhwp:tool/shared",
+            "@type": ["rhwp:Action", "schema:Action"],
+            "rdfs:label": "shared",
+            "rdfs:comment": "First tool",
+            "rhwp:implementsCommand": {"@id": "rhwp:cmd/shared"},
+            "rhwp:inputProperties": ["mode", "path"],
+            "rhwp:requiredInputs": ["path"],
+            "rhwp:outputFields": ["title", {"nested": [1, null]}],
+            "rhwp:annotations": {"readOnlyHint": true, "extra": {"value": 3}}
+        })
+    );
+    let envelope = ontology::envelope(&capabilities, &tools);
+    assert_eq!(envelope["ontology"], body);
+    assert_eq!(envelope["actionCount"], 4);
+    assert_eq!(envelope["schemaVersion"], "1.0");
+    assert_eq!(capabilities, original_capabilities);
+    assert_eq!(tools, original_tools);
+}
