+#[test]
+fn invalid_names_are_ignored_and_nonblank_names_remain_exact() {
+    let mut entries = vec![
+        Value::Null,
+        json!(false),
+        json!(42),
+        json!("not an entry"),
+        json!([]),
+        json!({}),
+        json!({"name": null}),
+        json!({"name": false}),
+        json!({"name": 42}),
+        json!({"name": []}),
+        json!({"name": {}}),
+        json!({"name": ""}),
+        json!({"name": " \t\r\n"}),
+        json!({"name": "\u{00a0}\u{2003}\u{3000}"}),
+    ];
+    let names = [
+        "run",
+        "Run",
+        " run ",
+        "문서",
+        "문서 ",
+        "é",
+        "e\u{0301}",
+        "\t工具\n",
+    ];
+    for name in names {
+        entries.push(json!({"name": name}));
+        entries.push(json!({"name": name, "summary": "Duplicate", "description": "Duplicate"}));
+    }
+    let capabilities = json!({"commands": entries});
+    let original_capabilities = capabilities.clone();
+    let original_tools = entries.clone();
+    let envelope = ontology::envelope(&capabilities, &entries);
+    let body = &envelope["ontology"];
+    let retained = actions(body);
+    assert_eq!(retained.len(), names.len() * 2);
+    assert_eq!(envelope["actionCount"], json!(retained.len()));
+    for (namespace_index, namespace) in ["cmd", "tool"].iter().enumerate() {
+        for (name_index, name) in names.iter().enumerate() {
+            let node = retained[namespace_index * names.len() + name_index];
+            assert_eq!(node["rdfs:label"], *name);
+            assert_eq!(node["@id"], format!("rhwp:{namespace}/{name}"));
+            assert!(node.get("rdfs:comment").is_none());
+        }
+    }
+    let mut seen = HashSet::new();
+    for node in body["@graph"].as_array().expect("ontology graph") {
+        let id = node["@id"].as_str().expect("each graph node has an ID");
+        assert!(seen.insert(id), "duplicate graph ID: {id}");
+    }
+    assert_eq!(capabilities, original_capabilities);
+    assert_eq!(entries, original_tools);
+}
+
+#[test]
+fn empty_or_malformed_catalogs_preserve_the_ir_graph_and_counts() {
+    let baseline = ontology::envelope(&json!({}), &[]);
+    assert_eq!(baseline["actionCount"], 0);
+    assert!(baseline["classCount"].as_u64().expect("class count") > 0);
+    assert!(baseline["propertyCount"].as_u64().expect("property count") > 0);
+    let invalid_entries = vec![
+        json!({}),
+        json!({"name": null}),
+        json!({"name": 10}),
+        json!({"name": ""}),
+        json!({"name": "\t\n\u{2003}"}),
+    ];
+    for capabilities in [
+        Value::Null,
+        json!({}),
+        json!({"commands": null}),
+        json!({"commands": false}),
+        json!({"commands": 42}),
+        json!({"commands": "invalid"}),
+        json!({"commands": {"name": "run"}}),
+        json!({"commands": []}),
+        json!({"commands": invalid_entries}),
+    ] {
+        assert_eq!(
+            ontology::envelope(&capabilities, &invalid_entries),
+            baseline,
+            "invalid entries must not affect IR nodes or counts: {capabilities}"
+        );
+    }
+}
