+use std::collections::HashSet;
+
+use rhwp_contracts::ontology;
+use serde_json::{json, Value};
+
+fn actions(body: &Value) -> Vec<&Value> {
+    body["@graph"]
+        .as_array()
+        .expect("ontology must contain a graph")
+        .iter()
+        .filter(|node| {
+            node["@type"]
+                .as_array()
+                .is_some_and(|types| types.iter().any(|kind| kind == "rhwp:Action"))
+        })
+        .collect()
+}
+
+#[test]
+fn duplicate_catalogs_retain_first_metadata_and_order() {
+    let first_command = json!({
+        "name": "info",
+        "summary": "First command description",
+        "category": "query",
+        "json": true,
+        "batch": false,
+        "flags": ["--json", "--details"],
+        "recordFields": ["title", "fonts"],
+        "subcommands": [{"name": "details"}],
+        "requiresFeature": "metadata",
+        "available": true,
+    });
+    let later_command = json!({
+        "name": "info",
+        "summary": "Replacement command description",
+        "category": "mutation",
+        "json": false,
+        "batch": true,
+        "flags": ["--replace"],
+        "recordFields": ["replacement"],
+        "subcommands": [],
+        "requiresFeature": "replacement",
+        "available": false,
+    });
+    let first_tool = json!({
+        "name": "info",
+        "description": "First tool description",
+        "cli": {"command": "info"},
+        "inputSchema": {
+            "properties": {"path": {}, "details": {}},
+            "required": ["path"],
+        },
+        "outputFields": ["title", "fonts"],
+        "annotations": {"readOnlyHint": true, "custom": {"source": "first"}},
+    });
+    let later_tool = json!({
+        "name": "info",
+        "description": "Replacement tool description",
+        "cli": {"command": "replace"},
+        "inputSchema": {"properties": {"replacement": {}}, "required": []},
+        "outputFields": ["replacement"],
+        "annotations": {"readOnlyHint": false},
+    });
+    let capabilities = json!({
+        "version": "catalog-test",
+        "commands": [
+            {"name": "zeta"}, first_command, {"name": "zeta", "summary": "Later"},
+            later_command, first_command,
+        ],
+    });
+    let tools = vec![
+        first_tool.clone(),
+        json!({"name": "alpha"}),
+        later_tool,
+        json!({"name": "alpha", "description": "Later"}),
+        first_tool.clone(),
+    ];
+    let original_capabilities = capabilities.clone();
+    let original_tools = tools.clone();
+
+    let body = ontology::ontology(&capabilities, &tools);
+    let expected = ontology::ontology(
+        &json!({"version": "catalog-test", "commands": [{"name": "zeta"}, first_command]}),
+        &[first_tool, json!({"name": "alpha"})],
+    );
+    assert_eq!(
+        body, expected,
+        "duplicates must not replace or merge metadata"
+    );
+    let retained = actions(&body);
+    let ids: Vec<_> = retained.iter().map(|node| &node["@id"]).collect();
+    assert_eq!(
+        ids,
+        vec![
+            &json!("rhwp:cmd/zeta"),
+            &json!("rhwp:cmd/info"),
+            &json!("rhwp:tool/info"),
+            &json!("rhwp:tool/alpha"),
+        ]
+    );
+    assert!(retained[0].get("rdfs:comment").is_none());
+    assert!(retained[3].get("rdfs:comment").is_none());
+    for (source, predicate) in [
+        ("summary", "rdfs:comment"),
+        ("category", "rhwp:category"),
+        ("json", "rhwp:json"),
+        ("batch", "rhwp:batch"),
+        ("flags", "rhwp:flags"),
+        ("recordFields", "rhwp:recordFields"),
+        ("subcommands", "rhwp:subcommands"),
+        ("requiresFeature", "rhwp:requiresFeature"),
+        ("available", "rhwp:available"),
+    ] {
+        assert_eq!(
+            retained[1][predicate], first_command[source],
+            "field {source}"
+        );
+    }
+    assert!(retained[1]["rhwp:untrustedFields"].is_array());
+    assert!(retained[1]["rhwp:provenanceNote"].is_string());
+    assert_eq!(retained[2]["rdfs:comment"], "First tool description");
+    assert_eq!(
+        retained[2]["rhwp:implementsCommand"]["@id"],
+        "rhwp:cmd/info"
+    );
+    assert_eq!(
+        retained[2]["rhwp:inputProperties"],
+        json!(["details", "path"])
+    );
+    assert_eq!(retained[2]["rhwp:requiredInputs"], json!(["path"]));
+    assert_eq!(retained[2]["rhwp:outputFields"], json!(["title", "fonts"]));
+    assert_eq!(
+        retained[2]["rhwp:annotations"],
+        json!({"readOnlyHint": true, "custom": {"source": "first"}})
+    );
+
+    let envelope = ontology::envelope(&capabilities, &tools);
+    assert_eq!(envelope["ontology"], body);
+    assert_eq!(envelope["actionCount"], 4);
+    assert_eq!(envelope["schemaVersion"], "1.0");
+    assert_eq!(capabilities, original_capabilities);
+    assert_eq!(tools, original_tools);
+}
