+use rhwp_contracts::schema_registry;
+use std::io::{self, ErrorKind, Write};
+
+#[test]
+fn writes_exact_compact_registry_for_borrowed_versions() {
+    for version in ["", "1.2.3", "1.0.0-\"quoted\"\\path\n\t\u{0}🦀"] {
+        let owned_version = version.to_owned();
+        let registry = schema_registry::registry_value_with_crate_version(&owned_version);
+        let expected = serde_json::to_vec(&registry).expect("registry must serialize");
+        let mut output = Vec::new();
+
+        schema_registry::write_registry(&mut output, &owned_version)
+            .expect("writing to a vector must succeed");
+
+        assert_eq!(output, expected, "output differs for version {version:?}");
+        assert_eq!(
+            serde_json::from_slice::<serde_json::Value>(&output)
+                .expect("output must be valid JSON"),
+            registry
+        );
+    }
+}
+
+struct ShortWriter {
+    bytes: Vec<u8>,
+    flush_calls: usize,
+}
+
+impl Write for ShortWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let written = bytes.len().min(3);
+        self.bytes.extend_from_slice(&bytes[..written]);
+        Ok(written)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flush_calls += 1;
+        Err(io::Error::other("unexpected flush"))
+    }
+}
+
+#[test]
+fn accepts_dyn_write_handles_short_writes_and_leaves_flushing_to_caller() {
+    let prefix = b"existing output:";
+    let mut writer = ShortWriter {
+        bytes: prefix.to_vec(),
+        flush_calls: 0,
+    };
+    let mut expected = prefix.to_vec();
+    for version in ["2.0.0", "2.1.0"] {
+        let sink: &mut dyn Write = &mut writer;
+        schema_registry::write_registry(sink, version).expect("short writes must be retried");
+        expected.extend(
+            serde_json::to_vec(&schema_registry::registry_value_with_crate_version(version))
+                .expect("registry must serialize"),
+        );
+    }
+
+    assert_eq!(
+        writer.bytes, expected,
+        "writes must append without a newline"
+    );
+    assert_eq!(writer.flush_calls, 0, "the caller controls flushing");
+}
+
+struct FailingWriter {
+    bytes: Vec<u8>,
+    remaining: usize,
+    kind: ErrorKind,
+}
+
+impl Write for FailingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        if self.remaining == 0 {
+            return Err(io::Error::new(self.kind, "injected writer failure"));
+        }
+        let written = bytes.len().min(self.remaining);
+        self.bytes.extend_from_slice(&bytes[..written]);
+        self.remaining -= written;
+        Ok(written)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+#[test]
+fn preserves_io_error_kind_before_and_after_partial_output() {
+    let version = "3.0.0";
+    let expected = serde_json::to_vec(&schema_registry::registry_value_with_crate_version(version))
+        .expect("registry must serialize");
+    for kind in [ErrorKind::BrokenPipe, ErrorKind::PermissionDenied] {
+        for limit in [0, 13] {
+            let mut writer = FailingWriter {
+                bytes: Vec::new(),
+                remaining: limit,
+                kind,
+            };
+
+            let error = schema_registry::write_registry(&mut writer, version)
+                .expect_err("the writer must fail");
+
+            assert!(error.is_io(), "writer failures must remain I/O errors");
+            assert_eq!(error.io_error_kind(), Some(kind));
+            assert_eq!(writer.bytes, expected[..limit]);
+        }
+    }
+}
+
+#[test]
+fn exhausted_sink_returns_write_zero() {
+    let mut storage = [0; 8];
+    let mut writer = storage.as_mut_slice();
+
+    let error = schema_registry::write_registry(&mut writer, "4.0.0")
+        .expect_err("the registry must exceed the fixed sink capacity");
+
+    assert!(error.is_io(), "an exhausted sink is an I/O failure");
+    assert_eq!(error.io_error_kind(), Some(ErrorKind::WriteZero));
+}
