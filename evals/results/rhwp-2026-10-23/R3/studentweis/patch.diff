+/// Writes the registry as compact JSON for the supplied crate version.
+///
+/// Uses [`registry_value_with_crate_version`] without adding a newline or flushing
+/// the writer. A failure may leave partial output in the writer.
+///
+/// # Errors
+///
+/// Returns serialization or I/O errors, preserving the underlying I/O error kind.
+pub fn write_registry<W: Write + ?Sized>(
+    writer: &mut W,
+    crate_version: &str,
+) -> Result<(), serde_json::Error> {
+    serde_json::to_writer(writer, &registry_value_with_crate_version(crate_version))
+}
