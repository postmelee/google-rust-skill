+/// Writes the registry as compact JSON without a trailing newline or flushing the writer.
+///
+/// Serialization and I/O errors are returned unchanged, preserving the I/O error kind.
+/// On failure, the writer may already contain part of the registry.
+pub fn write_registry<W: Write + ?Sized>(
+    writer: &mut W,
+    crate_version: &str,
+) -> Result<(), serde_json::Error> {
+    serde_json::to_writer(writer, &registry_value_with_crate_version(crate_version))
+}
