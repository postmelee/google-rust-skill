+/// Writes the registry as compact JSON without a trailing newline or flushing.
+///
+/// Returns serialization or writer errors, preserving the underlying I/O error
+/// kind. The writer may contain partial output if writing fails.
+pub fn write_registry<W: std::io::Write + ?Sized>(
+    writer: &mut W,
+    crate_version: &str,
+) -> Result<(), serde_json::Error> {
+    serde_json::to_writer(writer, &registry_value_with_crate_version(crate_version))
+}
