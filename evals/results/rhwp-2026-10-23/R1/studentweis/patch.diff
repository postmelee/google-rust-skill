+
+/// Updates an object's provenance annotations without cloning its payload.
+///
+/// Non-object values are unchanged. Objects receive `untrustedContent` and
+/// `untrustedFields`, replacing any existing annotations. Only declared fields
+/// that carry values are included, in declaration order; unknown commands
+/// receive `false` and an empty field list.
+pub fn mark_in_place(envelope: &mut Value, command: &str) {
     if !envelope.is_object() {
-        return envelope;
+        return;
     }
-    let fields = present_fields(&envelope, command);
+    let fields = present_fields(envelope, command);
     envelope["untrustedContent"] = json!(!fields.is_empty());
     envelope["untrustedFields"] = json!(fields);
-    envelope
 }
 
