 /// `jsonContract.schemaPolicy`("필드 추가 허용")가 허용하는 변경이라
 /// `schemaVersion` 을 올리지 않는다.
 pub fn marked(mut envelope: Value, command: &str) -> Value {
+    mark_in_place(&mut envelope, command);
+    envelope
+}
+
+/// Annotates an object without cloning or taking ownership of its payload.
+///
+/// Replaces `untrustedContent` and `untrustedFields` using the command's
+/// declared fields that carry values, in declaration order. Unknown commands
+/// receive `false` and an empty list. Non-object values are left unchanged.
+pub fn mark_in_place(envelope: &mut Value, command: &str) {
     if !envelope.is_object() {
-        return envelope;
+        return;
     }
-    let fields = present_fields(&envelope, command);
+    let fields = present_fields(envelope, command);
     envelope["untrustedContent"] = json!(!fields.is_empty());
     envelope["untrustedFields"] = json!(fields);
-    envelope
 }
 
