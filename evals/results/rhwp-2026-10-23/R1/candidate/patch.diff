 /// `jsonContract.schemaPolicy`("필드 추가 허용")가 허용하는 변경이라
 /// `schemaVersion` 을 올리지 않는다.
 pub fn marked(mut envelope: Value, command: &str) -> Value {
+    mark_in_place(&mut envelope, command);
+    envelope
+}
