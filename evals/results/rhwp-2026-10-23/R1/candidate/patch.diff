+/// Annotates an object with the document-derived fields present for `command`.
+///
+/// Updates `untrustedContent` and `untrustedFields` while preserving the payload
+/// without cloning it. Unknown commands receive `false` and an empty field list.
+/// Non-object values are left unchanged.
+pub fn mark_in_place(envelope: &mut Value, command: &str) {
     if !envelope.is_object() {
