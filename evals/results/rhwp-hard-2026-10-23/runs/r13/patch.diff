+/// A rejected edit together with the untouched input allocation.
+///
+/// This error owns its data and can outlive the scan and edit list.
+#[derive(Debug)]
+pub struct OwnedPatchError {
+    xml: Vec<u8>,
+    error: PatchError,
+}
+
+impl OwnedPatchError {
+    /// Returns the typed reason the edits were rejected.
+    pub fn error(&self) -> &PatchError {
+        &self.error
+    }
+
+    /// Recovers the original bytes, length, capacity, and allocation, plus the error.
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+
+impl std::fmt::Display for OwnedPatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.error.fmt(f)
+    }
+}
+
+impl std::error::Error for OwnedPatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
     }
 }
 
