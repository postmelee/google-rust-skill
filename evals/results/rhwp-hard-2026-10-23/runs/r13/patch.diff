+
+// Validate everything before the owned path changes any bytes or capacity.
+fn validate_splices(len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut retained = len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        retained -= p.span.len();
+        cursor = p.span.end;
+    }
+    for p in planned.iter() {
+        retained = retained
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(retained)
+}
+
+// First compact all shrinking replacements, leaving growing ones unchanged.
+// Then expand from the right. Neither pass needs more than max(old, final) bytes.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        let start = write;
+        if p.bytes.len() <= p.span.len() {
+            xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+            write += p.bytes.len();
+        } else {
+            xml.copy_within(p.span.clone(), write);
+            write += p.span.len();
+        }
+        read = p.span.end;
+        p.span = start..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let compact_len = write + tail;
+    xml.truncate(compact_len);
+    xml.resize(final_len, 0);
+
+    read = compact_len;
+    write = final_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.end;
+        write -= gap;
+        xml.copy_within(p.span.end..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    // The unedited prefix stays at offset zero.
+    xml
 }
 
