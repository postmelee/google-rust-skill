+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/><c:tx><c:v>Series</c:v></c:tx><c:spPr><a:solidFill/></c:spPr><c:marker><c:symbol val="circle"/></c:marker>"#
+        ));
+        for (outer, inner) in [("cat", "strLit"), ("val", "numLit")] {
+            xml.push_str(&format!(r#"<c:{outer}><c:{inner}><c:ptCount val="3"/>"#));
+            for (point, text) in ["123456789", "123", "123456"].iter().enumerate() {
+                xml.push_str(&format!(r#"<c:pt idx="{point}"><c:v>{text}</c:v></c:pt>"#));
+            }
+            xml.push_str(&format!("</c:{inner}></c:{outer}>"));
+        }
+        xml.push_str("</c:ser>");
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea><c:extLst><custom/></c:extLst></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|s| (*s).into()).collect()
+}
+
+fn compare(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) {
+    let expected = apply_chart_edits(xml, data, edits).expect("reference edit succeeds");
+    for capacity in [
+        xml.len(),
+        xml.len().max(expected.len()),
+        expected.len() + xml.len(),
+    ] {
+        let mut owned = Vec::with_capacity(capacity);
+        owned.extend_from_slice(xml);
+        let pointer = owned.as_ptr();
+        let original_capacity = owned.capacity();
+        let actual = apply_chart_edits_owned(owned, data, edits).expect("owned edit succeeds");
+        assert_eq!(actual, expected, "owned bytes differ for {edits:?}");
+        if expected.len() <= original_capacity {
+            assert_eq!(actual.as_ptr(), pointer, "allocation changed for {edits:?}");
+            assert_eq!(actual.capacity(), original_capacity);
+        }
+    }
+}
+
