+#[test]
+fn mixed_growth_and_shrinkage_at_tight_capacity() {
+    let xml = chart();
+    let data = scan_chart_values(&xml).expect("fixture scans");
+    for first in 0..=12 {
+        for second in 0..=12 {
+            for third in [0, 3, 6, 9] {
+                let edits = [
+                    value(0, 2, &"3".repeat(third)),
+                    value(0, 0, &"1".repeat(first)),
+                    value(0, 1, &"2".repeat(second)),
+                ];
+                compare(&xml, &data, &edits);
+            }
+        }
+    }
+}
+
+fn rejected(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> OwnedPatchError {
+    let mut owned = Vec::with_capacity(xml.len() + 123);
+    owned.extend_from_slice(xml);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let error = apply_chart_edits_owned(owned, data, edits).expect_err("edit must be rejected");
+    let expected = apply_chart_edits(xml, data, edits).expect_err("borrowed path also rejects");
+    assert_eq!(error.error(), &expected);
+    assert_eq!(
+        error
+            .source()
+            .expect("typed source")
+            .downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert_eq!(error.to_string(), expected.to_string());
+    assert!(!format!("{error:?}").is_empty());
+    let (original, reason) = error.into_parts();
+    assert_eq!(original, xml);
+    assert_eq!(original.as_ptr(), pointer);
+    assert_eq!(original.capacity(), capacity);
+    let retry_error =
+        apply_chart_edits_owned(original, data, edits).expect_err("same edit rejected again");
+    assert_eq!(retry_error.error(), &reason);
+    retry_error
+}
+
+#[test]
+fn validation_errors_preserve_input_and_outlive_borrows() {
+    let xml = chart();
+    let error = {
+        let data = scan_chart_values(&xml).expect("fixture scans");
+        for edits in [
+            vec![value(9, 0, "1")],
+            vec![value(0, 9, "1")],
+            vec![value(0, 0, "unsafe&")],
+            vec![value(0, 0, "1"), value(0, 0, "2")],
+            vec![ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 0,
+            }],
+            vec![ChartEdit::TruncateSeries { keep: 0 }],
+            vec![
+                value(0, 2, "1"),
+                ChartEdit::TruncatePoints {
+                    series: 0,
+                    target: EditTarget::Value,
+                    keep: 1,
+                },
+            ],
+            vec![
+                ChartEdit::RemoveSeries { at: 0 },
+                ChartEdit::SeriesName {
+                    series: 0,
+                    text: "Name".into(),
+                },
+            ],
+            vec![ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: strings(&["1"]),
+            }],
+        ] {
+            rejected(&xml, &data, &edits);
+        }
+        rejected(&xml, &data, &[value(0, 0, "&")])
+    };
+    let (original, reason) = error.into_parts();
+    assert!(matches!(reason, PatchError::UnsafeText { .. }));
+    let data = scan_chart_values(&original).expect("recovered bytes scan");
+    assert!(apply_chart_edits_owned(original, &data, &[value(0, 0, "5")]).is_ok());
+}
