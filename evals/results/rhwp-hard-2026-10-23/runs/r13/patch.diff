+
+/// Applies the same edits as [`apply_chart_edits`], reusing the input allocation.
+///
+/// `data` must describe the same `xml`. If the final bytes fit its original
+/// capacity, the allocation and capacity are preserved, even for mixed growth
+/// and shrinkage. Empty edits return the original vector unchanged.
+///
+/// # Errors
+///
+/// Validation uses the existing planner and finishes before any mutation.
+/// Every rejection returns the untouched original vector in [`OwnedPatchError`].
+/// Allocation failure follows the standard `Vec` allocation behavior.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let validated = plan_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match validated {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
