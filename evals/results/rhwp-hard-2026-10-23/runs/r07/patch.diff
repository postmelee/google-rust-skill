+/// Applies edits while reusing the input vector's allocation.
+///
+/// Produces the same bytes as [`apply_chart_edits`]. If the final output fits
+/// the original capacity, both allocation and capacity are preserved, including
+/// for mixed growth and shrinkage. Empty edits return the vector unchanged.
+///
+/// # Errors
+///
+/// Returns the planner's rejection reason together with the untouched original
+/// vector. Validation finishes before mutation; no full input or output copy is
+/// made. As with the borrowed API, `data` must describe the same `xml` bytes.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let plan = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match plan {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
