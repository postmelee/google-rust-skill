+    self, ChartEdit, EditTarget, OwnedPatchError, PatchError, ValueEdit,
+};
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/><c:tx><c:v>Series name {index}</c:v></c:tx><c:spPr><a:solidFill/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strLit><c:ptCount val="3"/><c:pt idx="0"><c:v>Alpha</c:v></c:pt><c:pt idx="1"><c:v>Beta</c:v></c:pt><c:pt idx="2"><c:v>Gamma</c:v></c:pt></c:strLit></c:cat><c:val><c:numRef><c:f>Sheet1!A1:A3</c:f><c:numCache><c:ptCount val="3"/><c:pt idx="0"><c:v>12345</c:v></c:pt><c:pt idx="1"><c:v>67890</c:v></c:pt><c:pt idx="2"><c:v>13579</c:v></c:pt></c:numCache></c:numRef></c:val><c:extLst><custom/></c:extLst></c:ser>"#,
+        ));
+    }
+    xml.push_str("</c:barChart><unknown>unchanged</unknown></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.to_owned(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|value| (*value).to_owned()).collect()
+}
+
+fn assert_matches(xml: &[u8], edits: &[ChartEdit], spare: usize) {
+    let data = data::scan_chart_values(xml).expect("valid chart fixture");
+    let expected = patch::apply_chart_edits(xml, &data, edits).expect("valid edit case");
+    let mut owned = Vec::with_capacity(xml.len() + spare);
+    owned.extend_from_slice(xml);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let output = patch::apply_chart_edits_owned(owned, &data, edits).expect("owned edits succeed");
+    assert_eq!(output, expected);
+    if output.len() <= capacity {
+        assert_eq!(output.as_ptr(), pointer, "allocation must be reused");
+        assert_eq!(output.capacity(), capacity, "capacity must be preserved");
+    }
+}
+
+fn assert_recovered(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    use std::error::Error;
+
+    let mut owned = Vec::with_capacity(xml.len() + 123);
+    owned.extend_from_slice(xml);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let failure = patch::apply_chart_edits_owned(owned, data, edits).expect_err("invalid edits");
+    let typed = failure.error().clone();
+    assert_eq!(failure.to_string(), typed.to_string());
+    assert_eq!(
+        failure
+            .source()
+            .and_then(|error| error.downcast_ref::<PatchError>()),
+        Some(&typed)
+    );
+    assert!(!format!("{failure:?}").is_empty());
+    let (original, error) = failure.into_parts();
+    assert_eq!(error, typed);
+    assert_eq!(original, xml);
+    assert_eq!(original.len(), xml.len());
+    assert_eq!(original.capacity(), capacity);
+    assert_eq!(original.as_ptr(), pointer);
+    error
+}
