+#[test]
+fn malformed_merged_deletions_and_clone_metadata_return_errors() {
+    let xml = chart();
+    let original = data::scan_chart_values(&xml).expect("fixture");
+    let mut malformed = original.clone();
+    malformed.series[0].values[1].element_span = Some(std::ops::Range { start: 9, end: 8 });
+    assert!(matches!(
+        assert_recovered(
+            &xml,
+            &malformed,
+            &[ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            }]
+        ),
+        PatchError::StructureSpanOutOfRange { .. }
+    ));
+    let mut malformed = original.clone();
+    malformed.series[2].element_span = malformed.series[1].element_span.clone();
+    assert!(matches!(
+        assert_recovered(&xml, &malformed, &[ChartEdit::TruncateSeries { keep: 1 }]),
+        PatchError::OverlappingStructureEdits { .. }
+    ));
+    let mut malformed = original;
+    malformed.series[2].order_span = malformed.series[2].idx_span.clone();
+    assert!(matches!(
+        assert_recovered(
+            &xml,
+            &malformed,
+            &[ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: strings(&["1", "2", "3"]),
+            }]
+        ),
+        PatchError::OverlappingStructureEdits { .. }
+    ));
+}
