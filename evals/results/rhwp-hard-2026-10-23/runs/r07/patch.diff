+// Complete validation before any owned input is mutated. All range errors are
+// checked before overlap errors, preserving the borrowed API's precedence.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > xml_len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut retained = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        retained -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    for p in planned {
+        retained = retained
+            .checked_add(p.bytes.len())
+            .filter(|&length| length <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(retained)
+}
+
+// First discard replaced spans by compacting the retained bytes forward. Then
+// move those bytes backward while inserting replacement fragments. At no point
+// does the vector need more space than max(original length, final length).
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let retained = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += retained;
+        read = p.span.end;
+        // After compaction this is the insertion position among retained bytes.
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let compacted_len = write + tail;
+    xml.resize(final_len, 0);
+
+    read = compacted_len;
+    write = final_len;
+    for p in planned.into_iter().rev() {
+        let retained = read - p.span.start;
+        write -= retained;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
