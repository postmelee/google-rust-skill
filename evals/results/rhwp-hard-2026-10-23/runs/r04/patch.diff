+
+fn assert_recovery(source: &[u8], data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let expected = apply_chart_edits(source, data, edits).unwrap_err();
+    let mut xml = Vec::with_capacity(source.len() + 123);
+    xml.extend_from_slice(source);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let error = apply_chart_edits_owned(xml, data, edits).unwrap_err();
+    assert_eq!(error.error(), &expected);
+    assert_eq!(error.to_string(), expected.to_string());
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    let (recovered, reason) = error.into_parts();
+    assert_eq!(recovered, source);
+    assert_eq!(recovered.as_ptr(), pointer);
+    assert_eq!(recovered.capacity(), capacity);
+    assert_eq!(reason, expected);
+    reason
+}
+
+#[test]
+fn validation_errors_preserve_input_and_typed_reason() {
+    let source = chart();
+    let data = scan_chart_values(&source).unwrap();
+    for edits in [
+        vec![value(0, 0, "valid"), value(0, 1, "bad&text")],
+        vec![value(0, 0, "1"), value(0, 0, "2")],
+        vec![value(99, 0, "1")],
+        vec![value(0, 99, "1")],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "<bad>".into(),
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Value,
+            keep: 0,
+        }],
+        vec![ChartEdit::TruncateSeries { keep: 0 }],
+        vec![ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec![],
+        }],
+        vec![
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+            value(0, 2, "1"),
+        ],
+        vec![ChartEdit::RemoveSeries { at: 0 }, value(0, 0, "1")],
+    ] {
+        assert_recovery(&source, &data, &edits);
+    }
+}
+
+#[test]
+fn malformed_public_ranges_are_rejected_without_mutation() {
+    let source = chart();
+    for span in [
+        source.len()..source.len() + 1,
+        std::ops::Range {
+            start: 100,
+            end: 10,
+        },
+        usize::MAX..usize::MAX,
+    ] {
+        let mut data = scan_chart_values(&source).unwrap();
+        data.series[0].values[0].span = Some(span.clone());
+        assert_recovery(&source, &data, &[value(0, 0, "1")]);
+        data = scan_chart_values(&source).unwrap();
+        data.series[2].element_span = span.clone();
+        assert_recovery(
+            &source,
+            &data,
+            &[ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: strings(&["1", "2", "3"]),
+            }],
+        );
+        data = scan_chart_values(&source).unwrap();
+        data.series[2].idx_span = Some(span);
+        assert_recovery(
+            &source,
+            &data,
+            &[ChartEdit::InsertSeries {
+                at: 0,
+                name: None,
+                labels: None,
+                values: strings(&["1", "2", "3"]),
+            }],
+        );
+    }
+    let mut data = scan_chart_values(&source).unwrap();
+    data.series[0].values[1].span = data.series[0].values[0].span.clone();
+    assert_recovery(&source, &data, &[value(0, 0, "1"), value(0, 1, "2")]);
+    assert_recovery(
+        &source,
+        &ChartData::default(),
+        &[ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec![],
+        }],
+    );
+}
+
+#[test]
+fn error_outlives_borrowed_inputs_and_empty_edits_keep_allocation() {
+    fn fail(xml: Vec<u8>) -> OwnedPatchError {
+        let data = scan_chart_values(&xml).unwrap();
+        let edits = vec![value(0, 0, "&")];
+        apply_chart_edits_owned(xml, &data, &edits).unwrap_err()
+    }
+    let xml = chart();
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let error: Box<dyn Error + Send + Sync> = Box::new(fail(xml));
+    assert!(error.source().unwrap().is::<PatchError>());
+    let (xml, _) = error.downcast::<OwnedPatchError>().unwrap().into_parts();
+    let xml = apply_chart_edits_owned(xml, &ChartData::default(), &[]).unwrap();
+    assert_eq!(xml.as_ptr(), pointer);
+    assert_eq!(xml.capacity(), capacity);
+    let empty = Vec::with_capacity(42);
+    let pointer = empty.as_ptr();
+    let capacity = empty.capacity();
+    let empty = apply_chart_edits_owned(empty, &ChartData::default(), &[]).unwrap();
+    assert!(empty.is_empty());
+    assert_eq!(empty.as_ptr(), pointer);
+    assert_eq!(empty.capacity(), capacity);
+}
