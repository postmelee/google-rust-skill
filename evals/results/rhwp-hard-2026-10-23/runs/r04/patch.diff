+/// Applies a validated plan without allocating a second XML buffer.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    // First compact only the retained original bytes, recording insertion
+    // positions in that compacted sequence. No replacement can overwrite unread
+    // input, even when growth and shrinkage alternate.
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let retained_len = write + tail;
+    xml.truncate(retained_len);
+    xml.resize(final_len, 0);
+
+    // Expand right to left. Reversing equal-position insertions preserves the
+    // planner's order. The vector never needs more than the final capacity.
+    read = retained_len;
+    write = final_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.start;
+        write -= gap;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
