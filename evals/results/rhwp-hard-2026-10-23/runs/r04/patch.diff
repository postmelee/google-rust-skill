+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{i}"/><c:order val="{i}"/><c:tx><c:v>Series name</c:v></c:tx><c:spPr><a:solidFill/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strLit><c:ptCount val="3"/><c:pt idx="0"><c:v>First label</c:v></c:pt><c:pt idx="1"><c:v>Second label</c:v></c:pt><c:pt idx="2"><c:v>Third label</c:v></c:pt></c:strLit></c:cat><c:val><c:numRef><c:f>Sheet1!$B$2:$B$4</c:f><c:numCache><c:ptCount val="3"/><c:pt idx="0"><c:v>1111111111</c:v></c:pt><c:pt idx="1"><c:v>2222222222</c:v></c:pt><c:pt idx="2"><c:v>3333333333</c:v></c:pt></c:numCache></c:numRef></c:val><c:extLst><custom/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|s| (*s).into()).collect()
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let source = chart();
+    let data = scan_chart_values(&source).unwrap();
+    let expected = apply_chart_edits(&source, &data, edits).unwrap();
+    let mut xml = Vec::with_capacity(source.len() + spare);
+    xml.extend_from_slice(&source);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let actual = apply_chart_edits_owned(xml, &data, edits).unwrap();
+    assert_eq!(actual, expected);
+    if expected.len() <= capacity {
+        assert_eq!(
+            actual.as_ptr(),
+            pointer,
+            "fitting output moved the allocation"
+        );
+        assert_eq!(actual.capacity(), capacity);
+    }
+}
+
+#[test]
+fn all_operations_match_the_borrowed_api() {
+    let cases = vec![
+        vec![],
+        vec![
+            value(0, 0, "123456789012345678901234567890"),
+            value(0, 1, ""),
+            value(0, 2, ""),
+        ],
+        vec![
+            value(0, 0, ""),
+            value(0, 1, ""),
+            value(0, 2, "123456789012345678901234567890"),
+        ],
+        vec![ChartEdit::Value(ValueEdit {
+            series: 0,
+            point: 1,
+            target: EditTarget::Label,
+            text: "New label".into(),
+        })],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "New name".into(),
+        }],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: strings(&["4", "5"]),
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Value,
+            keep: 1,
