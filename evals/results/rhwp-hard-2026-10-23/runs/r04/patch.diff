+/// Applies chart edits using the caller's XML allocation.
+///
+/// Output bytes and rejection rules match [`apply_chart_edits`]. `data` must
+/// describe the same XML. Validation completes before any bytes are changed;
+/// errors return the original bytes, length, capacity, and allocation through
+/// [`OwnedPatchError::into_parts`]. The error does not borrow `data` or `edits`.
+///
+/// The original allocation and capacity are preserved whenever the final output
+/// fits, including empty edits and mixtures of insertions and deletions. Otherwise
+/// the vector may grow. Only planned replacement fragments are separately owned.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let validated = plan_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match validated {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
