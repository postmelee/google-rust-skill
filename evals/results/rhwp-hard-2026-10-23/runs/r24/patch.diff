+/// Writes the edited XML directly to a borrowed writer, including a trait object.
+///
+/// `data` must have been scanned from the same `xml`. Unedited bytes are copied
+/// verbatim. Only replacement and structural fragments are allocated; the entire
+/// resulting XML is never buffered by this function.
+///
+/// # Errors
+///
+/// All edits and their spans are validated before the writer is touched. A
+/// validation failure returns [`WritePatchError::Patch`] without writing anything.
+/// Once writing begins, an I/O failure returns [`WritePatchError::Io`] with the
+/// original error and may leave a prefix of the result in the writer. This is not
+/// a rollback guarantee. Short writes and interruptions follow [`Write::write_all`]
+/// semantics. The caller retains ownership of the writer; it is never flushed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0usize;
+    for p in &planned {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
 }
 
