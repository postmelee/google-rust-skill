+#[test]
+fn retries_interrupted_and_short_writes_and_reports_write_zero() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let edits = [value(1, 0, "98765")];
+    let mut writer = ShortWriter {
+        bytes: Vec::new(),
+        interrupted: false,
+    };
+    patch::write_chart_edits(&xml, &data, &edits, &mut writer).unwrap();
+    assert_eq!(
+        writer.bytes,
+        patch::apply_chart_edits(&xml, &data, &edits).unwrap()
+    );
+    let mut empty_sink = &mut [][..];
+    let error = patch::write_chart_edits(&xml, &data, &edits, &mut empty_sink).unwrap_err();
+    assert!(
+        matches!(error, WritePatchError::Io(ref inner) if inner.kind() == io::ErrorKind::WriteZero)
+    );
+}
