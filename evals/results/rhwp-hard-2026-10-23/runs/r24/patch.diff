+fn untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let expected = patch::apply_chart_edits(xml, data, edits).unwrap_err();
+    let mut writer = RecordingWriter {
+        bytes: b"existing".to_vec(),
+        ..Default::default()
+    };
+    let error = patch::write_chart_edits(xml, data, edits, &mut writer).unwrap_err();
+    assert!(!error.to_string().is_empty());
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    let WritePatchError::Patch(actual) = error else {
+        panic!("expected validation error")
+    };
+    assert_eq!(actual, expected);
+    assert_eq!(writer.bytes, b"existing");
+    assert_eq!(writer.calls, 0);
+    assert_eq!(writer.flushes, 0);
+    actual
+}
