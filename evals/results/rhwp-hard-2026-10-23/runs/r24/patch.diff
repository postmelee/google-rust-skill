+#[derive(Debug)]
+struct CustomFailure(u32);
+
+impl std::fmt::Display for CustomFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "custom failure {}", self.0)
+    }
+}
+
+impl Error for CustomFailure {}
+
+struct FailingWriter {
+    bytes: Vec<u8>,
+    remaining: usize,
+    error: Option<io::Error>,
+    failed: bool,
+}
+
+impl Write for FailingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        assert!(!self.failed, "must stop after the first terminal I/O error");
+        if bytes.is_empty() {
+            return Ok(0);
+        }
+        if self.remaining == 0 {
+            self.failed = true;
+            return Err(self.error.take().unwrap());
+        }
+        let size = self.remaining.min(bytes.len()).min(7);
+        self.bytes.extend_from_slice(&bytes[..size]);
+        self.remaining -= size;
+        Ok(size)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        panic!("must not flush caller's writer")
+    }
+}
+
+#[test]
+fn io_failure_keeps_original_typed_payload_and_written_prefix() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let edits = [value(0, 0, "12345")];
+    let expected = patch::apply_chart_edits(&xml, &data, &edits).unwrap();
+    let start = data.series[0].values[0].span.as_ref().unwrap().start;
+    for limit in [0, start, start + 2, expected.len() - 1] {
+        let mut writer = FailingWriter {
+            bytes: Vec::new(),
+            remaining: limit,
+            error: Some(io::Error::other(CustomFailure(42))),
+            failed: false,
+        };
+        let error = patch::write_chart_edits(&xml, &data, &edits, &mut writer).unwrap_err();
+        let source = error.source().unwrap().downcast_ref::<io::Error>().unwrap();
+        assert_eq!(
+            source
+                .get_ref()
+                .unwrap()
+                .downcast_ref::<CustomFailure>()
+                .unwrap()
+                .0,
+            42
+        );
+        assert!(error.to_string().contains("custom failure 42"));
+        let WritePatchError::Io(inner) = error else {
+            panic!("expected I/O error")
+        };
+        assert_eq!(
+            inner
+                .into_inner()
+                .unwrap()
+                .downcast::<CustomFailure>()
+                .unwrap()
+                .0,
+            42
+        );
+        assert_eq!(writer.bytes, expected[..limit]);
+        assert!(writer.failed);
+    }
+}
