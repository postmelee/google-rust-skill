+fn chart() -> Vec<u8> {
+    let mut xml =
+        String::from("<?xml version=\"1.0\"?><c:chartSpace><c:chart><c:plotArea><c:lineChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{i}"/><c:order val="{i}"/><c:tx><c:v>Name{i}</c:v></c:tx><c:spPr><a:ln/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strRef><c:f>Sheet1!A1:A2</c:f><c:strCache><c:ptCount val="2"/><c:pt idx="0"><c:v>Alpha</c:v></c:pt><c:pt idx="1"><c:v>Beta</c:v></c:pt></c:strCache></c:strRef></c:cat><c:val><c:numRef><c:f>Sheet1!B1:B2</c:f><c:numCache><c:ptCount val="2"/><c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt></c:numCache></c:numRef></c:val><c:extLst><custom:data key="keep"/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str(
+        "</c:lineChart></c:plotArea><c:externalData r:id=\"rId42\"/></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(texts: &[&str]) -> Vec<String> {
+    texts.iter().map(|text| (*text).into()).collect()
+}
+
+#[derive(Default)]
+struct RecordingWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+}
+
+impl Write for RecordingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        self.bytes.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
