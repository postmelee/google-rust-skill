+// Validate before mutation, preserving the original range and overlap error order.
+// Compute the final size after subtracting every removal, so transient growth
+// cannot overflow or force an allocation when the final result fits.
+fn validate_splices(len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        validate_span(len, &p.span, p.addr)?;
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut final_len = len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        final_len -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    for p in planned {
+        final_len = final_len
+            .checked_add(p.bytes.len())
+            .filter(|&size| size <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(final_len)
+}
