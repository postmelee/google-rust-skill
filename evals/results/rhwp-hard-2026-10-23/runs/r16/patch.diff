+#[test]
+fn errors_outlive_data_and_edits_and_allow_retry() {
+    let xml = chart();
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let error: OwnedPatchError = {
+        let data = scan_chart_values(&xml).unwrap();
+        let edits = vec![value(0, 0, "<")];
+        apply_chart_edits_owned(xml, &data, &edits).unwrap_err()
+    };
+    let boxed: Box<dyn Error + Send + Sync + 'static> = Box::new(error);
+    let error = boxed.downcast::<OwnedPatchError>().unwrap();
+    let (xml, _) = error.into_parts();
+    assert_eq!(xml.as_ptr(), pointer);
+    assert_eq!(xml.capacity(), capacity);
+    let data = scan_chart_values(&xml).unwrap();
+    let output = apply_chart_edits_owned(xml, &data, &[value(0, 0, "9")]).unwrap();
+    assert_eq!(output.as_ptr(), pointer);
+    assert_eq!(
+        scan_chart_values(&output).unwrap().series[0].values[0].text,
+        "9"
+    );
+}
