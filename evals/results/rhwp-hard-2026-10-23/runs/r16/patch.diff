+/// Applies chart edits while reusing the allocation owned by `xml`.
+///
+/// Produces the same bytes and uses the same validation as [`apply_chart_edits`].
+/// `data` must describe the same XML bytes. If the final output fits the original
+/// capacity, the allocation and capacity are preserved, even for mixed growing
+/// and shrinking edits. Otherwise, the vector may grow. Empty edits return the
+/// input unchanged.
+///
+/// # Errors
+///
+/// Returns an [`OwnedPatchError`] containing the untouched original vector on
+/// validation failure. Planning, range checks, and overlap checks all complete
+/// before the vector is mutated. No full input or output copy is made; planned
+/// replacement and structural fragments are owned separately.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let prepared = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match prepared {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
