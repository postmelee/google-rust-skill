+        let capacity = input.capacity();
+        let len = input.len();
+        let output = apply_chart_edits_owned(input, &ChartData::default(), &[]).unwrap();
+        assert_eq!(output.as_ptr(), pointer);
+        assert_eq!(output.capacity(), capacity);
+        assert_eq!(output.len(), len);
+    }
+}
