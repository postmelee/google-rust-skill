+// All ranges and the final length have been checked. The first pass removes
+// replaced spans and records each fragment's insertion offset in the compacted
+// input. The second pass opens space from right to left, preserving equal-offset
+// insertion order. Only retained input bytes move, at most twice each.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    if planned.is_empty() {
+        return xml;
+    }
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail_len = xml.len() - read;
+    xml.copy_within(read.., write);
+    let compact_len = write + tail_len;
+    xml.truncate(compact_len);
+    xml.resize(final_len, 0);
+
+    read = compact_len;
+    write = final_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.start;
+        write -= gap;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
