+        PatchError::StructureSpanOutOfRange { series: 0 },
+    );
+    let mut data = scan_chart_values(&xml).unwrap();
+    data.series[0].values[1].element_span = Some(usize::MAX..usize::MAX);
+    recover(
+        &xml,
+        &data,
+        &[ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Value,
+            keep: 1,
+        }],
+        PatchError::StructureSpanOutOfRange { series: 0 },
+    );
+}
