+#[test]
+fn boundary_insertions_and_adjacent_deletions_reuse_the_buffer() {
+    let source = b"abcdefgh";
+    let mut data = scan_chart_values(&chart()).unwrap();
+    for (spans, replacements, expected) in [
+        ([0..0, 0..4, 8..8], ["HEAD", "", "END"], "HEADefghEND"),
+        ([0..2, 2..6, 6..8], ["", "", ""], ""),
+        ([0..0, 0..0, 0..0], ["A", "B", "C"], "ABCabcdefgh"),
+        ([0..2, 2..2, 2..4], ["x", "Y", "z"], "xYzefgh"),
+    ] {
+        for (point, span) in data.series[0].values.iter_mut().zip(spans) {
+            point.span = Some(span);
+        }
+        let edits: Vec<_> = replacements
+            .iter()
+            .enumerate()
+            .map(|(point, text)| value(0, point, text))
+            .collect();
+        let output = compare(source, &data, &edits, 16);
+        assert_eq!(output, expected.as_bytes());
+    }
+}
