+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:lineChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            "<c:ser><c:idx val=\"{i}\"/><c:order val=\"{i}\"/>\
+             <c:tx><c:v>Series {i}</c:v></c:tx>\
+             <c:spPr><a:ln><a:noFill/></a:ln></c:spPr>\
+             <c:marker><c:symbol val=\"diamond\"/></c:marker>"
+        ));
+        for (block, cache, texts) in [
+            ("cat", "strLit", ["First", "Second category", "Third"]),
+            ("val", "numLit", ["1", "12345678901234567890", "300"]),
+        ] {
+            xml.push_str(&format!("<c:{block}><c:{cache}><c:ptCount val=\"3\"/>"));
+            for (i, text) in texts.iter().enumerate() {
+                xml.push_str(&format!("<c:pt idx=\"{i}\"><c:v>{text}</c:v></c:pt>"));
+            }
+            xml.push_str(&format!("</c:{cache}></c:{block}>"));
+        }
+        xml.push_str("<c:extLst><custom keep=\"yes\"/></c:extLst></c:ser>");
+    }
+    xml.push_str("</c:lineChart></c:plotArea></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.to_owned(),
+    })
+}
+
+fn texts(values: &[&str]) -> Vec<String> {
+    values.iter().map(|text| (*text).to_owned()).collect()
+}
+
+fn compare(xml: &[u8], data: &ChartData, edits: &[ChartEdit], capacity: usize) -> Vec<u8> {
+    let expected = apply_chart_edits(xml, data, edits).expect("borrowed patch succeeds");
+    let mut input = Vec::with_capacity(capacity.max(xml.len()));
+    input.extend_from_slice(xml);
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let output = apply_chart_edits_owned(input, data, edits).expect("owned patch succeeds");
+    assert_eq!(output, expected, "owned output must match borrowed output");
+    if output.len() <= capacity {
+        assert_eq!(
+            output.as_ptr(),
+            pointer,
+            "fitting output retains allocation"
+        );
+        assert_eq!(
+            output.capacity(),
+            capacity,
+            "fitting output retains capacity"
+        );
+    }
+    output
+}
+
+fn recover(xml: &[u8], data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    let mut input = Vec::with_capacity(xml.len() + 127);
+    input.extend_from_slice(xml);
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let error = apply_chart_edits_owned(input, data, edits).expect_err("invalid edit is rejected");
+    assert_eq!(error.error(), &expected);
+    assert_eq!(error.to_string(), expected.to_string());
+    assert_eq!(
+        error
+            .source()
+            .and_then(|source| source.downcast_ref::<PatchError>()),
+        Some(&expected),
+        "source exposes the typed validation error"
+    );
+    assert!(!format!("{error:?}").is_empty());
+    let (input, error) = error.into_parts();
+    assert_eq!(error, expected);
+    assert_eq!(input, xml, "failure preserves every byte and length");
+    assert_eq!(input.as_ptr(), pointer, "failure preserves allocation");
+    assert_eq!(input.capacity(), capacity, "failure preserves capacity");
+}
+
+#[test]
+fn empty_edits_preserve_empty_and_nonempty_allocations() {
+    for input in [Vec::new(), Vec::with_capacity(100), chart()] {
