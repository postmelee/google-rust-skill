+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/><c:tx><c:v>Name</c:v></c:tx><c:spPr/><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strLit><c:ptCount val="3"/><c:pt idx="0"><c:v>Alpha</c:v></c:pt><c:pt idx="1"><c:v>Beta</c:v></c:pt><c:pt idx="2"><c:v>Gamma</c:v></c:pt></c:strLit></c:cat><c:val><c:numLit><c:ptCount val="3"/><c:pt idx="0"><c:v>1234567890</c:v></c:pt><c:pt idx="1"><c:v>1234567890</c:v></c:pt><c:pt idx="2"><c:v>1234567890</c:v></c:pt></c:numLit></c:val></c:ser>"#
+        ));
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea><c:extLst><unknown/></c:extLst></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|s| (*s).to_owned()).collect()
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let original = chart();
+    let mut xml = Vec::with_capacity(original.len() + spare);
+    xml.extend_from_slice(&original);
+    let data = scan_chart_values(&xml).unwrap();
+    let expected = apply_chart_edits(&xml, &data, edits).unwrap();
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let output = apply_chart_edits_owned(xml, &data, edits).unwrap();
+    assert_eq!(output, expected);
+    if expected.len() <= capacity {
+        assert_eq!(output.as_ptr(), pointer);
+        assert_eq!(output.capacity(), capacity);
+    }
+}
+
+#[test]
+fn mixed_replacements_reuse_tight_capacity_in_both_directions() {
+    for (first, last) in [("1234567890123456789", ""), ("", "1234567890123456789")] {
+        compare(&[value(0, 0, first), value(2, 2, last)], 0);
+    }
+    for first_len in 0..25 {
+        for last_len in 0..25 {
+            compare(
+                &[
+                    value(2, 2, &"7".repeat(last_len)),
+                    value(0, 0, &"8".repeat(first_len)),
+                    value(1, 1, "é한"),
+                ],
+                0,
+            );
+        }
+    }
+}
+
+#[test]
+fn all_structural_operations_match_borrowed_output() {
