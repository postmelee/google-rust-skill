+
+/// Apply edits while taking ownership of the input XML allocation.
+///
+/// Output bytes and validation rules match [`apply_chart_edits`]. If the final
+/// length fits the input capacity, both its allocation and capacity are preserved.
+/// Empty edits return the input unchanged. A validation error retains the original
+/// bytes, length, capacity, and allocation in [`OwnedPatchError`].
+///
+/// As with the borrowed API, `data` must describe the same `xml`. Allocation
+/// failures follow the standard `Vec` allocation behavior.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let validated = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let output_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, output_len))
+    });
+    match validated {
+        Ok((planned, output_len)) => Ok(splice_owned(xml, planned, output_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
