+
+/// Validate every span and overlap before either executor writes any bytes.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > xml_len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut output_len = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        output_len -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    for p in planned {
+        output_len = output_len
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(output_len)
+}
+
+/// Execute a validated plan with two linear passes and no full-size scratch buffer.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, output_len: usize) -> Vec<u8> {
+    if planned.is_empty() {
+        return xml;
+    }
+    // Reserve only the final size: temporary growth must not cost the allocation.
+    if output_len > xml.len() {
+        xml.reserve(output_len - xml.len());
+    }
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        // Remember each fragment's anchor in the compacted unchanged bytes.
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let mut read = write + tail;
+    xml.resize(output_len, 0);
+    let mut write = output_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.start;
+        write -= gap;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
