+#[test]
+fn empty_edits_preserve_allocation_even_without_scanner_data() {
+    for mut xml in [Vec::new(), Vec::with_capacity(4096), chart()] {
+        xml.extend_from_slice(b"opaque bytes");
+        let pointer = xml.as_ptr();
+        let capacity = xml.capacity();
+        let length = xml.len();
+        let output = apply_chart_edits_owned(xml, &ChartData::default(), &[]).unwrap();
+        assert_eq!(output.as_ptr(), pointer);
+        assert_eq!(output.capacity(), capacity);
+        assert_eq!(output.len(), length);
+    }
+}
+
+fn recover(data: &ChartData, edits: &[ChartEdit]) {
+    let original = chart();
+    let mut xml = Vec::with_capacity(original.len() + 1024);
+    xml.extend_from_slice(&original);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let expected = apply_chart_edits(&xml, data, edits).unwrap_err();
+    let failure = apply_chart_edits_owned(xml, data, edits).unwrap_err();
+    assert_eq!(failure.error(), &expected);
+    assert_eq!(failure.to_string(), expected.to_string());
+    assert_eq!(
+        failure.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    let (xml, error) = failure.into_parts();
+    assert_eq!(xml, original);
+    assert_eq!(xml.as_ptr(), pointer);
+    assert_eq!(xml.capacity(), capacity);
+    assert_eq!(error, expected);
+}
+
+#[test]
+fn validation_failures_recover_original_and_typed_cause() {
+    let data = scan_chart_values(&chart()).unwrap();
+    for edits in [
