+/// A rejected owned edit, retaining the original XML allocation and typed cause.
+///
+/// No references to the scanner data or edit list are retained.
+#[derive(Debug)]
+pub struct OwnedPatchError {
+    xml: Vec<u8>,
+    error: PatchError,
+}
+
+impl OwnedPatchError {
+    /// Inspect the validation failure without consuming the original bytes.
+    pub fn error(&self) -> &PatchError {
+        &self.error
+    }
+
+    /// Recover the untouched input and its validation failure.
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+
+impl std::fmt::Display for OwnedPatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.error.fmt(f)
+    }
+}
+
+impl std::error::Error for OwnedPatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
     }
 }
 
