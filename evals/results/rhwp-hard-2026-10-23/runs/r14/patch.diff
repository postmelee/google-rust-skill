+
+/// Apply chart edits while reusing the input allocation whenever the final output fits.
+///
+/// `data` must describe the same XML. Planning and validation finish before the
+/// vector is modified. Every validation error owns the untouched input, including
+/// its original length, capacity and allocation. Empty edits return it unchanged.
+/// Allocation failure follows the standard `Vec` allocation behavior.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    if edits.is_empty() {
+        return Ok(xml);
+    }
+    let validated = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match validated {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, &planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
