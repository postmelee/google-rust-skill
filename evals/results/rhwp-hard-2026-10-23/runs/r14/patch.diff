+
+/// Validate before any mutation, retaining the existing range/overlap precedence.
+fn validate_splices(len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        validate_span(len, &p.span, p.addr)?;
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut retained = len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        retained -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    for p in planned.iter() {
+        retained = retained
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(retained)
+}
+
+/// Compact retained bytes first, then expand backward into the final layout.
+/// The compacted input never exceeds either the original or final length, so
+/// intermediate growth cannot force an allocation when the final output fits.
+fn splice_owned(mut xml: Vec<u8>, planned: &[Splice], final_len: usize) -> Vec<u8> {
+    let original_len = xml.len();
+    let mut read = 0;
+    let mut write = 0;
+    for p in planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+    }
+    xml.copy_within(read..original_len, write);
+    let mut compact_end = write + original_len - read;
+    xml.truncate(compact_end);
+    xml.resize(final_len, 0);
+
+    let mut original_end = original_len;
+    let mut output_end = final_len;
+    for p in planned.iter().rev() {
+        let gap = original_end - p.span.end;
+        compact_end -= gap;
+        output_end -= gap;
+        xml.copy_within(compact_end..compact_end + gap, output_end);
+        output_end -= p.bytes.len();
+        xml[output_end..output_end + p.bytes.len()].copy_from_slice(&p.bytes);
+        original_end = p.span.start;
+    }
+    xml
 }
 
