+/// A rejected owned patch, retaining the original vector for recovery or retry.
+#[derive(Debug)]
+pub struct OwnedPatchError {
+    xml: Vec<u8>,
+    error: PatchError,
+}
+
+impl OwnedPatchError {
+    /// Return the underlying validation error.
+    pub fn error(&self) -> &PatchError {
+        &self.error
+    }
+
+    /// Recover the untouched input vector and its validation error.
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+
+impl std::fmt::Display for OwnedPatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.error.fmt(f)
+    }
+}
+
+impl std::error::Error for OwnedPatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
     }
 }
 
