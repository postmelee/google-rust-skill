+    /// Recovers the untouched input, including its allocation and capacity.
+    #[must_use]
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+
+impl std::fmt::Display for OwnedPatchError {
