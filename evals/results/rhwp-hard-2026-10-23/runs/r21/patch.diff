+use rhwp_ooxml_chart::data::{self, ChartData};
+use rhwp_ooxml_chart::patch::{
+    self, ChartEdit, EditTarget, OwnedPatchError, PatchError, ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            "<c:ser><c:idx val=\"{i}\"/><c:order val=\"{i}\"/><c:tx><c:v>Series {i}</c:v></c:tx>"
+        ));
+        xml.push_str("<c:spPr><a:ln/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>");
+        xml.push_str("<c:cat><c:strLit><c:ptCount val=\"3\"/>");
+        for j in 0..3 {
+            xml.push_str(&format!("<c:pt idx=\"{j}\"><c:v>Label {j}</c:v></c:pt>"));
+        }
+        xml.push_str("</c:strLit></c:cat><c:val><c:numRef><c:f>Sheet1!A1:A3</c:f><c:numCache><c:ptCount val=\"3\"/>");
+        for j in 0..3 {
+            xml.push_str(&format!("<c:pt idx=\"{j}\"><c:v>123456789</c:v></c:pt>"));
+        }
+        xml.push_str("</c:numCache></c:numRef></c:val><c:extLst><unknown/></c:extLst></c:ser>");
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn verify(edits: &[ChartEdit], extra_capacity: usize) {
+    let original = chart();
+    let data = data::scan_chart_values(&original).expect("fixture scans");
+    let expected =
+        patch::apply_chart_edits(&original, &data, edits).expect("reference edits apply");
+    let mut input = Vec::with_capacity(original.len() + extra_capacity);
+    input.extend_from_slice(&original);
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let output = patch::apply_chart_edits_owned(input, &data, edits).expect("owned edits apply");
+    assert_eq!(output, expected, "owned and borrowed bytes must match");
+    if expected.len() <= capacity {
+        assert_eq!(output.as_ptr(), pointer, "allocation must be reused");
+        assert_eq!(output.capacity(), capacity, "capacity must be preserved");
+    }
+    data::scan_chart_values(&output).expect("output remains a readable chart");
+}
+
+fn recover(input: Vec<u8>, data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    let bytes = input.clone();
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let error = patch::apply_chart_edits_owned(input, data, edits).expect_err("must reject");
+    assert_eq!(error.error(), &expected);
+    assert_eq!(error.to_string(), expected.to_string());
+    assert_eq!(
+        error.source().and_then(|e| e.downcast_ref::<PatchError>()),
+        Some(&expected),
+        "source retains its concrete error type"
+    );
+    let (input, error) = error.into_parts();
+    assert_eq!(error, expected);
+    assert_eq!(
+        input, bytes,
+        "rejection must not alter original bytes or length"
+    );
+    assert_eq!(
+        input.as_ptr(),
+        pointer,
+        "rejection must preserve allocation"
+    );
+    assert_eq!(
+        input.capacity(),
+        capacity,
+        "rejection must preserve capacity"
+    );
+}
+
+#[test]
+fn empty_edits_preserve_allocation_even_without_scanner_series() {
+    let mut input = chart();
+    input.reserve(500);
+    let mut data = data::scan_chart_values(&input).expect("fixture scans");
+    data.series.clear();
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let bytes = input.clone();
+    let output = patch::apply_chart_edits_owned(input, &data, &[]).expect("no edits");
+    assert_eq!(output, bytes);
+    assert_eq!(output.as_ptr(), pointer);
+    assert_eq!(output.capacity(), capacity);
+    let empty = patch::apply_chart_edits_owned(Vec::new(), &data, &[]).expect("empty input");
+    assert_eq!(empty.capacity(), 0);
+}
