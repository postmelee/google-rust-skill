+/// Applies chart edits while taking ownership of the XML allocation.
+///
+/// The bytes match [`apply_chart_edits`]. If the final length fits the original
+/// capacity, both the allocation and capacity are preserved. Empty edits return
+/// the original vector unchanged. Replacement and structural fragments are owned
+/// by the plan; the complete input and output are never copied to another buffer.
+///
+/// # Errors
+///
+/// `data` must describe the same `xml`. All planning and range/overlap validation
+/// finish before mutation. On rejection, the error owns the untouched original
+/// bytes, length, capacity, and allocation, independently of `data` and `edits`.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    if edits.is_empty() {
+        return Ok(xml);
+    }
+    let validated = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
