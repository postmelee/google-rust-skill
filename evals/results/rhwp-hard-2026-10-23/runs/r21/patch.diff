+#[test]
+fn zero_length_values_and_boundary_insertions_match_the_reference() {
+    let input = chart();
+    let mut data = data::scan_chart_values(&input).expect("fixture scans");
+    data.series[0].values[0].span = Some(0..0);
+    data.series[0].values[1].span = Some(input.len()..input.len());
+    let edits = vec![value(0, 0, "A"), value(0, 1, "Z")];
+    let expected = patch::apply_chart_edits(&input, &data, &edits).expect("valid boundaries");
+    let mut input = input;
+    input.reserve(2);
+    let pointer = input.as_ptr();
+    let capacity = input.capacity();
+    let output = patch::apply_chart_edits_owned(input, &data, &edits).expect("valid boundaries");
+    assert_eq!(output, expected);
+    assert_eq!(output.as_ptr(), pointer);
+    assert_eq!(output.capacity(), capacity);
+}
