+    let input = chart();
+    let mut data = data::scan_chart_values(&input).expect("fixture scans");
+    data.series[2].idx_span = Some(std::ops::Range { start: 9, end: 2 });
+    recover(
+        input,
+        &data,
+        &[ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec!["1".into(); 3],
+        }],
+        PatchError::StructureSpanOutOfRange { series: 3 },
+    );
+    let input = chart();
+    let mut data = data::scan_chart_values(&input).expect("fixture scans");
+    data.series[0]
+        .values_shape
+        .as_mut()
+        .expect("shape")
+        .insert_at = Some(usize::MAX);
+    recover(
+        input,
+        &data,
+        &[ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["1".into()],
+        }],
+        PatchError::StructureSpanOutOfRange { series: 0 },
+    );
+}
