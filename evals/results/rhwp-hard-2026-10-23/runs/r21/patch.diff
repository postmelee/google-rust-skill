+/// Applies an already validated plan without a second XML buffer.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    // First retain only unchanged bytes. Destinations never overtake sources.
+    // Record insertion positions in this compacted coordinate system.
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap_len = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap_len;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail_len = xml.len() - read;
+    xml.copy_within(read.., write);
+    let retained_len = write + tail_len;
+    xml.truncate(retained_len);
+
+    // Only the final length can require growth, regardless of edit ordering.
+    xml.resize(final_len, 0);
+    read = retained_len;
+    write = final_len;
+    for p in planned.into_iter().rev() {
+        let gap_len = read - p.span.start;
+        write -= gap_len;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
