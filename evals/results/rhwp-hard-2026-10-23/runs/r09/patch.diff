+/// Failure to validate or write chart edits.
+///
+/// Validation leaves the writer untouched. An I/O failure may leave a prefix of
+/// the result in the writer; output is not rolled back.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum WritePatchError {
+    /// An edit or planned span was rejected before writing began.
+    Patch(PatchError),
+    /// The original writer error, including any custom payload.
+    Io(io::Error),
+}
+
+impl std::fmt::Display for WritePatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Patch(error) => write!(f, "chart patch failed: {error}"),
+            Self::Io(error) => write!(f, "chart output failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for WritePatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Patch(error) => Some(error),
+            Self::Io(error) => Some(error),
         }
     }
 }
