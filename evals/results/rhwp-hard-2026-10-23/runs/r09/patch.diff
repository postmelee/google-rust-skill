+fn chart() -> Vec<u8> {
+    let mut xml =
+        String::from("<?xml version=\"1.0\"?><c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/><c:tx><c:v>Series{index}</c:v></c:tx><c:spPr><a:ln/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strRef><c:f>Sheet1!A1:A2</c:f><c:strCache><c:ptCount val="2"/><c:pt idx="0"><c:v>Alpha</c:v></c:pt><c:pt idx="1"><c:v>Beta</c:v></c:pt></c:strCache></c:strRef></c:cat><c:val><c:numLit><c:ptCount val="2"/><c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt></c:numLit></c:val><c:extLst><unknown preserve="yes"/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea></c:chart><c:externalData r:id=\"rId1\"/></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct ShortWriter {
+    bytes: Vec<u8>,
+    interrupted: bool,
+    calls: usize,
+}
+
+impl Write for ShortWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if !self.interrupted {
+            self.interrupted = true;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let count = bytes.len().min(3);
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        panic!("the caller owns flushing");
+    }
+}
+
+#[test]
+fn every_operation_matches_buffered_output_with_short_writes_and_dyn_writer() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let cases = vec![
+        vec![],
+        vec![value(0, 0, "10")],
+        vec![value(2, 1, "30000"), value(0, 0, "1")],
+        vec![
+            ChartEdit::Value(ValueEdit {
+                series: 0,
+                point: 1,
+                target: EditTarget::Label,
+                text: "Updated label".into(),
+            }),
+            ChartEdit::SeriesName {
+                series: 1,
+                text: "Renamed".into(),
+            },
+        ],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["30".into(), "40".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Label,
+            keep: 1,
+        }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: Some("Added".into()),
+                labels: Some(vec!["A".into(), "B".into()]),
+                values: vec!["5".into(), "6".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![ChartEdit::InsertSeries {
+            at: 1,
+            name: Some("Inserted".into()),
+            labels: None,
+            values: vec!["9".into(), "8".into()],
+        }],
+        vec![ChartEdit::RemoveSeries { at: 1 }],
+        vec![
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Value,
+                texts: vec!["30".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: Some(vec!["A".into(), "B".into(), "C".into()]),
+                values: vec!["1".into(), "2".into(), "3".into()],
+            },
+        ],
+    ];
+    for edits in cases {
+        let expected = patch::apply_chart_edits(&xml, &data, &edits).expect("valid edits");
+        let mut writer = ShortWriter::default();
+        let sink: &mut dyn Write = &mut writer;
