+#[test]
+fn write_zero_is_reported_without_flushing() {
+    struct Zero;
+    impl Write for Zero {
+        fn write(&mut self, _: &[u8]) -> io::Result<usize> {
+            Ok(0)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            panic!("unexpected flush")
+        }
+    }
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let error = patch::write_chart_edits(&xml, &data, &[], &mut Zero).expect_err("write zero");
+    assert!(
+        matches!(error, WritePatchError::Io(error) if error.kind() == io::ErrorKind::WriteZero)
+    );
+}
