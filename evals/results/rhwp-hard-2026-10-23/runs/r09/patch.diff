+/// Writes edited XML directly to a borrowed writer, including a trait object.
+///
+/// `data` must have been scanned from the same `xml`. All edits and planned
+/// spans are validated before the writer is touched. Unchanged bytes are
+/// borrowed from `xml`; only replacement and structural fragments are allocated.
+/// No complete output buffer is built, and the writer is neither flushed nor
+/// closed.
+///
+/// # Errors
+///
+/// Returns [`WritePatchError::Patch`] without writing anything if validation
+/// fails. Once writing begins, [`WritePatchError::Io`] preserves the original
+/// I/O error and may leave a prefix of the result; there is no rollback.
+/// Short writes and interruptions are handled with [`io::Write::write_all`].
+pub fn write_chart_edits<W: io::Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    for chunk in planned.chunks() {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
 }
 
