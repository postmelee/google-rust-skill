+#[derive(Debug)]
+struct Payload(Box<u8>);
+
+impl std::fmt::Display for Payload {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "custom failure")
+    }
+}
+
+impl Error for Payload {}
+
+struct FailingWriter {
+    bytes: Vec<u8>,
+    limit: usize,
+    error: Option<io::Error>,
+    failures: usize,
+}
+
+impl Write for FailingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let remaining = self.limit - self.bytes.len();
+        if remaining == 0 {
+            self.failures += 1;
+            return Err(self.error.take().expect("stop after the first I/O failure"));
+        }
+        let count = remaining.min(bytes.len());
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        panic!("the caller owns flushing");
+    }
+}
+
+#[test]
+fn io_failure_keeps_original_payload_and_written_prefix() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let edits = [value(0, 0, "123456789")];
+    let expected = patch::apply_chart_edits(&xml, &data, &edits).expect("valid edits");
+    let replacement = data.series[0].values[0].span.as_ref().expect("span").start;
+    for limit in [0, 7, replacement + 3, expected.len() - 1] {
+        let payload = Payload(Box::new(42));
+        let address = std::ptr::from_ref(payload.0.as_ref());
+        let mut writer = FailingWriter {
+            bytes: vec![],
+            limit,
+            error: Some(io::Error::other(payload)),
+            failures: 0,
+        };
+        let error =
+            patch::write_chart_edits(&xml, &data, &edits, &mut writer).expect_err("I/O failure");
+        assert!(error.to_string().contains("custom failure"));
+        assert!(format!("{error:?}").contains("Io"));
+        let cause = error
+            .source()
+            .expect("typed I/O cause")
+            .downcast_ref::<io::Error>()
+            .expect("original io::Error");
+        let payload = cause
+            .get_ref()
+            .expect("custom payload")
+            .downcast_ref::<Payload>()
+            .expect("original payload type");
+        assert_eq!(std::ptr::from_ref(payload.0.as_ref()), address);
+        assert_eq!(writer.bytes, expected[..limit]);
+        assert_eq!(writer.failures, 1);
+    }
+}
