+/// Owns replacement fragments and borrows unchanged input bytes. Construction
+/// checks every range and overlap before any output can be consumed.
+struct ValidatedSplices<'a> {
+    xml: &'a [u8],
+    planned: Vec<Splice>,
+}
+
+impl<'a> ValidatedSplices<'a> {
+    fn new(xml: &'a [u8], mut planned: Vec<Splice>) -> Result<Self, PatchError> {
+        for p in &planned {
+            if p.span.start > p.span.end || p.span.end > xml.len() {
+                return Err(p.addr.out_of_range());
+            }
+        }
+        // Keep insertion order at shared anchors, before replacements/deletions.
+        planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+        let mut cursor = 0;
+        for p in &planned {
+            if p.span.start < cursor {
+                return Err(p.addr.overlap());
+            }
+            cursor = p.span.end;
+        }
+        Ok(Self { xml, planned })
+    }
+
+    fn chunks(&self) -> impl Iterator<Item = &[u8]> {
+        let mut cursor = 0;
+        let tail = self.planned.last().map_or(0, |p| p.span.end);
+        self.planned
+            .iter()
+            .flat_map(move |p| {
+                let unchanged = &self.xml[cursor..p.span.start];
+                cursor = p.span.end;
+                [unchanged, p.bytes.as_slice()]
+            })
+            .chain(std::iter::once(&self.xml[tail..]))
+    }
+
+    fn into_bytes(self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(self.xml.len());
+        for chunk in self.chunks() {
+            out.extend_from_slice(chunk);
+        }
+        out
+    }
+}
+
+fn splice(xml: &[u8], planned: Vec<Splice>) -> Result<Vec<u8>, PatchError> {
+    Ok(ValidatedSplices::new(xml, planned)?.into_bytes())
 }
 
