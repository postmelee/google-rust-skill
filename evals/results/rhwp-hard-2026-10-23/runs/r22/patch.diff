+/// Apply chart edits directly to a borrowed writer, including a trait object.
+///
+/// `data` must have been scanned from the same `xml`. Unchanged bytes are copied
+/// verbatim. Only planned replacement and structural fragments are allocated;
+/// no buffer containing the complete output XML is created.
+///
+/// # Errors
+///
+/// All planning and span validation finishes before calling the writer. A
+/// [`WritePatchError::Patch`] therefore leaves it completely untouched. Once
+/// writing starts, a [`WritePatchError::Io`] can leave a prefix in the sink;
+/// there is no rollback guarantee. Short writes and interruptions are handled
+/// through [`io::Write::write_all`], including `WriteZero` errors. The writer is
+/// neither flushed nor closed.
+pub fn write_chart_edits<W: io::Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let chunks = splice_chunks(xml, &planned);
+    for chunk in chunks {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
 }
 
