+use rhwp_ooxml_chart::data;
+use rhwp_ooxml_chart::patch::{
+    self, ChartEdit, EditTarget, PatchError, ValueEdit, WritePatchError,
+};
+use std::error::Error;
+use std::io::{self, Write};
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/>
+<c:tx><c:v>Series {index}</c:v></c:tx><c:spPr><a:ln/></c:spPr>
+<c:marker><c:symbol val="circle"/></c:marker>
+<c:cat><c:strRef><c:f>Sheet1!$A$1:$A$2</c:f><c:strCache><c:ptCount val="2"/>
+<c:pt idx="0"><c:v>A</c:v></c:pt><c:pt idx="1"><c:v>B</c:v></c:pt>
+</c:strCache></c:strRef></c:cat>
+<c:val><c:numLit><c:ptCount val="2"/>
+<c:pt idx="0"><c:v>1</c:v></c:pt><c:pt idx="1"><c:v>22</c:v></c:pt>
+</c:numLit></c:val><c:extLst><unknown attr="keep"/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea><c:externalData r:id=\"keep\"/></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct ShortWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+}
+
+impl Write for ShortWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.calls % 3 == 1 {
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let count = bytes.len().min(7);
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
+
+#[test]
+fn all_operations_match_buffered_output_through_a_trait_object() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let cases = vec![
+        vec![],
+        vec![value(2, 1, "12345"), value(0, 1, "0")],
+        vec![ChartEdit::SeriesName {
+            series: 1,
+            text: "New name".into(),
+        }],
+        vec![ChartEdit::Value(ValueEdit {
+            series: 0,
+            point: 0,
+            target: EditTarget::Label,
+            text: "Unicode λ".into(),
+        })],
+        vec![ChartEdit::AppendPoints {
+            series: 2,
+            target: EditTarget::Value,
+            texts: vec!["3".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 1,
+            target: EditTarget::Label,
+            keep: 1,
+        }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: Some("New".into()),
+                labels: Some(vec!["C".into(), "D".into()]),
+                values: vec!["3".into(), "4".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into()],
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![
+            ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into()],
+            },
+            ChartEdit::InsertSeries {
+                at: 2,
+                name: Some("Next".into()),
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+        ],
+        vec![ChartEdit::RemoveSeries { at: 1 }],
+        vec![
+            value(0, 0, "99"),
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Value,
+                texts: vec!["3".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into(), "7".into()],
+            },
+        ],
+    ];
+    for edits in cases {
+        let expected = patch::apply_chart_edits(&xml, &data, &edits).expect("buffered edit");
+        let mut writer = ShortWriter::default();
+        let sink: &mut dyn Write = &mut writer;
+        patch::write_chart_edits(&xml, &data, &edits, sink).expect("streamed edit");
+        assert_eq!(writer.bytes, expected, "edits: {edits:?}");
+        assert_eq!(writer.flushes, 0);
+        assert!(String::from_utf8_lossy(&writer.bytes).contains("externalData r:id=\"keep\""));
+    }
+}
