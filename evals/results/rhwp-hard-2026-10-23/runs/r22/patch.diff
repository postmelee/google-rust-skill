+#[test]
+fn unchanged_and_replaced_bytes_are_preserved_exactly() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let span = data.series[1].values[1].span.clone().expect("value span");
+    let mut expected = xml[..span.start].to_vec();
+    expected.extend_from_slice(b"123456");
+    expected.extend_from_slice(&xml[span.end..]);
+    let mut output = Vec::new();
+    patch::write_chart_edits(&xml, &data, &[value(1, 1, "123456")], &mut output).expect("write");
+    assert_eq!(output, expected);
+    output.clear();
+    patch::write_chart_edits(&xml, &data, &[], &mut output).expect("identity");
+    assert_eq!(output, xml);
+}
+
+fn assert_untouched(xml: &[u8], data: &data::ChartData, edits: &[ChartEdit], expected: PatchError) {
+    let mut writer = ShortWriter {
+        bytes: b"existing".to_vec(),
+        ..Default::default()
+    };
+    let error = patch::write_chart_edits(xml, data, edits, &mut writer).expect_err("invalid edit");
+    assert_eq!(
+        error
+            .source()
+            .expect("typed source")
+            .downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert!(matches!(error, WritePatchError::Patch(ref error) if *error == expected));
+    assert!(!error.to_string().is_empty());
+    assert_eq!(writer.calls, 0);
+    assert_eq!(writer.flushes, 0);
+    assert_eq!(writer.bytes, b"existing");
+}
+
+#[test]
+fn late_invalid_and_overlapping_spans_never_touch_the_writer() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let edits = [value(0, 0, "9"), value(2, 1, "8")];
+    let mut bad = data.clone();
+    bad.series[2].values[1].span = Some(xml.len()..xml.len() + 1);
+    assert_untouched(
+        &xml,
+        &bad,
+        &edits,
+        PatchError::SpanOutOfRange {
+            series: 2,
+            point: 1,
+        },
+    );
+    bad.series[2].values[1].span = Some(std::ops::Range { start: 8, end: 7 });
+    assert_untouched(
+        &xml,
+        &bad,
+        &edits,
+        PatchError::SpanOutOfRange {
+            series: 2,
+            point: 1,
+        },
+    );
+    bad.series[2].values[1].span = data.series[0].values[0].span.clone();
+    assert_untouched(
+        &xml,
+        &bad,
+        &edits,
+        PatchError::OverlappingSpans {
+            series: 2,
+            point: 1,
+        },
+    );
+    let mut bad = data.clone();
+    bad.series[2].name_span = Some(xml.len()..xml.len() + 1);
+    assert_untouched(
+        &xml,
+        &bad,
+        &[
+            value(0, 0, "9"),
+            ChartEdit::SeriesName {
+                series: 2,
+                text: "x".into(),
+            },
+        ],
+        PatchError::StructureSpanOutOfRange { series: 2 },
+    );
+    assert_untouched(
+        &xml,
+        &data,
+        &[
+            value(0, 0, "9"),
+            ChartEdit::TruncatePoints {
+                series: 2,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+            value(2, 1, "8"),
