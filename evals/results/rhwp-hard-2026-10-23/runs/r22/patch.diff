+#[test]
+fn io_error_retains_payload_and_written_prefix() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid chart");
+    let edits = [value(0, 0, "987654321")];
+    let expected = patch::apply_chart_edits(&xml, &data, &edits).expect("edit");
+    let limit = data.series[0].values[0]
+        .span
+        .as_ref()
+        .expect("value span")
+        .start
+        + 3;
+    let mut writer = FailingWriter {
+        bytes: Vec::new(),
+        remaining: limit,
+        failure: Some(io::Error::other(Payload(42))),
+        failed: false,
+    };
+    let error = patch::write_chart_edits(&xml, &data, &edits, &mut writer).expect_err("sink fails");
+    let source = error
+        .source()
+        .expect("I/O source")
+        .downcast_ref::<io::Error>()
+        .expect("typed I/O error");
+    assert_eq!(
+        source
+            .get_ref()
+            .expect("payload")
+            .downcast_ref::<Payload>()
+            .expect("original payload")
+            .0,
+        42
+    );
+    assert!(matches!(error, WritePatchError::Io(_)));
+    assert_eq!(writer.bytes, expected[..limit]);
+}
