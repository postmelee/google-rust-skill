+
+/// Borrow unchanged input and replacement fragments from a validated plan.
+fn splice_chunks<'a>(xml: &'a [u8], planned: &'a [Splice]) -> impl Iterator<Item = &'a [u8]> {
+    let mut cursor = 0;
+    let tail = planned.last().map_or(0, |p| p.span.end);
+    planned
+        .iter()
+        .flat_map(move |p| {
+            let chunks = [&xml[cursor..p.span.start], p.bytes.as_slice()];
+            cursor = p.span.end;
+            chunks
+        })
+        .chain(std::iter::once(&xml[tail..]))
+}
+
+fn splice(xml: &[u8], mut planned: Vec<Splice>) -> Result<Vec<u8>, PatchError> {
+    validate_splices(xml, &mut planned)?;
+    let mut out = Vec::with_capacity(xml.len());
+    let chunks = splice_chunks(xml, &planned);
+    for chunk in chunks {
+        out.extend_from_slice(chunk);
+    }
     Ok(out)
 }
 
