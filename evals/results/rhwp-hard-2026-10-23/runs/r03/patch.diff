+fn check_recovery(xml: Vec<u8>, data: ChartData, edits: Vec<ChartEdit>) {
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let original = xml.clone();
+    let expected = apply_chart_edits(&xml, &data, &edits).unwrap_err();
+    let error: OwnedPatchError = apply_chart_edits_owned(xml, &data, &edits).unwrap_err();
+    drop(data);
+    drop(edits);
+    assert_eq!(error.error(), &expected);
+    assert_eq!(error.to_string(), expected.to_string());
+    assert_eq!(
