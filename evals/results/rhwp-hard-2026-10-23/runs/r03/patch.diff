+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for series in 0..3 {
+        xml.push_str(&format!(
+            "<c:ser><c:idx val=\"{series}\"/><c:order val=\"{series}\"/>\
+             <c:tx><c:v>Original series name</c:v></c:tx>\
+             <c:spPr><unknown/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>"
+        ));
+        for (tag, cache, text) in [
+            ("cat", "strLit", "Long category label"),
+            ("val", "numLit", "1234567890"),
+        ] {
+            xml.push_str(&format!("<c:{tag}><c:{cache}><c:ptCount val=\"3\"/>"));
+            for point in 0..3 {
+                xml.push_str(&format!("<c:pt idx=\"{point}\"><c:v>{text}</c:v></c:pt>"));
+            }
+            xml.push_str(&format!("</c:{cache}></c:{tag}>"));
+        }
+        xml.push_str("</c:ser>");
+    }
+    xml.push_str("</c:barChart></c:plotArea><unknown keep=\"yes\"/></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|s| (*s).into()).collect()
+}
+
+fn compare(xml: Vec<u8>, data: &ChartData, edits: &[ChartEdit]) -> Vec<u8> {
+    let expected = apply_chart_edits(&xml, data, edits).expect("borrowed patch must succeed");
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let output = apply_chart_edits_owned(xml, data, edits).expect("owned patch must succeed");
+    assert_eq!(output, expected);
+    if output.len() <= capacity {
+        assert_eq!(output.as_ptr(), pointer, "allocation must be reused");
+        assert_eq!(output.capacity(), capacity);
+    }
+    output
+}
