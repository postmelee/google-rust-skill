+// Remove replaced source spans first, then expand backwards into the final
+// layout. This never needs more capacity than max(original_len, final_len),
+// even when an early growth is balanced by a later deletion.
+fn splice_owned(xml: &mut Vec<u8>, planned: &[Splice], final_len: usize) {
+    let original_len = xml.len();
+    let mut read = 0;
+    let mut write = 0;
+    for p in planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+    }
+    xml.copy_within(read..original_len, write);
+    let mut retained_end = write + original_len - read;
+    xml.truncate(retained_end);
+    xml.resize(final_len, 0);
+
+    let mut source_end = original_len;
+    let mut output_end = final_len;
+    for p in planned.iter().rev() {
+        let gap = source_end - p.span.end;
+        retained_end -= gap;
+        output_end -= gap;
+        xml.copy_within(retained_end..retained_end + gap, output_end);
+        output_end -= p.bytes.len();
+        xml[output_end..output_end + p.bytes.len()].copy_from_slice(&p.bytes);
+        source_end = p.span.start;
+    }
+    // The remaining prefix already occupies its final position.
 }
 
