+    for operation in 0..5 {
+        let xml = chart();
+        let mut data = scan_chart_values(&xml).unwrap();
+        let edits = match operation {
+            0 => {
+                let span = data.series[0].values[1].element_span.as_mut().unwrap();
+                span.end = span.start - 1;
+                vec![ChartEdit::TruncatePoints {
+                    series: 0,
+                    target: EditTarget::Value,
+                    keep: 1,
+                }]
+            }
+            1 => {
+                data.series[1].element_span.end = data.series[1].element_span.start - 1;
+                vec![ChartEdit::TruncateSeries { keep: 1 }]
+            }
+            2 => {
+                data.series[0].element_span.end = data.series[0].element_span.start - 1;
+                vec![ChartEdit::InsertSeries {
+                    at: 0,
+                    name: None,
+                    labels: None,
+                    values: strings(&["1", "2", "3"]),
+                }]
+            }
+            3 => {
+                data.series[2].idx_span = data.series[2].order_span.clone();
+                vec![ChartEdit::AppendSeries {
+                    name: None,
+                    labels: None,
+                    values: strings(&["1", "2", "3"]),
+                }]
+            }
+            _ => {
+                data.series[0].values_shape.as_mut().unwrap().insert_at = Some(usize::MAX);
+                vec![ChartEdit::AppendPoints {
+                    series: 0,
+                    target: EditTarget::Value,
+                    texts: strings(&["1"]),
+                }]
+            }
+        };
+        check_recovery(xml, data, edits);
+    }
+}
