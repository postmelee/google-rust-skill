+/// All validation completes before mutation. On rejection, the error owns the
+/// untouched original vector and a typed [`PatchError`], independently of the
+/// lifetimes of `data` and `edits`.
+pub fn apply_chart_edits_owned(
+    mut xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let plan = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
