+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{index}"/><c:order val="{index}"/><c:tx><c:v>Series {index}</c:v></c:tx><c:spPr><a:ln/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strLit><c:ptCount val="2"/><c:pt idx="0"><c:v>Category A</c:v></c:pt><c:pt idx="1"><c:v>Category B</c:v></c:pt></c:strLit></c:cat><c:val><c:numRef><c:f>Sheet1!A1:A2</c:f><c:numCache><c:ptCount val="2"/><c:pt idx="0"><c:v>1234567890</c:v></c:pt><c:pt idx="1"><c:v>9876543210</c:v></c:pt></c:numCache></c:numRef></c:val></c:ser>"#,
+        ));
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea><c:extLst><unknown/></c:extLst></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.to_owned(),
+    })
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let original = chart();
+    let data = data::scan_chart_values(&original).expect("valid fixture");
+    let expected = patch::apply_chart_edits(&original, &data, edits).expect("valid edits");
+    let mut owned = Vec::with_capacity(original.len() + spare);
+    owned.extend_from_slice(&original);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let output = patch::apply_chart_edits_owned(owned, &data, edits).expect("valid owned edits");
+    assert_eq!(output, expected);
+    if expected.len() <= capacity {
+        assert_eq!(
+            output.as_ptr(),
+            pointer,
+            "fitting output must retain allocation"
+        );
+        assert_eq!(
+            output.capacity(),
+            capacity,
+            "fitting output must retain capacity"
+        );
+    }
+    data::scan_chart_values(&output).expect("edited output remains readable");
+}
