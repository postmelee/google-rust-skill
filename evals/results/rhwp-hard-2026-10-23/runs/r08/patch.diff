+fn recover(data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let original = chart();
+    let expected_error =
+        patch::apply_chart_edits(&original, data, edits).expect_err("rejected edits");
+    let mut xml = Vec::with_capacity(original.len() + 123);
+    xml.extend_from_slice(&original);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let error = patch::apply_chart_edits_owned(xml, data, edits).expect_err("owned rejection");
+    assert_eq!(error.error(), &expected_error);
+    assert_eq!(error.to_string(), expected_error.to_string());
+    assert_eq!(
+        error
+            .source()
+            .and_then(|source| source.downcast_ref::<PatchError>()),
+        Some(&expected_error)
+    );
+    let (xml, error) = error.into_parts();
+    assert_eq!(xml, original);
+    assert_eq!(xml.as_ptr(), pointer);
+    assert_eq!(xml.capacity(), capacity);
+    error
+}
