+// Complete validation before either emitter writes bytes. Sorting is stable for
+// insertions at the same position through the planner's sequence number.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > xml_len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut retained_len = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        retained_len -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    let mut final_len = retained_len;
+    for p in planned {
+        final_len = final_len
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(final_len)
+}
+
+// First remove all replaced ranges, compacting only unchanged input bytes.
+// Then insert the planned fragments from right to left. This never needs more
+// than max(input length, final length) bytes, even with mixed growth/shrinkage.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let retained_len = write + tail;
+    xml.truncate(retained_len);
+    xml.resize(final_len, 0);
+
+    read = retained_len;
+    write = final_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.start;
+        write -= gap;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
