+/// Applies chart edits while taking ownership of the XML allocation.
+///
+/// Output bytes and rejection reasons match [`apply_chart_edits`]. The original
+/// pointer and capacity are preserved whenever the final output fits the input
+/// capacity; otherwise the vector may grow. Empty edits return it unchanged.
+/// `data` must describe these same XML bytes.
+///
+/// # Errors
+///
+/// Planning or validation failures return an [`OwnedPatchError`] containing the
+/// untouched input bytes, length, capacity, and allocation. All validation takes
+/// place before mutation. Allocation failure follows the normal `Vec` behavior.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    if edits.is_empty() {
+        return Ok(xml);
+    }
+    let plan = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match plan {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
