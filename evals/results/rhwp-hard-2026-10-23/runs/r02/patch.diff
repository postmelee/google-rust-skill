+/// Write edited XML directly to a borrowed writer, including a `dyn Write`.
+///
+/// `data` must describe the same `xml`. Unedited bytes are preserved exactly.
+/// Planning may allocate replacement and structural fragments, but this function
+/// does not allocate a buffer containing the complete resulting XML.
+///
+/// # Errors
+///
+/// All edits, span bounds, and overlaps are validated before touching `writer`.
+/// Validation failures return [`WritePatchError::Patch`] without writing bytes.
+/// Once writing starts, an I/O failure returns [`WritePatchError::Io`] immediately
+/// and may leave a prefix in the writer; there is no rollback guarantee.
+/// Short writes and interruptions follow [`Write::write_all`] semantics. The
+/// caller retains ownership of the writer, which is neither flushed nor closed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    for chunk in splice_chunks(xml, &planned) {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
+}
+
+fn plan_chart_edits(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<Splice>, PatchError> {
