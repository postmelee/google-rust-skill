+        fn flush(&mut self) -> io::Result<()> {
+            panic!("must not flush")
+        }
+    }
+    let xml = fixture();
+    let data = scan_chart_values(&xml).expect("valid fixture");
+    write_chart_edits(&xml, &data, &[], &mut BorrowCheck(&xml)).expect("borrowed input");
+    let mut empty = RecordingWriter::default();
+    write_chart_edits(b"", &ChartData::default(), &[], &mut empty).expect("empty no-op");
+    assert_eq!(empty.writes, 0);
+}
