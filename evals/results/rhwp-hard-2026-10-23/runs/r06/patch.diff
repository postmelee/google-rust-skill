+#[test]
+fn unchanged_bytes_are_borrowed_from_the_input() {
+    struct BorrowCheckingWriter<'a> {
+        expected: &'a [u8],
+        calls: usize,
+    }
+    impl Write for BorrowCheckingWriter<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            assert_eq!(bytes.as_ptr(), self.expected.as_ptr());
+            assert_eq!(bytes, self.expected);
+            self.calls += 1;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            panic!("the API must not flush")
+        }
+    }
+    let xml = chart();
+    let scanned = data::scan_chart_values(&xml).expect("fixture");
+    let mut writer = BorrowCheckingWriter {
+        expected: &xml,
+        calls: 0,
+    };
+    patch::write_chart_edits(&xml, &scanned, &[], &mut writer).expect("borrowed output");
+    assert_eq!(writer.calls, 1);
+}
