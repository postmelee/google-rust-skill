+#[test]
+fn zero_write_returns_write_zero_without_flush() {
+    let xml = chart();
+    let scanned = data::scan_chart_values(&xml).expect("fixture");
+    let mut writer = RecordingWriter {
+        zero: true,
+        ..Default::default()
+    };
+    let error = patch::write_chart_edits(&xml, &scanned, &[], &mut writer).expect_err("zero write");
+    assert!(
+        matches!(error, WritePatchError::Io(ref error) if error.kind() == io::ErrorKind::WriteZero)
+    );
+    assert_eq!(writer.calls, 1);
+    assert_eq!(writer.flushes, 0);
+}
