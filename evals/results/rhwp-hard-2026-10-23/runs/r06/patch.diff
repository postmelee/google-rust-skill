+/// Writes edited XML to a borrowed sink without buffering the whole result.
+///
+/// `data` must have been scanned from the same `xml`. All edits, spans, and
+/// overlaps are validated before calling the writer. Validation errors leave
+/// it untouched. An I/O error can leave a prefix of the result; writing stops
+/// immediately and no rollback is attempted. The original I/O error is retained.
+///
+/// Short writes and interruptions follow [`io::Write::write_all`] semantics.
+/// The writer is neither flushed nor closed. Only planned replacement and
+/// structural fragments are allocated; unchanged XML is borrowed directly.
+pub fn write_chart_edits<W: io::Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0;
+    for p in &planned {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
 }
 
