+#[test]
+fn late_validation_errors_never_touch_writer() {
+    let xml = chart();
+    let original = data::scan_chart_values(&xml).expect("valid fixture");
+    let edits = [value(0, "9"), value(1, "8")];
+    let mut invalid = original.clone();
+    invalid.series[0].values[1].span = Some(xml.len()..xml.len() + 1);
+    let mut overlapping = original.clone();
+    overlapping.series[0].values[1].span = overlapping.series[0].values[0].span.clone();
+    let mut reversed = original.clone();
+    reversed.series[0].values[1].span = Some(std::ops::Range { start: 20, end: 10 });
+    for scanned in [&invalid, &overlapping, &reversed] {
+        let expected = patch::apply_chart_edits(&xml, scanned, &edits).expect_err("bad spans");
+        let mut writer = RecordingWriter {
+            bytes: b"existing".to_vec(),
+            ..Default::default()
+        };
+        let error =
+            patch::write_chart_edits(&xml, scanned, &edits, &mut writer).expect_err("bad spans");
+        assert_eq!(
+            error
+                .source()
+                .expect("typed cause")
+                .downcast_ref::<PatchError>(),
+            Some(&expected)
+        );
+        assert!(matches!(error, WritePatchError::Patch(_)));
+        assert_eq!(writer.calls, 0);
+        assert_eq!(writer.flushes, 0);
+        assert_eq!(writer.bytes, b"existing");
+    }
+    for edits in [
+        vec![value(0, "9"), value(1, "<&")],
+        vec![value(0, "9"), value(0, "8")],
+        vec![
+            value(1, "9"),
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+        ],
+        vec![
+            ChartEdit::SeriesName {
+                series: 0,
+                text: "New".into(),
+            },
+            ChartEdit::SeriesName {
+                series: 0,
+                text: "Again".into(),
+            },
+        ],
+    ] {
+        let mut writer = RecordingWriter::default();
+        assert!(matches!(
+            patch::write_chart_edits(&xml, &original, &edits, &mut writer),
+            Err(WritePatchError::Patch(_))
+        ));
+        assert_eq!(writer.calls, 0);
+        assert_eq!(writer.flushes, 0);
+    }
+}
