+#[test]
+fn io_error_keeps_prefix_and_original_typed_payload() {
+    let xml = chart();
+    let scanned = data::scan_chart_values(&xml).expect("fixture");
+    let edits = [value(0, "123456")];
+    let expected = patch::apply_chart_edits(&xml, &scanned, &edits).expect("patch");
+    let point_start = scanned.series[0].values[0]
+        .span
+        .as_ref()
+        .expect("span")
+        .start;
+    for limit in [0, 5, point_start + 2, expected.len() - 1] {
+        let mut writer = RecordingWriter {
+            fail_after: Some(limit),
+            ..Default::default()
+        };
+        let error =
+            patch::write_chart_edits(&xml, &scanned, &edits, &mut writer).expect_err("I/O fails");
+        assert_eq!(writer.bytes, expected[..limit]);
+        assert_eq!(writer.flushes, 0);
+        let source = error
+            .source()
+            .expect("source")
+            .downcast_ref::<io::Error>()
+            .expect("I/O cause");
+        assert_eq!(
+            source
+                .get_ref()
+                .expect("payload")
+                .downcast_ref::<Payload>()
+                .expect("original type")
+                .0,
+            "original payload"
+        );
+        assert!(error.to_string().contains("original payload"));
+        let WritePatchError::Io(original) = error else {
+            panic!("expected I/O error")
+        };
+        assert_eq!(
+            original
+                .into_inner()
+                .expect("payload")
+                .downcast::<Payload>()
+                .expect("original payload")
+                .0,
+            "original payload"
+        );
+    }
+}
