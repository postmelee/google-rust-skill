+use rhwp_ooxml_chart::data;
+use rhwp_ooxml_chart::patch;
+use rhwp_ooxml_chart::patch::{ChartEdit, EditTarget, PatchError, ValueEdit, WritePatchError};
+use std::error::Error;
+use std::io::{self, Write};
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..2 {
+        xml.push_str(&format!(
+            concat!(
+                "<c:ser><c:idx val=\"{}\"/><c:order val=\"{}\"/>",
+                "<c:tx><c:v>Name</c:v></c:tx>",
+                "<c:spPr><a:ln/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>",
+                "<c:cat><c:strLit><c:ptCount val=\"2\"/>",
+                "<c:pt idx=\"0\"><c:v>A</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>B</c:v></c:pt></c:strLit></c:cat>",
+                "<c:val><c:numRef><c:f>Sheet1!$B$2:$B$3</c:f><c:numCache>",
+                "<c:ptCount val=\"2\"/><c:pt idx=\"0\"><c:v>11</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>22</c:v></c:pt></c:numCache></c:numRef></c:val>",
+                "<c:extLst><custom keep=\"yes\"/></c:extLst></c:ser>"
+            ),
+            index, index
+        ));
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart><!-- preserve --></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series: 0,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct RecordingWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    short: bool,
+    interrupt: bool,
+    fail_after: Option<usize>,
+    zero: bool,
+}
+
+#[derive(Debug)]
+struct Payload(String);
+
+impl std::fmt::Display for Payload {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl Error for Payload {}
+
+impl Write for RecordingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.interrupt {
+            self.interrupt = false;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        if self.zero {
+            return Ok(0);
+        }
+        if self.fail_after == Some(self.bytes.len()) {
+            return Err(io::Error::other(Payload("original payload".into())));
+        }
+        let mut count = bytes.len();
+        if self.short {
+            count = count.min(3);
+        }
+        if let Some(limit) = self.fail_after {
+            count = count.min(limit - self.bytes.len());
+        }
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
+
+#[test]
+fn every_edit_kind_matches_existing_byte_output() {
+    let xml = chart();
+    let scanned = data::scan_chart_values(&xml).expect("valid fixture");
+    let cases = vec![
+        vec![],
+        vec![value(0, "11")],
+        vec![value(1, "3"), value(0, "12345")],
+        vec![ChartEdit::Value(ValueEdit {
+            series: 0,
+            point: 0,
+            target: EditTarget::Label,
+            text: "Label".into(),
+        })],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "New".into(),
+        }],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["33".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Label,
+            keep: 1,
+        }],
+        vec![ChartEdit::AppendSeries {
+            name: Some("Third".into()),
+            labels: Some(vec!["X".into(), "Y".into()]),
+            values: vec!["3".into(), "4".into()],
+        }],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![ChartEdit::InsertSeries {
+            at: 0,
+            name: None,
+            labels: None,
+            values: vec!["3".into(), "4".into()],
+        }],
+        vec![ChartEdit::RemoveSeries { at: 0 }],
+        vec![
+            value(0, "99"),
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["3".into(), "4".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into()],
+            },
+        ],
+    ];
+    for edits in cases {
+        let expected = patch::apply_chart_edits(&xml, &scanned, &edits).expect("valid edits");
+        let mut writer = RecordingWriter {
+            short: true,
+            interrupt: true,
+            ..Default::default()
+        };
+        let sink: &mut dyn Write = &mut writer;
+        patch::write_chart_edits(&xml, &scanned, &edits, sink).expect("stream result");
+        assert_eq!(writer.bytes, expected, "edits: {edits:?}");
+        assert_eq!(writer.flushes, 0);
+        if edits.is_empty() || edits == [value(0, "11")] {
+            assert_eq!(writer.bytes, xml);
+        }
+        data::scan_chart_values(&writer.bytes).expect("result remains readable");
+    }
+}
