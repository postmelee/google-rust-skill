+#[test]
+fn io_failure_retains_typed_error_payload_and_output_prefix() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid fixture");
+    let edits = [value(0, 0, EditTarget::Value, "123456789")];
+    let expected = patch::apply_chart_edits(&xml, &data, &edits).expect("valid plan");
+    let replacement_start = data.series[0].values[0]
+        .span
+        .as_ref()
+        .expect("value span")
+        .start;
+    for limit in [0, 1, replacement_start + 2, expected.len() - 1] {
+        let original_error = io::Error::other(Payload(42));
+        let original_payload = std::ptr::from_ref(
+            original_error
+                .get_ref()
+                .expect("custom payload")
+                .downcast_ref::<Payload>()
+                .expect("typed original payload"),
+        );
+        let mut writer = FailingWriter {
+            bytes: vec![],
+            remaining: limit,
+            calls: 0,
+            failure: Some(original_error),
+            zero: false,
+        };
+        let error =
+            patch::write_chart_edits(&xml, &data, &edits, &mut writer).expect_err("I/O fails");
+        assert_eq!(writer.bytes, expected[..limit]);
+        let source = error
+            .source()
+            .expect("original error source")
+            .downcast_ref::<io::Error>()
+            .expect("typed I/O source");
+        let retained = source
+            .get_ref()
+            .expect("custom payload")
+            .downcast_ref::<Payload>()
+            .expect("typed payload");
+        assert_eq!(
+            std::ptr::from_ref(retained),
+            original_payload,
+            "the payload must not be rebuilt"
+        );
+        assert_eq!(retained.0, 42);
+        assert!(error.to_string().contains("payload 42"));
+        assert!(matches!(error, WritePatchError::Io(_)));
+    }
+}
