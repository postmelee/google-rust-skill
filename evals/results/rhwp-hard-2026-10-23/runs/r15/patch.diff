+            value(1, 1, EditTarget::Label, "한글"),
+        ],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "Renamed".into(),
+        }],
+        vec![
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Value,
+                texts: vec!["30".into()],
+            },
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Label,
+                texts: vec!["C".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: Some("Fourth".into()),
+                labels: None,
+                values: vec!["1".into(), "2".into(), "3".into()],
+            },
+        ],
+        vec![
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Label,
+                keep: 1,
+            },
+        ],
+        vec![
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: Some(vec!["X".into(), "Y".into()]),
+                values: vec!["3".into(), "4".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: Some("Fifth".into()),
+                labels: None,
+                values: vec!["5".into(), "6".into()],
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![
+            ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: vec!["3".into(), "4".into()],
+            },
+            ChartEdit::InsertSeries {
+                at: 2,
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into()],
