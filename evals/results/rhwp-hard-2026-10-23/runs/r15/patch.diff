+#[test]
+fn unchanged_input_is_passed_directly_to_the_writer() {
+    struct BorrowChecker<'a>(&'a [u8]);
+    impl Write for BorrowChecker<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            assert_eq!(bytes.as_ptr(), self.0.as_ptr(), "input must not be copied");
+            assert_eq!(bytes, self.0);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            panic!("unexpected flush")
+        }
+    }
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).expect("valid fixture");
+    patch::write_chart_edits(&xml, &data, &[], &mut BorrowChecker(&xml)).expect("borrowed write");
+    let mut writer = ShortWriter::default();
+    patch::write_chart_edits(&[], &ChartData::default(), &[], &mut writer).expect("empty no-op");
+    assert_eq!(writer.calls, 0);
+}
