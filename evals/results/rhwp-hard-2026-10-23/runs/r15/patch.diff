+fn assert_untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let expected = patch::apply_chart_edits(xml, data, edits).expect_err("invalid buffered plan");
+    let mut writer = ShortWriter {
+        bytes: b"existing".to_vec(),
+        ..ShortWriter::default()
+    };
+    let error = patch::write_chart_edits(xml, data, edits, &mut writer).expect_err("invalid plan");
+    assert_eq!(writer.bytes, b"existing");
+    assert_eq!(writer.calls, 0, "validation must precede every write call");
+    assert_eq!(writer.flushes, 0);
+    assert_eq!(
+        error.source().and_then(|e| e.downcast_ref::<PatchError>()),
+        Some(&expected)
+    );
+    assert!(!error.to_string().is_empty());
+    match error {
+        WritePatchError::Patch(actual) => assert_eq!(actual, expected),
+        WritePatchError::Io(error) => panic!("expected validation, got {error}"),
+    }
+    expected
+}
