+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<?xml version=\"1.0\"?><c:chartSpace><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{i}"/><c:order val="{i}"/><c:tx><c:v>Series{i}</c:v></c:tx><c:spPr><a:ln/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strRef><c:f>Sheet1!A1:A2</c:f><c:strCache><c:ptCount val="2"/><c:pt idx="0"><c:v>A</c:v></c:pt><c:pt idx="1"><c:v>B</c:v></c:pt></c:strCache></c:strRef></c:cat><c:val><c:numRef><c:f>Sheet1!B1:B2</c:f><c:numCache><c:ptCount val="2"/><c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt></c:numCache></c:numRef></c:val><c:extLst><x:custom untouched="yes"/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str("</c:barChart><c:externalData r:id=\"rId1\"/></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, target: EditTarget, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct ShortWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+}
+
+impl Write for ShortWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.calls % 5 == 1 {
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let len = bytes.len().min(7);
+        self.bytes.extend_from_slice(&bytes[..len]);
+        Ok(len)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
+
