+/// Write chart edits directly to a borrowed writer, preserving untouched bytes.
+///
+/// `data` must have been scanned from the same `xml`. The entire edit plan is
+/// validated before the first write, so [`WritePatchError::Patch`] leaves the
+/// writer untouched. Once writing starts, [`WritePatchError::Io`] may leave a
+/// prefix in the writer; this function does not roll back partial output.
+///
+/// Unchanged XML is borrowed directly and only the planner's replacement and
+/// structural fragments are allocated. No complete output buffer is created.
+/// Short writes and interruptions follow [`Write::write_all`] semantics. The
+/// caller retains ownership of the writer, which is neither flushed nor closed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml.len(), &mut planned).map_err(WritePatchError::Patch)?;
+    for chunk in splice_chunks(xml, &planned) {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
+}
+
+fn plan_chart_edits(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<Splice>, PatchError> {
     let mut planner = Planner::new(xml, data, edits);
     for edit in edits {
         planner.add(edit)?;
     }
     planner.finish()?;
-    splice(xml, planner.splices)
+    Ok(planner.splices)
 }
 
