+#[test]
+fn late_invalid_and_overlapping_point_spans_do_not_touch_writer() {
+    let xml = chart();
+    let original = data::scan_chart_values(&xml).expect("valid fixture");
+    let edits = [
+        value(0, 0, EditTarget::Value, "1"),
+        value(2, 1, EditTarget::Value, "2"),
+    ];
+    for span in [
+        xml.len()..xml.len() + 1,
+        std::ops::Range { start: 9, end: 3 },
