+/// Validate the entire plan before any caller-owned bytes or capacity change.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > xml_len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut retained = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        retained -= p.span.len();
+        cursor = p.span.end;
+    }
+    for p in planned.iter() {
+        retained = retained
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(retained)
+}
+
+/// Compact retained bytes to the left, then expand fragments from the right.
+/// The intermediate length never exceeds max(original length, final length),
+/// even when growing edits precede shrinking edits or share an insertion anchor.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let mut source_end = write + tail;
+    xml.truncate(source_end);
+    xml.resize(final_len, 0);
+    let mut destination_end = final_len;
+    for p in planned.iter().rev() {
+        let gap = source_end - p.span.start;
+        destination_end -= gap;
+        xml.copy_within(p.span.start..source_end, destination_end);
+        destination_end -= p.bytes.len();
+        xml[destination_end..destination_end + p.bytes.len()].copy_from_slice(&p.bytes);
+        source_end = p.span.start;
+    }
+    xml
 }
 
