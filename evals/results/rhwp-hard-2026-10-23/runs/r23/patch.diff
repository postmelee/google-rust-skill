+/// A rejected owned patch, retaining the untouched input allocation for retry.
+#[derive(Debug)]
+pub struct OwnedPatchError {
+    xml: Vec<u8>,
+    error: PatchError,
+}
+
+impl OwnedPatchError {
+    /// Returns the typed reason the patch was rejected.
+    pub fn error(&self) -> &PatchError {
+        &self.error
+    }
+
+    /// Recovers the original bytes and the rejection reason.
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+
+impl std::fmt::Display for OwnedPatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.error.fmt(f)
+    }
+}
+
+impl std::error::Error for OwnedPatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
