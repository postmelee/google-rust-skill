+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            concat!(
+                "<c:ser><c:idx val=\"{0}\"/><c:order val=\"{0}\"/>",
+                "<c:tx><c:v>Series name</c:v></c:tx>",
+                "<c:spPr><a:ln/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>",
+                "<c:cat><c:strLit><c:ptCount val=\"3\"/>",
+                "<c:pt idx=\"0\"><c:v>Alpha</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>Beta</c:v></c:pt>",
+                "<c:pt idx=\"2\"><c:v>Gamma</c:v></c:pt></c:strLit></c:cat>",
+                "<c:val><c:numLit><c:ptCount val=\"3\"/>",
+                "<c:pt idx=\"0\"><c:v>123456789</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>123456789</c:v></c:pt>",
+                "<c:pt idx=\"2\"><c:v>123456789</c:v></c:pt></c:numLit></c:val>",
+                "<c:extLst><custom>untouched</custom></c:extLst></c:ser>"
+            ),
+            index
+        ));
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(values: &[&str]) -> Vec<String> {
+    values.iter().map(|text| (*text).into()).collect()
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let source = chart();
+    let data = scan_chart_values(&source).unwrap();
+    let expected = apply_chart_edits(&source, &data, edits).unwrap();
+    let mut owned = Vec::with_capacity(source.len() + spare);
+    owned.extend_from_slice(&source);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let result = apply_chart_edits_owned(owned, &data, edits).unwrap();
+    assert_eq!(result, expected);
+    if expected.len() <= capacity {
+        assert_eq!(result.as_ptr(), pointer);
+        assert_eq!(result.capacity(), capacity);
+    }
+}
+
+#[test]
+fn mixed_replacements_reuse_capacity_without_transient_growth() {
+    for lengths in [[17, 1, 9], [1, 17, 9], [9, 1, 17], [17, 9, 1], [1, 1, 1]] {
+        let edits: Vec<_> = lengths
+            .into_iter()
+            .enumerate()
+            .map(|(point, len)| value(0, point, &"7".repeat(len)))
+            .collect();
+        compare(&edits, 0);
+        compare(&edits.into_iter().rev().collect::<Vec<_>>(), 0);
+    }
+    compare(&[value(0, 0, &"8".repeat(5000))], 0);
+    compare(&[value(0, 0, &"8".repeat(5000))], 6000);
+}
+
+#[test]
+fn all_edit_variants_match_borrowed_output() {
+    let cases = vec![
+        vec![],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "New name".into(),
