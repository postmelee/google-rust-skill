+}
+
+fn check_recovery(data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let source = chart();
+    let mut owned = Vec::with_capacity(source.len() + 999);
+    owned.extend_from_slice(&source);
+    let pointer = owned.as_ptr();
+    let capacity = owned.capacity();
+    let expected = apply_chart_edits(&source, data, edits).unwrap_err();
+    let error = apply_chart_edits_owned(owned, data, edits).unwrap_err();
+    assert_eq!(error.error(), &expected);
+    assert_eq!(error.to_string(), expected.to_string());
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    let (original, reason) = error.into_parts();
+    assert_eq!(original, source);
+    assert_eq!(original.as_ptr(), pointer);
+    assert_eq!(original.capacity(), capacity);
+    reason
+}
+
+#[test]
+fn rejection_recovers_bytes_and_allocation() {
+    let data = scan_chart_values(&chart()).unwrap();
+    let cases = vec![
+        vec![value(0, 0, "1"), value(0, 1, "bad&text")],
+        vec![value(99, 0, "1")],
+        vec![value(0, 99, "1")],
+        vec![value(0, 0, "1"), value(0, 0, "2")],
+        vec![
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+            value(0, 2, "8"),
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 0 }],
+        vec![
+            ChartEdit::RemoveSeries { at: 1 },
+            ChartEdit::SeriesName {
+                series: 1,
+                text: "Gone".into(),
+            },
+        ],
+        vec![ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec![],
+        }],
+    ];
+    for edits in cases {
+        check_recovery(&data, &edits);
+    }
+}
+
+#[test]
+fn malformed_spans_and_template_data_are_recoverable() {
+    let source = chart();
+    let data = scan_chart_values(&source).unwrap();
+    for span in [
+        source.len()..source.len() + 1,
+        std::ops::Range { start: 10, end: 2 },
+    ] {
+        let mut malformed = data.clone();
+        malformed.series[0].values[0].span = Some(span.clone());
+        check_recovery(&malformed, &[value(0, 0, "8")]);
+        malformed = data.clone();
+        malformed.series[2].element_span = span.clone();
+        check_recovery(
+            &malformed,
+            &[ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: strings(&["1", "2", "3"]),
+            }],
+        );
+        malformed = data.clone();
+        malformed.series[2].idx_span = Some(span);
+        check_recovery(
+            &malformed,
+            &[ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: strings(&["1", "2", "3"]),
+            }],
+        );
+    }
+    let mut malformed = data.clone();
+    malformed.series[0].values[1].span = malformed.series[0].values[0].span.clone();
+    check_recovery(&malformed, &[value(0, 0, "1"), value(0, 1, "2")]);
+    let mut malformed = data.clone();
+    malformed.series[0].values_shape.as_mut().unwrap().insert_at = Some(source.len() + 1);
+    check_recovery(
+        &malformed,
+        &[ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: strings(&["1"]),
+        }],
+    );
+    let mut malformed = data;
+    malformed.series.clear();
+    check_recovery(
+        &malformed,
+        &[ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec![],
+        }],
+    );
+}
+
+#[test]
+fn errors_outlive_borrowed_arguments_and_empty_edits_preserve_input() {
+    fn make_error() -> OwnedPatchError {
+        let xml = chart();
+        let data = scan_chart_values(&xml).unwrap();
+        let edits = [value(0, 0, "&")];
+        apply_chart_edits_owned(xml, &data, &edits).unwrap_err()
+    }
+    let error: Box<dyn Error + Send + Sync> = Box::new(make_error());
+    assert!(error.source().unwrap().is::<PatchError>());
+    let data = scan_chart_values(&chart()).unwrap();
+    for mut xml in [Vec::new(), Vec::with_capacity(1234), chart()] {
+        if !xml.is_empty() {
+            xml.reserve(100);
+        }
+        let pointer = xml.as_ptr();
+        let len = xml.len();
+        let capacity = xml.capacity();
+        let result = apply_chart_edits_owned(xml, &data, &[]).unwrap();
+        assert_eq!(result.as_ptr(), pointer);
+        assert_eq!(result.len(), len);
+        assert_eq!(result.capacity(), capacity);
+    }
+}
