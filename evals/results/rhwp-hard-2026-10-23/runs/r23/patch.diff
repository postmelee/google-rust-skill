+/// Applies the same edits as [`apply_chart_edits`], consuming the input buffer.
+///
+/// If the final bytes fit the original capacity, the allocation and capacity are
+/// preserved. Empty edits return the input unchanged. Planning and validation
+/// finish before mutation; every rejection owns the untouched original vector.
+/// `data` must describe the same XML bytes. No full input or output copy is made;
+/// only the planner's replacement and structural fragments are allocated.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let prepared = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match prepared {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
