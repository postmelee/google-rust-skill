+        let sink: &mut dyn Write = &mut writer;
+        patch::write_chart_edits(&xml, &data, &edits, sink).unwrap();
+        assert_eq!(writer.bytes, expected, "edits: {edits:?}");
+        assert_eq!(writer.flushes, 0);
