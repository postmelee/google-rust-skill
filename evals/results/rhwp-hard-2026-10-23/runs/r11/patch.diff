+#[test]
+fn no_edits_borrows_input_directly_and_writer_remains_usable() {
+    struct BorrowCheckingWriter<'a>(&'a [u8]);
+    impl Write for BorrowCheckingWriter<'_> {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            assert_eq!(bytes.as_ptr(), self.0.as_ptr());
+            assert_eq!(bytes, self.0);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            panic!("the caller owns flushing");
+        }
+    }
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    patch::write_chart_edits(&xml, &data, &[], &mut BorrowCheckingWriter(&xml)).unwrap();
+    let mut writer = Vec::new();
+    patch::write_chart_edits(&xml, &data, &[], &mut writer).unwrap();
+    writer.write_all(b"tail").unwrap();
+    assert_eq!(&writer[..xml.len()], xml);
+    assert_eq!(&writer[xml.len()..], b"tail");
+    let mut empty = RecordingWriter::default();
+    patch::write_chart_edits(&[], &ChartData::default(), &[], &mut empty).unwrap();
+    assert_eq!(empty.calls, 0);
+}
