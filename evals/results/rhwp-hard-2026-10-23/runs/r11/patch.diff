+/// Write edited XML directly to a borrowed sink, including a trait-object writer.
+///
+/// `data` must have been scanned from the same `xml`. Planning and validation
+/// finish before the first writer call: [`WritePatchError::Patch`] leaves the
+/// writer completely untouched. Unchanged bytes are borrowed from `xml`; only
+/// replacement and structural fragments are allocated, not the entire output.
+///
+/// # Errors
+///
+/// Invalid edits return [`WritePatchError::Patch`]. Once output starts, an I/O
+/// failure returns [`WritePatchError::Io`] with the original error and may leave
+/// a prefix in the sink. This is not a rollback guarantee. Writing stops at the
+/// first non-interrupted error. Short writes and interruptions are handled with
+/// [`Write::write_all`], including its `WriteZero` behavior. The caller retains
+/// ownership of the writer; this function neither flushes nor closes it.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0usize;
+    for p in &planned {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
 }
 
