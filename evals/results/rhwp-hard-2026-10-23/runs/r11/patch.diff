+use rhwp_ooxml_chart::data::{self, ChartData};
+use rhwp_ooxml_chart::patch::{
+    self, ChartEdit, EditTarget, PatchError, ValueEdit, WritePatchError,
+};
+use std::error::Error;
+use std::fmt;
+use std::io::{self, Write};
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{i}"/><c:order val="{i}"/>
+<c:tx><c:v>Series {i}</c:v></c:tx><c:spPr><a:ln/></c:spPr>
+<c:marker><c:symbol val="circle"/><c:size val="5"/></c:marker>
+<c:cat><c:strRef><c:f>Sheet1!$A$1:$A$2</c:f><c:strCache><c:ptCount val="2"/>
+<c:pt idx="0"><c:v>Alpha</c:v></c:pt><c:pt idx="1"><c:v>Beta</c:v></c:pt>
+</c:strCache></c:strRef></c:cat>
+<c:val><c:numRef><c:f>Sheet1!$B$1:$B$2</c:f><c:numCache><c:ptCount val="2"/>
+<c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt>
+</c:numCache></c:numRef></c:val><c:extLst><!-- preserved --><unknown attr='x'/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str(
+        "</c:barChart></c:plotArea><c:externalData r:id='rId1'/></c:chart></c:chartSpace>",
+    );
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, target: EditTarget, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target,
+        text: text.to_owned(),
+    })
+}
+
+#[derive(Default)]
+struct RecordingWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    short: bool,
+    interrupt: bool,
+    stop_at: Option<usize>,
+    zero: bool,
+    failed: bool,
+}
+
+#[derive(Debug)]
+struct Payload(String);
+
+impl fmt::Display for Payload {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl Error for Payload {}
+
+impl Write for RecordingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        assert!(
+            !self.failed,
+            "writing must stop after the first permanent error"
+        );
+        self.calls += 1;
+        if std::mem::take(&mut self.interrupt) {
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let remaining = self
+            .stop_at
+            .map_or(usize::MAX, |limit| limit - self.bytes.len());
+        if remaining == 0 {
+            self.failed = true;
+            if self.zero {
+                return Ok(0);
+            }
+            return Err(io::Error::new(
+                io::ErrorKind::BrokenPipe,
+                Payload("original payload".to_owned()),
+            ));
+        }
+        let count = bytes
+            .len()
+            .min(remaining)
+            .min(if self.short { 3 } else { usize::MAX });
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
