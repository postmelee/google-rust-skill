+#[test]
+fn every_edit_operation_matches_the_buffered_api() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let cases = vec![
+        vec![],
+        vec![
+            value(2, 1, EditTarget::Value, "123.456"),
+            value(0, 0, EditTarget::Value, ""),
+        ],
+        vec![value(0, 0, EditTarget::Label, "New label")],
+        vec![ChartEdit::SeriesName {
+            series: 1,
+            text: "Renamed".into(),
+        }],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["30".into(), "40".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Value,
+            keep: 1,
+        }],
+        vec![ChartEdit::AppendSeries {
+            name: Some("Added".into()),
+            labels: Some(vec!["X".into(), "Y".into()]),
+            values: vec!["7".into(), "8".into()],
+        }],
+        vec![ChartEdit::TruncateSeries { keep: 2 }],
+        vec![ChartEdit::InsertSeries {
+            at: 1,
+            name: Some("Inserted".into()),
+            labels: None,
+            values: vec!["7".into(), "8".into()],
+        }],
+        vec![ChartEdit::RemoveSeries { at: 1 }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["9".into(), "10".into()],
+            },
+        ],
+        vec![
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Value,
+                texts: vec!["30".into()],
+            },
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Label,
+                texts: vec!["Gamma".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into(), "9".into()],
+            },
+        ],
+        vec![
+            ChartEdit::RemoveSeries { at: 0 },
+            ChartEdit::RemoveSeries { at: 2 },
