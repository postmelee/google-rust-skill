+#[test]
+fn replacement_preserves_every_other_byte() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let span = data.series[1].values[0].span.clone().unwrap();
+    let mut expected = xml[..span.start].to_vec();
+    expected.extend_from_slice(b"99.75");
+    expected.extend_from_slice(&xml[span.end..]);
+    let mut out = Vec::new();
+    patch::write_chart_edits(
+        &xml,
+        &data,
+        &[value(1, 0, EditTarget::Value, "99.75")],
+        &mut out,
+    )
+    .unwrap();
+    assert_eq!(out, expected);
+}
+
+fn assert_untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    assert_eq!(
+        patch::apply_chart_edits(xml, data, edits).unwrap_err(),
+        expected
+    );
+    let mut writer = RecordingWriter {
+        bytes: b"existing bytes".to_vec(),
+        ..Default::default()
+    };
+    let error = patch::write_chart_edits(xml, data, edits, &mut writer).unwrap_err();
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert!(error.to_string().contains(&expected.to_string()));
+    match error {
+        WritePatchError::Patch(actual) => assert_eq!(actual, expected),
+        WritePatchError::Io(error) => panic!("unexpected I/O error: {error}"),
+    }
+    assert_eq!(writer.calls, 0);
+    assert_eq!(writer.flushes, 0);
+    assert_eq!(writer.bytes, b"existing bytes");
+}
