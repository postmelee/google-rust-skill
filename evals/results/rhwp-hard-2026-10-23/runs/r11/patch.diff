+#[test]
+fn late_invalid_ranges_and_overlaps_leave_writer_untouched() {
+    let xml = chart();
+    let original = data::scan_chart_values(&xml).unwrap();
+    let edits = [
+        value(0, 0, EditTarget::Value, "1"),
+        value(2, 1, EditTarget::Value, "2"),
+    ];
+    for span in [
+        xml.len()..xml.len() + 1,
+        std::ops::Range { start: 8, end: 4 },
+    ] {
+        let mut data = original.clone();
+        data.series[2].values[1].span = Some(span);
+        assert_untouched(
+            &xml,
+            &data,
+            &edits,
+            PatchError::SpanOutOfRange {
+                series: 2,
+                point: 1,
+            },
+        );
+    }
+    let mut data = original.clone();
+    data.series[2].values[1].span = data.series[0].values[0].span.clone();
+    assert_untouched(
+        &xml,
+        &data,
+        &edits,
+        PatchError::OverlappingSpans {
+            series: 2,
+            point: 1,
+        },
+    );
+
+    let mut data = original.clone();
+    data.series[2].name_span = Some(xml.len()..xml.len() + 1);
+    assert_untouched(
+        &xml,
+        &data,
+        &[
+            edits[0].clone(),
+            ChartEdit::SeriesName {
+                series: 2,
+                text: "Name".into(),
+            },
+        ],
+        PatchError::StructureSpanOutOfRange { series: 2 },
+    );
+    assert_untouched(
+        &xml,
+        &original,
+        &[
+            value(2, 1, EditTarget::Value, "1"),
+            ChartEdit::TruncatePoints {
+                series: 2,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+        ],
+        PatchError::OverlappingSpans {
+            series: 2,
+            point: 1,
+        },
