+        (0..0, 0..0),
+        (0..0, 0..1),
+        (0..1, 1..1),
+        (0..0, 6..6),
+        (0..3, 3..6),
+    ] {
+        let mut data = base.clone();
+        data.series[0].values[0].span = Some(first);
+        data.series[0].values[1].span = Some(second);
+        let mut xml = Vec::with_capacity(32);
+        xml.extend_from_slice(b"abcdef");
+        let pointer = xml.as_ptr();
+        let capacity = xml.capacity();
+        let edits = [value(0, 0, "First"), value(0, 1, "Second")];
+        let expected =
+            patch::apply_chart_edits(&xml, &data, &edits).expect("nonoverlapping coordinates");
+        let actual = patch::apply_chart_edits_owned(xml, &data, &edits).expect("owned coordinates");
+        assert_eq!(actual, expected);
+        assert_eq!(actual.as_ptr(), pointer);
+        assert_eq!(actual.capacity(), capacity);
+    }
+}
+
+#[test]
+fn aggregate_deletions_validate_their_component_ranges() {
+    let xml = chart();
+    let original = data::scan_chart_values(&xml).expect("fixture");
+    let mut data = original.clone();
+    data.series[1].element_span.end = usize::MAX;
+    check_recovery(xml.clone(), &data, &[ChartEdit::TruncateSeries { keep: 1 }]);
+    data = original.clone();
+    data.series[2].element_span = data.series[1].element_span.clone();
+    check_recovery(xml.clone(), &data, &[ChartEdit::TruncateSeries { keep: 1 }]);
+    data = original.clone();
+    data.series[0].values[1].element_span = Some(std::ops::Range { start: 5, end: 3 });
+    check_recovery(
+        xml.clone(),
+        &data,
+        &[ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Value,
+            keep: 1,
+        }],
+    );
+    data = original;
+    data.series[2].idx_span = Some(0..1);
+    check_recovery(
+        xml,
+        &data,
+        &[ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec!["1".into(), "2".into()],
+        }],
+    );
+}
