+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:lineChart>");
+    for index in 0..3 {
+        xml.push_str(&format!(
+            concat!(
+                "<c:ser><c:idx val=\"{0}\"/><c:order val=\"{0}\"/>",
+                "<c:tx><c:v>Series {0}</c:v></c:tx>",
+                "<c:spPr><a:ln/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>",
+                "<c:cat><c:strLit><c:ptCount val=\"2\"/>",
+                "<c:pt idx=\"0\"><c:v>January</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>February</c:v></c:pt></c:strLit></c:cat>",
+                "<c:val><c:numRef><c:f>Sheet1!B2:B3</c:f><c:numCache><c:ptCount val=\"2\"/>",
+                "<c:pt idx=\"0\"><c:v>1234567890</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>1234567890</c:v></c:pt>",
+                "</c:numCache></c:numRef></c:val><unknown keep=\"yes\"/></c:ser>"
+            ),
+            index
+        ));
+    }
+    xml.push_str("</c:lineChart></c:plotArea><c:extLst/></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let mut xml = chart().into_boxed_slice().into_vec();
+    let data = data::scan_chart_values(&xml).expect("valid fixture");
+    let expected = patch::apply_chart_edits(&xml, &data, edits).expect("supported edits");
+    xml.reserve_exact(spare);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let out = patch::apply_chart_edits_owned(xml, &data, edits).expect("owned edits");
+    assert_eq!(out, expected);
+    if out.len() <= capacity {
+        assert_eq!(
+            out.as_ptr(),
+            pointer,
+            "a fitting result must reuse the allocation"
+        );
+        assert_eq!(out.capacity(), capacity);
+    }
+}
