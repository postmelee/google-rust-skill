+// Validate before mutation, preserving the planner's range and overlap ordering.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        validate_span(xml_len, &p.span, p.addr)?;
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut final_len = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        final_len -= p.span.end - p.span.start;
+        cursor = p.span.end;
+    }
+    for p in planned.iter() {
+        final_len = final_len
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(final_len)
+}
+
+fn validate_span(xml_len: usize, span: &Range<usize>, addr: Addr) -> Result<(), PatchError> {
+    if span.start > span.end || span.end > xml_len {
+        return Err(addr.out_of_range());
+    }
+    Ok(())
