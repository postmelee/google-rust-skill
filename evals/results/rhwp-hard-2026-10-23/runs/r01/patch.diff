+// First compact only the untouched bytes. Then insert all planned fragments in
+// reverse order. Neither pass needs more than max(original_len, final_len)
+// bytes, even when an early growing replacement precedes a later deletion.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        read = p.span.end;
+        p.span = write..write;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    let compact_len = write + tail;
+    xml.truncate(compact_len);
+    xml.resize(final_len, 0);
+
+    read = compact_len;
+    write = final_len;
+    for p in planned.iter().rev() {
+        let gap = read - p.span.start;
+        write -= gap;
+        xml.copy_within(p.span.start..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
