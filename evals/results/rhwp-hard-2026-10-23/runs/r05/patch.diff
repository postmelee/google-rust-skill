+/// Validates every range and overlap before either writer allocates or writes.
+fn validate_splices(xml_len: usize, planned: &mut [Splice]) -> Result<usize, PatchError> {
+    for p in planned.iter() {
+        if p.span.start > p.span.end || p.span.end > xml_len {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    let mut final_len = xml_len;
+    for p in planned.iter() {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        final_len -= p.span.len();
+        cursor = p.span.end;
+    }
+    for p in planned {
+        final_len = final_len
+            .checked_add(p.bytes.len())
+            .filter(|&len| len <= isize::MAX as usize)
+            .ok_or_else(|| p.addr.out_of_range())?;
+    }
+    Ok(final_len)
+}
+
+/// Applies a validated plan using only the input allocation and planned fragments.
+fn splice_owned(mut xml: Vec<u8>, mut planned: Vec<Splice>, final_len: usize) -> Vec<u8> {
+    // First discard excess bytes from shrinking spans, shifting only to the left.
+    // All spans then have replacement lengths at least as large as their old lengths.
+    // This prevents transient growth beyond max(original length, final length).
+    let mut read = 0;
+    let mut write = 0;
+    for p in &mut planned {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        let retained = p.span.len().min(p.bytes.len());
+        xml.copy_within(p.span.start..p.span.start + retained, write);
+        read = p.span.end;
+        p.span = write..write + retained;
+        write += retained;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    xml.truncate(write + tail);
+
+    // Expand from the right so unread bytes remain intact. Reverse traversal also
+    // preserves the planner's ordering for multiple insertions at the same anchor.
+    read = xml.len();
+    write = final_len;
+    xml.resize(final_len, 0);
+    for p in planned.into_iter().rev() {
+        let gap = read - p.span.end;
+        write -= gap;
+        xml.copy_within(p.span.end..read, write);
+        write -= p.bytes.len();
+        xml[write..write + p.bytes.len()].copy_from_slice(&p.bytes);
+        read = p.span.start;
+    }
+    xml
 }
 
