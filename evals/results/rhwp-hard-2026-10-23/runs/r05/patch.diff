+#[test]
+fn growth_beyond_capacity_is_allowed() {
+    let mut xml = chart();
+    xml.shrink_to_fit();
+    let data = scan_chart_values(&xml).unwrap();
+    let edits = [value(0, 0, &"7".repeat(xml.capacity() + 100))];
+    let expected = apply_chart_edits(&xml, &data, &edits).unwrap();
