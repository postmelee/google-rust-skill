+#[test]
+fn error_can_outlive_all_borrowed_arguments() {
+    fn require_static_error<T: Error + Send + Sync + 'static>() {}
+    require_static_error::<OwnedPatchError>();
+    let error = {
+        let xml = chart();
+        let data = scan_chart_values(&xml).unwrap();
+        let edits = [value(0, 0, "&")];
+        apply_chart_edits_owned(xml, &data, &edits).unwrap_err()
+    };
+    let (xml, reason) = error.into_parts();
+    assert_eq!(
+        reason,
+        PatchError::UnsafeText {
+            series: 0,
+            point: 0
+        }
+    );
+    let data = scan_chart_values(&xml).unwrap();
+    let pointer = xml.as_ptr();
+    let retried = apply_chart_edits_owned(xml, &data, &[value(0, 0, "2")]).unwrap();
+    assert_eq!(retried.as_ptr(), pointer);
+}
