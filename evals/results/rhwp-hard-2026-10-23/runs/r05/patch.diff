+            target: EditTarget::Value,
+            keep: 1,
+        }],
+        Some(PatchError::StructureSpanOutOfRange { series: 0 }),
+    );
+    let mut data = scan_chart_values(&source).unwrap();
+    data.series[0].values_shape.as_mut().unwrap().insert_at = Some(usize::MAX);
+    rejected(
+        data,
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: strings(&["4"]),
+        }],
+        Some(PatchError::StructureSpanOutOfRange { series: 0 }),
+    );
+    rejected(
+        ChartData::default(),
+        vec![ChartEdit::AppendSeries {
+            name: None,
+            labels: None,
+            values: vec![],
+        }],
+        Some(PatchError::SeriesNotClonable { series: 0 }),
+    );
+}
