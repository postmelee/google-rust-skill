+fn rejected(data: ChartData, edits: Vec<ChartEdit>, expected: Option<PatchError>) {
+    let source = chart();
+    let mut xml = Vec::with_capacity(source.len() + 128);
+    xml.extend_from_slice(&source);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let borrowed = apply_chart_edits(&xml, &data, &edits).unwrap_err();
+    let error = apply_chart_edits_owned(xml, &data, &edits).unwrap_err();
+    drop(data);
+    drop(edits);
+    assert_eq!(error.error(), &borrowed);
+    if let Some(expected) = expected {
+        assert_eq!(error.error(), &expected);
+    }
+    assert_eq!(error.to_string(), borrowed.to_string());
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(error.error())
+    );
+    assert!(!format!("{error:?}").is_empty());
+    let (recovered, reason) = error.into_parts();
+    assert_eq!(reason, borrowed);
+    assert_eq!(recovered, source);
+    assert_eq!(recovered.as_ptr(), pointer);
+    assert_eq!(recovered.capacity(), capacity);
+}
