+use rhwp_ooxml_chart::data::{scan_chart_values, ChartData};
+use rhwp_ooxml_chart::patch::{
+    apply_chart_edits, apply_chart_edits_owned, ChartEdit, EditTarget, OwnedPatchError, PatchError,
+    ValueEdit,
+};
+use std::error::Error;
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            "<c:ser><c:idx val=\"{i}\"/><c:order val=\"{i}\"/>\
+             <c:tx><c:v>Series {i}</c:v></c:tx>\
+             <c:spPr><a:solidFill/></c:spPr><c:marker><c:symbol val=\"circle\"/></c:marker>"
+        ));
+        for (tag, cache, texts) in [
+            ("cat", "strCache", ["First", "Second category", "Third"]),
+            ("val", "numCache", ["1", "12345678901234567890", "3"]),
+        ] {
+            xml.push_str(&format!("<c:{tag}><c:{cache}><c:ptCount val=\"3\"/>"));
+            for (idx, text) in texts.iter().enumerate() {
+                xml.push_str(&format!("<c:pt idx=\"{idx}\"><c:v>{text}</c:v></c:pt>"));
+            }
+            xml.push_str(&format!("</c:{cache}></c:{tag}>"));
+        }
+        xml.push_str("<c:extLst><private value=\"keep\"/></c:extLst></c:ser>");
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+fn strings(texts: &[&str]) -> Vec<String> {
+    texts.iter().map(|s| (*s).into()).collect()
+}
+
+fn compare(edits: &[ChartEdit], spare: usize) {
+    let source = chart();
+    let data = scan_chart_values(&source).unwrap();
+    let expected = apply_chart_edits(&source, &data, edits).unwrap();
+    let mut xml = Vec::with_capacity(source.len().max(expected.len()) + spare);
+    xml.extend_from_slice(&source);
+    let pointer = xml.as_ptr();
+    let capacity = xml.capacity();
+    let actual = apply_chart_edits_owned(xml, &data, edits).unwrap();
+    assert_eq!(actual, expected, "owned and borrowed output must agree");
+    assert_eq!(
+        actual.as_ptr(),
+        pointer,
+        "final output fits original capacity"
+    );
+    assert_eq!(actual.capacity(), capacity, "capacity must be preserved");
+}
+
+#[test]
+fn all_edit_operations_preserve_bytes_and_available_allocation() {
+    let cases = vec![
