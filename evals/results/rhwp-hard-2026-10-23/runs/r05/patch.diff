+/// Applies chart edits while reusing the caller's XML allocation.
+///
+/// The output is byte-for-byte identical to [`apply_chart_edits`]. When its final
+/// length fits the input capacity, both allocation and capacity are preserved,
+/// even for mixed growing and shrinking edits. Empty edits return the input
+/// unchanged. No full input copy or separate full output buffer is created.
+///
+/// `data` must describe the same `xml`. Planning, range and overlap validation
+/// complete before any input byte is changed. Every validation error owns the
+/// untouched original vector, recoverable with [`OwnedPatchError::into_parts`].
+/// Errors do not borrow `data` or `edits`. Allocation failure follows `Vec`'s
+/// usual behavior; it is not a recoverable validation error.
+pub fn apply_chart_edits_owned(
+    xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    if edits.is_empty() {
+        return Ok(xml);
+    }
+    let plan = plan_chart_edits(&xml, data, edits).and_then(|mut planned| {
+        let final_len = validate_splices(xml.len(), &mut planned)?;
+        Ok((planned, final_len))
+    });
+    match plan {
+        Ok((planned, final_len)) => Ok(splice_owned(xml, planned, final_len)),
+        Err(error) => Err(OwnedPatchError { xml, error }),
+    }
 }
 
