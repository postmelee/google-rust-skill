+#[derive(Debug)]
+struct Payload(u32);
+
+impl std::fmt::Display for Payload {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "custom failure {}", self.0)
+    }
+}
+
+impl Error for Payload {}
+
+#[test]
+fn io_failures_stop_at_the_prefix_and_keep_the_original_typed_payload() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let edits = [value(0, 0, EditTarget::Value, "123456")];
+    let expected = patch::apply_chart_edits(&xml, &data, &edits).unwrap();
+    let replacement_start = data.series[0].values[0].span.as_ref().unwrap().start;
+    for limit in [0, 9, replacement_start + 2, expected.len() - 1] {
+        let failure = io::Error::new(io::ErrorKind::BrokenPipe, Payload(27));
+        let payload_address = failure
+            .get_ref()
+            .unwrap()
+            .downcast_ref::<Payload>()
+            .unwrap() as *const Payload;
+        let mut sink = Sink::new();
+        sink.fail_after = Some(limit);
+        sink.failure = Some(failure);
+        let error = patch::write_chart_edits(&xml, &data, &edits, &mut sink).unwrap_err();
+        let source = error.source().unwrap().downcast_ref::<io::Error>().unwrap();
+        assert_eq!(source.kind(), io::ErrorKind::BrokenPipe);
+        let payload = source.get_ref().unwrap().downcast_ref::<Payload>().unwrap();
+        assert_eq!(payload.0, 27);
+        assert!(
+            std::ptr::eq(payload, payload_address),
+            "the original error payload must be retained"
+        );
+        assert!(matches!(error, WritePatchError::Io(_)));
+        assert!(error.to_string().contains("custom failure 27"));
+        assert_eq!(sink.bytes, expected[..limit]);
+        assert_eq!(sink.flushes, 0);
+        // The borrow ends with the call; the caller can keep using its sink.
+        sink.fail_after = None;
+        sink.write_all(b"caller data").unwrap();
+        assert!(sink.bytes.ends_with(b"caller data"));
+    }
+}
