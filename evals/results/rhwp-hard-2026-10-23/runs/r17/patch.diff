+/// Write chart edits directly to a borrowed sink, including a `dyn Write` sink.
+///
+/// `data` must have been scanned from the same `xml`. Unedited bytes are preserved
+/// exactly. Only replacement and structural fragments are buffered; this function
+/// does not allocate a buffer containing the entire resulting XML.
+///
+/// # Errors
+///
+/// All planning, bounds, and overlap checks finish before the writer is touched.
+/// Validation failures return [`WritePatchError::Patch`] without writing anything.
+/// Once writing starts, an I/O failure returns [`WritePatchError::Io`] with the
+/// original error and may leave a prefix in the sink; there is no rollback.
+/// Short writes and interruptions follow [`Write::write_all`] semantics.
+/// This function neither flushes nor closes the caller's writer.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0;
+    for p in planned {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
 }
 
