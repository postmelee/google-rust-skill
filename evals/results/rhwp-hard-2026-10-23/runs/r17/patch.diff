+use rhwp_ooxml_chart::data::{self, ChartData};
+use rhwp_ooxml_chart::patch::{
+    self, ChartEdit, EditTarget, PatchError, ValueEdit, WritePatchError,
+};
+use std::error::Error;
+use std::io::{self, Write};
+
+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<c:chartSpace><c:chart><c:plotArea><c:barChart>");
+    for i in 0..2 {
+        xml.push_str(&format!(
+            concat!(
+                "<c:ser><c:idx val=\"{i}\"/><c:order val=\"{i}\"/>",
+                "<c:tx><c:v>Series {i}</c:v></c:tx>",
+                "<c:spPr><a:ln><a:noFill/></a:ln></c:spPr>",
+                "<c:marker><c:symbol val=\"square\"/></c:marker>",
+                "<c:cat><c:strRef><c:f>Sheet1!$A$1:$A$2</c:f><c:strCache>",
+                "<c:ptCount val=\"2\"/><c:pt idx=\"0\"><c:v>First</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>Second</c:v></c:pt></c:strCache></c:strRef></c:cat>",
+                "<c:val><c:numLit><c:ptCount val=\"2\"/>",
+                "<c:pt idx=\"0\"><c:v>10</c:v></c:pt>",
+                "<c:pt idx=\"1\"><c:v>20</c:v></c:pt></c:numLit></c:val>",
+                "<c:extLst><custom:keep answer=\"42\"/></c:extLst></c:ser>"
+            ),
+            i = i
+        ));
+    }
+    xml.push_str("</c:barChart></c:plotArea></c:chart><!-- unchanged --></c:chartSpace>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, target: EditTarget, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target,
+        text: text.into(),
+    })
+}
+
+struct Sink {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    max_chunk: usize,
+    interrupt: bool,
+    fail_after: Option<usize>,
+    failure: Option<io::Error>,
+}
+
+impl Sink {
+    fn new() -> Self {
+        Self {
+            bytes: Vec::new(),
+            calls: 0,
+            flushes: 0,
+            max_chunk: usize::MAX,
+            interrupt: false,
+            fail_after: None,
+            failure: None,
+        }
+    }
+}
+
+impl Write for Sink {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if std::mem::take(&mut self.interrupt) {
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let available = if let Some(limit) = self.fail_after {
+            if self.bytes.len() >= limit {
+                return Err(self
+                    .failure
+                    .take()
+                    .expect("no writes after the first failure"));
+            }
+            limit - self.bytes.len()
+        } else {
+            usize::MAX
+        };
+        let count = bytes.len().min(self.max_chunk).min(available);
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
+
+#[test]
+fn every_edit_kind_matches_buffered_output_with_short_writes_and_a_trait_object() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let cases = vec![
+        vec![],
+        vec![value(0, 0, EditTarget::Value, "10")],
+        vec![
+            value(1, 1, EditTarget::Value, "300.25"),
+            value(0, 0, EditTarget::Label, "New category"),
+            ChartEdit::SeriesName {
+                series: 0,
+                text: "New name".into(),
+            },
+        ],
+        vec![
+            ChartEdit::AppendPoints {
+                series: 1,
+                target: EditTarget::Value,
+                texts: vec!["30".into()],
+            },
+            ChartEdit::AppendPoints {
+                series: 1,
+                target: EditTarget::Label,
+                texts: vec!["Third".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: Some("Added".into()),
+                labels: None,
+                values: vec!["1".into(), "2".into(), "3".into()],
+            },
+        ],
+        vec![
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Value,
+                keep: 1,
+            },
+            ChartEdit::TruncatePoints {
+                series: 0,
+                target: EditTarget::Label,
+                keep: 1,
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: Some("First addition".into()),
+                labels: Some(vec!["A".into(), "B".into()]),
+                values: vec!["31".into(), "32".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: Some("Second addition".into()),
+                labels: None,
+                values: vec!["41".into(), "42".into()],
+            },
+        ],
+        vec![
+            ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: vec!["31".into(), "32".into()],
+            },
+            ChartEdit::InsertSeries {
+                at: 0,
+                name: Some("First".into()),
+                labels: None,
+                values: vec!["41".into(), "42".into()],
+            },
+        ],
+        vec![ChartEdit::RemoveSeries { at: 0 }],
+    ];
+    for (case, edits) in cases.iter().enumerate() {
+        let expected = patch::apply_chart_edits(&xml, &data, edits).unwrap();
+        let mut sink = Sink::new();
+        sink.max_chunk = 7;
+        sink.interrupt = true;
+        let writer: &mut dyn Write = &mut sink;
+        patch::write_chart_edits(&xml, &data, edits, writer).unwrap();
+        assert_eq!(sink.bytes, expected, "edit case {case}");
+        assert_eq!(sink.flushes, 0);
+        data::scan_chart_values(&sink.bytes).expect("the edited chart must remain readable");
+        if case <= 1 {
+            assert_eq!(
+                sink.bytes, xml,
+                "empty and identity edits preserve all bytes"
+            );
+        }
+    }
+}
+
+fn assert_untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    assert_eq!(
+        patch::apply_chart_edits(xml, data, edits),
+        Err(expected.clone())
+    );
+    let mut sink = Sink::new();
+    sink.bytes.extend_from_slice(b"existing bytes");
+    let error = patch::write_chart_edits(xml, data, edits, &mut sink).unwrap_err();
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert!(matches!(error, WritePatchError::Patch(ref cause) if cause == &expected));
+    assert!(!error.to_string().is_empty());
+    assert_eq!(sink.bytes, b"existing bytes");
+    assert_eq!(sink.calls, 0, "validation must not even call write");
+    assert_eq!(sink.flushes, 0);
+}
