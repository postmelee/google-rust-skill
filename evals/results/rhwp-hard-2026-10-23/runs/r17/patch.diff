+#[test]
+fn zero_writes_report_write_zero_without_flushing() {
+    let xml = chart();
+    let data = data::scan_chart_values(&xml).unwrap();
+    let mut sink = Sink::new();
+    sink.max_chunk = 0;
+    let error = patch::write_chart_edits(&xml, &data, &[], &mut sink).unwrap_err();
+    assert!(
+        matches!(error, WritePatchError::Io(ref cause) if cause.kind() == io::ErrorKind::WriteZero)
+    );
+    assert_eq!(sink.calls, 1);
+    assert!(sink.bytes.is_empty());
+    assert_eq!(sink.flushes, 0);
+}
