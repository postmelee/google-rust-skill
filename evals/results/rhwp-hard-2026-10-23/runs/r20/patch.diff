+#[test]
+fn io_error_preserves_payload_and_stops_at_prefix() {
+    let xml = fixture();
+    let data = scan_chart_values(&xml).unwrap();
+    let edits = [value(0, 0, "987654321")];
+    let expected = apply_chart_edits(&xml, &data, &edits).unwrap();
+    for limit in [
+        0,
+        10,
+        data.series[0].values[0].span.as_ref().unwrap().start + 2,
+        expected.len() - 3,
+    ] {
+        let payload = Box::new(Payload(42));
+        let address = (&*payload) as *const Payload;
+        let payload: Box<dyn Error + Send + Sync> = payload;
+        let mut writer = RecordingWriter {
+            limit: Some(limit),
+            failure: Some(io::Error::other(payload)),
+            ..Default::default()
+        };
+        let error = write_chart_edits(&xml, &data, &edits, &mut writer).unwrap_err();
+        assert!(error.to_string().contains("payload 42"));
+        let source = error.source().unwrap().downcast_ref::<io::Error>().unwrap();
+        let actual = source.get_ref().unwrap().downcast_ref::<Payload>().unwrap();
+        assert_eq!(actual as *const Payload, address);
+        assert!(matches!(error, WritePatchError::Io(_)));
+        assert_eq!(writer.output, expected[..limit]);
+        assert_eq!(writer.flushes, 0);
+    }
+}
