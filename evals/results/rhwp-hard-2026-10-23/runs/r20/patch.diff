+fn fixture() -> Vec<u8> {
+    let series = r#"<c:ser><c:idx val="0"/><c:order val="0"/><c:tx><c:v>Original</c:v></c:tx><c:spPr><a:ln/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strRef><c:f>Sheet1!A1:A2</c:f><c:strCache><c:ptCount val="2"/><c:pt idx="0"><c:v>First</c:v></c:pt><c:pt idx="1"><c:v>Second</c:v></c:pt></c:strCache></c:strRef></c:cat><c:val><c:numLit><c:ptCount val="2"/><c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt></c:numLit></c:val><c:extLst><unknown keep="yes"/></c:extLst></c:ser>"#;
+    format!(
+        "<?xml version=\"1.0\"?><c:chartSpace><!-- keep spacing -->\n<c:chart><c:plotArea><c:barChart>{series}{}</c:barChart></c:plotArea></c:chart><c:externalData r:id=\"rId1\"/></c:chartSpace>",
+        series.replace("val=\"0\"", "val=\"1\"")
+    ).into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct RecordingWriter {
+    output: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    interrupt: bool,
+    limit: Option<usize>,
+    failure: Option<io::Error>,
+}
+
+impl Write for RecordingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.interrupt {
+            self.interrupt = false;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        if self.limit == Some(self.output.len()) {
+            if let Some(error) = self.failure.take() {
+                return Err(error);
+            }
+            return Ok(0);
+        }
+        let available = self.limit.map_or(bytes.len(), |n| n - self.output.len());
+        let n = bytes.len().min(available).min(7);
+        self.output.extend_from_slice(&bytes[..n]);
+        Ok(n)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
