+#[test]
+fn late_validation_failures_never_touch_the_writer() {
+    let xml = fixture();
+    let original = scan_chart_values(&xml).unwrap();
+    let edits = [value(0, 0, "1"), value(1, 1, "2")];
+    for span in [
+        xml.len()..xml.len() + 1,
+        std::ops::Range { start: 10, end: 9 },
+    ] {
+        let mut data = original.clone();
+        data.series[1].values[1].span = Some(span);
+        rejects_without_calls(
+            &xml,
+            &data,
+            &edits,
+            PatchError::SpanOutOfRange {
+                series: 1,
+                point: 1,
+            },
+        );
+    }
+    let mut data = original.clone();
+    data.series[1].values[1].span = data.series[0].values[0].span.clone();
+    rejects_without_calls(
+        &xml,
+        &data,
+        &edits,
+        PatchError::OverlappingSpans {
+            series: 1,
+            point: 1,
+        },
+    );
+    rejects_without_calls(
+        &xml,
+        &original,
+        &[value(0, 0, "1"), value(1, 1, "&")],
+        PatchError::UnsafeText {
+            series: 1,
+            point: 1,
+        },
+    );
+    rejects_without_calls(
+        &xml,
+        &original,
+        &[value(0, 0, "1"), value(0, 0, "2")],
+        PatchError::DuplicateTarget {
+            series: 0,
+            point: 0,
+        },
+    );
+    rejects_without_calls(
+        &xml,
+        &original,
+        &[
+            value(0, 0, "1"),
+            ChartEdit::TruncateSeries { keep: 1 },
+            value(1, 1, "2"),
