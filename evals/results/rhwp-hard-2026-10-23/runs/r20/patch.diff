+#[test]
+fn all_operations_match_buffered_output_through_a_trait_object() {
+    let xml = fixture();
+    let data = scan_chart_values(&xml).unwrap();
+    let cases = vec![
+        vec![],
+        vec![value(1, 1, "9999"), value(0, 0, "1")],
+        vec![
+            ChartEdit::Value(ValueEdit {
+                series: 0,
+                point: 0,
+                target: EditTarget::Label,
+                text: "新しい".into(),
+            }),
+            ChartEdit::SeriesName {
+                series: 1,
+                text: "Renamed".into(),
+            },
+        ],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["30".into(), "40".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 0,
+            target: EditTarget::Label,
+            keep: 1,
+        }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: Some("New".into()),
+                labels: Some(vec!["A".into(), "B".into()]),
+                values: vec!["1".into(), "2".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["3".into(), "4".into()],
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![
+            ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: vec!["5".into(), "6".into()],
+            },
+            ChartEdit::InsertSeries {
+                at: 0,
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+        ],
+        vec![ChartEdit::RemoveSeries { at: 0 }],
+        vec![
+            ChartEdit::AppendPoints {
+                series: 1,
+                target: EditTarget::Label,
+                texts: vec!["Third".into()],
+            },
+            ChartEdit::AppendPoints {
+                series: 1,
+                target: EditTarget::Value,
+                texts: vec!["30".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into(), "9".into()],
+            },
+        ],
+    ];
+    for edits in cases {
+        let expected = apply_chart_edits(&xml, &data, &edits).unwrap();
+        let mut writer = RecordingWriter {
+            interrupt: true,
+            ..Default::default()
