+#[test]
+fn value_edit_preserves_every_other_byte() {
+    let xml = fixture();
+    let data = scan_chart_values(&xml).unwrap();
+    let span = data.series[0].values[0].span.clone().unwrap();
+    let mut actual = Vec::new();
+    write_chart_edits(&xml, &data, &[value(0, 0, "12345")], &mut actual).unwrap();
+    assert_eq!(&actual[..span.start], &xml[..span.start]);
+    assert_eq!(&actual[span.start..span.start + 5], b"12345");
+    assert_eq!(&actual[span.start + 5..], &xml[span.end..]);
+}
+
+fn rejects_without_calls(xml: &[u8], data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    let mut writer = RecordingWriter {
+        output: b"existing".to_vec(),
+        ..Default::default()
+    };
+    let error = write_chart_edits(xml, data, edits, &mut writer).unwrap_err();
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert!(matches!(error, WritePatchError::Patch(actual) if actual == expected));
+    assert_eq!(writer.output, b"existing");
+    assert_eq!(writer.calls, 0);
+    assert_eq!(writer.flushes, 0);
+    assert_eq!(apply_chart_edits(xml, data, edits), Err(expected));
+}
