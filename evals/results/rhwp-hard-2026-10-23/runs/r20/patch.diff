+/// Write edited XML directly to a borrowed writer, including a `dyn Write`.
+///
+/// `data` must have been scanned from the same `xml`. Planning and all span
+/// validation finish before the first writer call. A [`WritePatchError::Patch`]
+/// therefore leaves the writer completely untouched.
+///
+/// Once writing starts, an I/O error can leave a prefix of the edited XML;
+/// there is no rollback guarantee. The original error is returned unchanged in
+/// [`WritePatchError::Io`]. Short writes and interruptions follow [`Write::write_all`]
+/// behavior. This function neither flushes nor closes the caller's writer.
+///
+/// Unchanged bytes are borrowed from `xml`; only the planner's replacement and
+/// structural fragments are allocated, never a buffer for the entire output.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0;
+    for p in planned {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
 }
 
