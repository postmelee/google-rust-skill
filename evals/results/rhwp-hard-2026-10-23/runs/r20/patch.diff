+        let sink: &mut dyn Write = &mut writer;
+        write_chart_edits(&xml, &data, &edits, sink).unwrap();
+        assert_eq!(writer.output, expected, "edits: {edits:?}");
+        assert_eq!(writer.flushes, 0);
+        assert!(String::from_utf8_lossy(&writer.output).contains("<!-- keep spacing -->\n"));
