+/// A chart edit failed validation or the caller's writer failed.
+#[derive(Debug)]
+pub enum WritePatchError {
+    /// Validation failed before the writer was touched.
+    Patch(PatchError),
+    /// Writing failed; the writer may already contain a prefix of the output.
+    Io(io::Error),
+}
+
+impl std::fmt::Display for WritePatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Patch(error) => write!(f, "chart edit validation failed: {error}"),
+            Self::Io(error) => write!(f, "writing chart edits failed: {error}"),
+        }
+    }
+}
+
+impl std::error::Error for WritePatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Patch(error) => Some(error),
+            Self::Io(error) => Some(error),
         }
     }
 }
