+    );
+    let xml = xml.into_bytes();
+    let data = scan_chart_values(&xml).unwrap();
+    (xml, data)
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct RecordingWriter {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    interrupted: bool,
+}
+
+impl Write for RecordingWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.interrupted {
+            self.interrupted = false;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let count = bytes.len().min(7);
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
+
+#[test]
+fn all_operations_match_buffered_output_with_short_writes_and_trait_objects() {
+    let (xml, data) = fixture();
+    let cases = vec![
+        vec![],
+        vec![value(2, 1, "10000"), value(0, 0, "")],
+        vec![ChartEdit::Value(ValueEdit {
+            series: 1,
+            point: 0,
