+/// A fully validated plan borrowing the input and owning only replacement fragments.
+struct SplicePlan<'a> {
+    xml: &'a [u8],
+    splices: Vec<Splice>,
+}
+
+impl<'a> SplicePlan<'a> {
+    fn new(xml: &'a [u8], mut splices: Vec<Splice>) -> Result<Self, PatchError> {
+        for p in &splices {
+            if p.span.start > p.span.end || p.span.end > xml.len() {
+                return Err(p.addr.out_of_range());
+            }
+        }
+        // Insertions precede replacements at the same offset, in planning order.
+        splices.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+        let mut cursor = 0;
+        for p in &splices {
+            if p.span.start < cursor {
+                return Err(p.addr.overlap());
+            }
+            cursor = p.span.end;
+        }
+        Ok(Self { xml, splices })
+    }
+
+    fn chunks(&self) -> impl Iterator<Item = &[u8]> {
+        let mut cursor = 0;
+        let tail = self.splices.last().map_or(0, |p| p.span.end);
+        self.splices
+            .iter()
+            .flat_map(move |p| {
+                let unchanged = &self.xml[cursor..p.span.start];
+                cursor = p.span.end;
+                [unchanged, p.bytes.as_slice()]
+            })
+            .chain(std::iter::once(&self.xml[tail..]))
+    }
+
+    fn to_vec(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(self.xml.len());
+        for chunk in self.chunks() {
+            out.extend_from_slice(chunk);
+        }
+        out
+    }
+}
+
+fn splice(xml: &[u8], planned: Vec<Splice>) -> Result<Vec<u8>, PatchError> {
+    Ok(SplicePlan::new(xml, planned)?.to_vec())
 }
 
