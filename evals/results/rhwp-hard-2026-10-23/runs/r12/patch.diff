+fn assert_untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> PatchError {
+    let expected = apply_chart_edits(xml, data, edits).unwrap_err();
+    let mut writer = RecordingWriter {
+        bytes: b"existing output".to_vec(),
+        ..RecordingWriter::default()
+    };
+    let error = write_chart_edits(xml, data, edits, &mut writer).unwrap_err();
+    assert_eq!(
+        error.source().unwrap().downcast_ref::<PatchError>(),
+        Some(&expected)
+    );
+    assert!(!error.to_string().is_empty());
+    match error {
+        WritePatchError::Patch(actual) => assert_eq!(actual, expected),
+        WritePatchError::Io(error) => panic!("unexpected I/O error: {error}"),
+    }
+    assert_eq!(writer.bytes, b"existing output");
+    assert_eq!(writer.calls, 0);
+    assert_eq!(writer.flushes, 0);
+    expected
+}
