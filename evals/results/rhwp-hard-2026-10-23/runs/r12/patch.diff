+            text: "Unicode é".into(),
+        })],
+        vec![ChartEdit::SeriesName {
+            series: 0,
+            text: "Renamed".into(),
+        }],
+        vec![ChartEdit::AppendPoints {
+            series: 0,
+            target: EditTarget::Value,
+            texts: vec!["3".into(), "4".into()],
+        }],
+        vec![ChartEdit::TruncatePoints {
+            series: 1,
+            target: EditTarget::Label,
+            keep: 1,
+        }],
+        vec![
+            ChartEdit::AppendSeries {
+                name: Some("Fourth".into()),
+                labels: Some(vec!["C".into(), "D".into()]),
+                values: vec!["5".into(), "6".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+        ],
+        vec![ChartEdit::TruncateSeries { keep: 1 }],
+        vec![
+            ChartEdit::InsertSeries {
+                at: 0,
+                name: None,
+                labels: None,
+                values: vec!["7".into(), "8".into()],
+            },
+            ChartEdit::InsertSeries {
+                at: 1,
+                name: None,
+                labels: None,
+                values: vec!["9".into(), "10".into()],
+            },
+        ],
+        vec![ChartEdit::RemoveSeries { at: 1 }],
+        vec![
+            value(0, 1, "99"),
+            ChartEdit::AppendPoints {
+                series: 2,
+                target: EditTarget::Value,
+                texts: vec!["3".into()],
+            },
+            ChartEdit::AppendSeries {
+                name: Some("Fourth".into()),
