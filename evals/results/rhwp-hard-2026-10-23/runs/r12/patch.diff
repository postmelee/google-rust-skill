+#[test]
+fn io_failure_preserves_typed_payload_and_exact_prefix() {
+    let (xml, data) = fixture();
+    let edits = [value(0, 0, "123456789")];
+    let expected = apply_chart_edits(&xml, &data, &edits).unwrap();
+    let replacement_start = data.series[0].values[0].span.as_ref().unwrap().start;
+    for limit in [0, 5, replacement_start + 2, expected.len() - 1] {
+        let payload = Arc::new(());
+        let mut writer = FailingWriter {
+            bytes: vec![],
+            remaining: limit,
+            error: Some(io::Error::other(Payload(payload.clone()))),
+            failed: false,
+            zero: false,
+        };
+        let error = write_chart_edits(&xml, &data, &edits, &mut writer).unwrap_err();
+        let source = error.source().unwrap().downcast_ref::<io::Error>().unwrap();
+        assert!(Arc::ptr_eq(
+            &source
+                .get_ref()
+                .unwrap()
+                .downcast_ref::<Payload>()
+                .unwrap()
+                .0,
+            &payload
+        ));
+        assert!(matches!(error, WritePatchError::Io(_)));
+        assert!(error.to_string().contains("custom sink failure"));
+        assert_eq!(writer.bytes, expected[..limit]);
+    }
+}
