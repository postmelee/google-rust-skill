+/// Write edited chart XML directly to a borrowed writer, including a trait object.
+///
+/// `data` must have been scanned from the same `xml`. All edits and splice spans
+/// are validated before touching `writer`: a [`WritePatchError::Patch`] leaves it
+/// untouched. Once writing begins, an I/O error may leave an output prefix;
+/// this function does not roll back output. The original error is returned in
+/// [`WritePatchError::Io`]. Short writes and interruptions follow [`Write::write_all`]
+/// semantics, including `WriteZero` when the writer stops making progress.
+///
+/// Unchanged bytes are borrowed from `xml`; only the planner's replacement and
+/// structural fragments are allocated, without buffering the whole result.
+/// The caller retains ownership of the writer, which is neither flushed nor closed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let plan = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    for chunk in plan.chunks() {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
 }
 
