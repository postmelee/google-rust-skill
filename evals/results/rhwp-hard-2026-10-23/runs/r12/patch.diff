+#[test]
+fn late_point_spans_are_validated_before_any_output() {
+    let (xml, mut data) = fixture();
+    let edits = [value(0, 0, "valid"), value(2, 1, "later")];
+    for span in [
+        xml.len()..xml.len() + 1,
+        std::ops::Range { start: 20, end: 10 },
+    ] {
+        data.series[2].values[1].span = Some(span);
+        assert!(matches!(
+            assert_untouched(&xml, &data, &edits),
+            PatchError::SpanOutOfRange { .. }
+        ));
+    }
+    data.series[2].values[1].span = data.series[0].values[0].span.clone();
+    assert!(matches!(
+        assert_untouched(&xml, &data, &edits),
+        PatchError::OverlappingSpans { .. }
+    ));
+}
