+fn chart() -> Vec<u8> {
+    let mut xml = String::from("<?xml version=\"1.0\"?><c:chart><c:plotArea><c:barChart>");
+    for i in 0..3 {
+        xml.push_str(&format!(
+            r#"<c:ser><c:idx val="{i}"/><c:order val="{i}"/><c:tx><c:v>Series {i}</c:v></c:tx><c:spPr><a:solidFill/></c:spPr><c:marker><c:symbol val="circle"/></c:marker><c:cat><c:strRef><c:f>Sheet1!A1:A2</c:f><c:strCache><c:ptCount val="2"/><c:pt idx="0"><c:v>α</c:v></c:pt><c:pt idx="1"><c:v>β</c:v></c:pt></c:strCache></c:strRef></c:cat><c:val><c:numRef><c:f>Sheet1!B1:B2</c:f><c:numCache><c:ptCount val="2"/><c:pt idx="0"><c:v>10</c:v></c:pt><c:pt idx="1"><c:v>20</c:v></c:pt></c:numCache></c:numRef></c:val><c:extLst><custom value="preserved"/></c:extLst></c:ser>"#
+        ));
+    }
+    xml.push_str("</c:barChart></c:plotArea><c:externalData r:id=\"rId1\"/></c:chart>");
+    xml.into_bytes()
+}
+
+fn value(series: usize, point: usize, text: &str) -> ChartEdit {
+    ChartEdit::Value(ValueEdit {
+        series,
+        point,
+        target: EditTarget::Value,
+        text: text.into(),
+    })
+}
+
+#[derive(Default)]
+struct Sink {
+    bytes: Vec<u8>,
+    calls: usize,
+    flushes: usize,
+    max_write: Option<usize>,
+    interrupt: bool,
+    stop_after: Option<usize>,
+    failure: Option<io::Error>,
+}
+
+impl Write for Sink {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.calls += 1;
+        if self.interrupt {
+            self.interrupt = false;
+            return Err(io::ErrorKind::Interrupted.into());
+        }
+        let remaining = self.stop_after.map_or(usize::MAX, |n| n - self.bytes.len());
+        if remaining == 0 {
+            return match self.failure.take() {
+                Some(error) => Err(error),
+                None => Ok(0),
+            };
+        }
+        let count = bytes
+            .len()
+            .min(self.max_write.unwrap_or(usize::MAX))
+            .min(remaining);
+        self.bytes.extend_from_slice(&bytes[..count]);
+        Ok(count)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.flushes += 1;
+        Ok(())
+    }
+}
