+/// Borrow unchanged XML and replacement fragments from a validated, sorted plan.
+fn splice_chunks<'a>(xml: &'a [u8], planned: &'a [Splice]) -> impl Iterator<Item = &'a [u8]> {
+    let mut cursor = 0;
+    let tail = planned.last().map_or(0, |p| p.span.end);
+    planned
+        .iter()
+        .flat_map(move |p| {
+            let unchanged = &xml[cursor..p.span.start];
+            cursor = p.span.end;
+            [unchanged, p.bytes.as_slice()]
+        })
