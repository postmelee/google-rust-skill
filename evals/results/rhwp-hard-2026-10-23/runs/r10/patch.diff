+#[test]
+fn unchanged_bytes_and_identity_edits_are_preserved() {
+    let xml = chart();
+    let data = scan_chart_values(&xml).expect("valid fixture");
+    for edits in [vec![], vec![value(0, 0, "10")]] {
+        let mut out = Vec::new();
+        write_chart_edits(&xml, &data, &edits, &mut out).expect("stream succeeds");
+        assert_eq!(out, xml);
+    }
+    let mut out = Vec::new();
+    write_chart_edits(&xml, &data, &[value(0, 0, "987654")], &mut out).expect("stream succeeds");
+    let expected =
+        String::from_utf8(xml)
+            .expect("UTF-8")
+            .replacen("<c:v>10</c:v>", "<c:v>987654</c:v>", 1);
+    assert_eq!(out, expected.as_bytes());
+    write_chart_edits(&[], &ChartData::default(), &[], &mut out).expect("empty input");
+    assert_eq!(out, expected.as_bytes());
+}
+
+fn assert_untouched(xml: &[u8], data: &ChartData, edits: &[ChartEdit], expected: PatchError) {
+    assert_eq!(apply_chart_edits(xml, data, edits), Err(expected.clone()));
+    let mut sink = Sink {
+        bytes: b"existing".to_vec(),
+        ..Sink::default()
+    };
+    let error =
+        write_chart_edits(xml, data, edits, &mut sink).expect_err("must reject invalid edits");
+    assert_eq!(
+        error.source().and_then(|e| e.downcast_ref::<PatchError>()),
+        Some(&expected)
+    );
+    assert!(error.to_string().contains(&expected.to_string()));
+    assert!(matches!(error, WritePatchError::Patch(ref actual) if actual == &expected));
+    assert_eq!(sink.bytes, b"existing");
+    assert_eq!(sink.calls, 0, "validation must precede every writer call");
+    assert_eq!(sink.flushes, 0);
+}
