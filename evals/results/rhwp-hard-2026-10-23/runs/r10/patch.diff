+#[test]
+fn io_failure_keeps_its_payload_and_stops_at_the_prefix() {
+    let xml = chart();
+    let data = scan_chart_values(&xml).expect("valid fixture");
+    let edits = [value(0, 0, "123456")];
+    let expected = apply_chart_edits(&xml, &data, &edits).expect("valid edits");
+    let replacement_start = data.series[0].values[0]
+        .span
+        .as_ref()
+        .expect("text span")
+        .start;
+    for stop in [0, replacement_start + 2, replacement_start + 9] {
+        let token = Arc::new(());
+        let mut sink = Sink {
+            stop_after: Some(stop),
+            failure: Some(io::Error::other(Payload(token.clone()))),
+            ..Sink::default()
+        };
+        let error = write_chart_edits(&xml, &data, &edits, &mut sink).expect_err("writer fails");
+        let source = error
+            .source()
+            .expect("typed cause")
+            .downcast_ref::<io::Error>()
+            .expect("I/O cause");
+        let payload = source
+            .get_ref()
+            .expect("payload")
+            .downcast_ref::<Payload>()
+            .expect("original type");
+        assert!(Arc::ptr_eq(&payload.0, &token));
+        assert!(error.to_string().contains("custom writer failure"));
+        assert!(matches!(error, WritePatchError::Io(_)));
+        assert_eq!(sink.bytes, expected[..stop]);
+        assert_eq!(sink.flushes, 0);
+        // The writer would return zero after consuming its error; reaching that
+        // state would replace the custom error with WriteZero.
+        assert!(sink.failure.is_none());
+    }
+}
