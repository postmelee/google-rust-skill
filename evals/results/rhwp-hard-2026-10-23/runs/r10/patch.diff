+#[test]
+fn write_zero_and_os_errors_remain_io_failures() {
+    let xml = chart();
+    let data = scan_chart_values(&xml).expect("valid fixture");
+    let mut sink = Sink {
+        stop_after: Some(5),
+        ..Sink::default()
+    };
+    let error = write_chart_edits(&xml, &data, &[], &mut sink).expect_err("zero write fails");
+    assert!(matches!(error, WritePatchError::Io(ref e) if e.kind() == io::ErrorKind::WriteZero));
+    assert_eq!(sink.bytes, xml[..5]);
+    assert_eq!(sink.calls, 2);
+    assert_eq!(sink.flushes, 0);
+    let mut sink = Sink {
+        stop_after: Some(0),
+        failure: Some(io::Error::from_raw_os_error(13)),
+        ..Sink::default()
+    };
+    let error = write_chart_edits(&xml, &data, &[], &mut sink).expect_err("OS failure");
+    assert!(matches!(error, WritePatchError::Io(ref e) if e.raw_os_error() == Some(13)));
+    assert_eq!(sink.calls, 1);
+}
