+/// Write chart edits directly to a borrowed sink, preserving untouched XML bytes.
+///
+/// `data` must have been scanned from the same `xml`. The writer may be a trait
+/// object. Only replacement and structural fragments are allocated; the complete
+/// input or output XML is not copied into an intermediate buffer.
+///
+/// # Errors
+///
+/// All edits, ranges, and overlaps are validated before the writer is touched.
+/// Validation failures return [`WritePatchError::Patch`]. Once writing starts,
+/// an I/O failure returns [`WritePatchError::Io`] with the original error and may
+/// leave a prefix in the sink: this API does not roll back partial output.
+/// Short writes and interruptions follow [`Write::write_all`] semantics.
+/// The caller retains ownership of the writer; it is never flushed or closed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let mut planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    validate_splices(xml, &mut planned).map_err(WritePatchError::Patch)?;
+    for bytes in splice_chunks(xml, &planned) {
+        writer.write_all(bytes).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
+}
+
+fn plan_chart_edits(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<Splice>, PatchError> {
