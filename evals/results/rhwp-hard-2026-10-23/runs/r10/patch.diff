+#[derive(Debug)]
+struct Payload(Arc<()>);
+
+impl fmt::Display for Payload {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("custom writer failure")
+    }
+}
+
+impl Error for Payload {}
