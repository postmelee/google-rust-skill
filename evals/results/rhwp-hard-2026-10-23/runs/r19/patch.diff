+        data.series[0].values[0].span.as_ref().unwrap().start + 1,
+        expected.len() - 2,
+    ] {
+        let payload = Box::new(Payload(42));
+        let original_pointer = &*payload as *const Payload;
+        let payload: Box<dyn Error + Send + Sync> = payload;
+        let mut writer = FailingWriter {
+            bytes: Vec::new(),
+            remaining: limit,
+            error: Some(io::Error::other(payload)),
+            failed: false,
+        };
+        let error = write_chart_edits(&xml, &data, &edits, &mut writer).unwrap_err();
+        let source = error.source().unwrap().downcast_ref::<io::Error>().unwrap();
+        let payload = source.get_ref().unwrap().downcast_ref::<Payload>().unwrap();
+        assert_eq!(payload as *const Payload, original_pointer);
+        assert_eq!(payload.0, 42);
+        assert!(matches!(error, WritePatchError::Io(_)));
