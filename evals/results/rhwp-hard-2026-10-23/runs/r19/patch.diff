+/// Sorted splices whose bounds and overlaps have all been validated.
+struct ValidatedSplices {
+    planned: Vec<Splice>,
+}
+
+impl ValidatedSplices {
+    fn new(xml: &[u8], mut planned: Vec<Splice>) -> Result<Self, PatchError> {
+        for p in &planned {
+            if p.span.start > p.span.end || p.span.end > xml.len() {
+                return Err(p.addr.out_of_range());
+            }
+        }
+        // Preserve planned order for coincident insertions, before replacements.
+        planned.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+        let mut cursor = 0;
+        for p in &planned {
+            if p.span.start < cursor {
+                return Err(p.addr.overlap());
+            }
+            cursor = p.span.end;
+        }
+        Ok(Self { planned })
+    }
+
+    /// Borrow unchanged input and replacement fragments without assembling XML.
+    fn chunks<'a>(&'a self, xml: &'a [u8]) -> impl Iterator<Item = &'a [u8]> {
+        let tail = self.planned.last().map_or(0, |p| p.span.end);
+        let mut cursor = 0;
+        self.planned
+            .iter()
+            .flat_map(move |p| {
+                let unchanged = &xml[cursor..p.span.start];
+                cursor = p.span.end;
+                [unchanged, p.bytes.as_slice()]
+            })
+            .chain(std::iter::once(&xml[tail..]))
+    }
+
+    fn into_bytes(self, xml: &[u8]) -> Vec<u8> {
+        let mut out = Vec::with_capacity(xml.len());
+        for chunk in self.chunks(xml) {
+            out.extend_from_slice(chunk);
+        }
+        out
+    }
+}
+
+fn splice(xml: &[u8], planned: Vec<Splice>) -> Result<Vec<u8>, PatchError> {
+    Ok(ValidatedSplices::new(xml, planned)?.into_bytes(xml))
 }
 
