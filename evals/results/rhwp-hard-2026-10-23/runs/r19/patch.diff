+/// Write chart edits directly to a borrowed sink, including a trait object.
+///
+/// `data` must have been scanned from the same `xml`. All edits and splice
+/// bounds and overlaps are validated before touching `writer`. Validation errors
+/// leave the sink completely untouched. After writing begins, an I/O error may
+/// leave a prefix of the output; this function does not roll back those bytes.
+/// The original I/O error is returned, including any custom payload.
+///
+/// Unchanged bytes are borrowed from `xml`; only the planner's replacement and
+/// structural fragments are allocated, without a second complete output buffer.
+/// Short writes and interruptions follow [`Write::write_all`] semantics. The
+/// caller retains ownership of the writer, which is neither flushed nor closed.
+pub fn write_chart_edits<W: Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let planned = plan_chart_edits(xml, data, edits).map_err(WritePatchError::Patch)?;
+    for chunk in planned.chunks(xml) {
+        writer.write_all(chunk).map_err(WritePatchError::Io)?;
+    }
+    Ok(())
 }
 
