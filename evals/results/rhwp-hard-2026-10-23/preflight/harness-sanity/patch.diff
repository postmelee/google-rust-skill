+impl std::error::Error for PatchError {}
+fn prepared(xml: &[u8], data: &ChartData, edits: &[ChartEdit]) -> Result<Vec<Splice>, PatchError> {
+    let mut planner = Planner::new(xml, data, edits);
+    for edit in edits {
+        planner.add(edit)?;
+    }
+    planner.finish()?;
+    let mut plan = planner.splices;
+    for p in &plan {
+        if p.span.start > p.span.end || p.span.end > xml.len() {
+            return Err(p.addr.out_of_range());
+        }
+    }
+    plan.sort_by_key(|p| (p.span.start, p.span.end, p.seq));
+    let mut cursor = 0;
+    for p in &plan {
+        if p.span.start < cursor {
+            return Err(p.addr.overlap());
+        }
+        cursor = p.span.end;
+    }
+    Ok(plan)
+}
+#[derive(Debug)]
+pub enum WritePatchError {
+    Patch(PatchError),
+    Io(std::io::Error),
+}
+impl std::fmt::Display for WritePatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Patch(e) => e.fmt(f),
+            Self::Io(e) => e.fmt(f),
+        }
+    }
+}
+impl std::error::Error for WritePatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Patch(e) => Some(e),
+            Self::Io(e) => Some(e),
+        }
+    }
+}
+pub fn write_chart_edits<W: std::io::Write + ?Sized>(
+    xml: &[u8],
+    data: &ChartData,
+    edits: &[ChartEdit],
+    writer: &mut W,
+) -> Result<(), WritePatchError> {
+    let plan = prepared(xml, data, edits).map_err(WritePatchError::Patch)?;
+    let mut cursor = 0;
+    for p in plan {
+        writer
+            .write_all(&xml[cursor..p.span.start])
+            .map_err(WritePatchError::Io)?;
+        writer.write_all(&p.bytes).map_err(WritePatchError::Io)?;
+        cursor = p.span.end;
+    }
+    writer
+        .write_all(&xml[cursor..])
+        .map_err(WritePatchError::Io)
+}
+#[derive(Debug)]
+pub struct OwnedPatchError {
+    xml: Vec<u8>,
+    error: PatchError,
+}
+impl OwnedPatchError {
+    pub fn error(&self) -> &PatchError {
+        &self.error
+    }
+    pub fn into_parts(self) -> (Vec<u8>, PatchError) {
+        (self.xml, self.error)
+    }
+}
+impl std::fmt::Display for OwnedPatchError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.error.fmt(f)
+    }
+}
+impl std::error::Error for OwnedPatchError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.error)
+    }
+}
+pub fn apply_chart_edits_owned(
+    mut xml: Vec<u8>,
+    data: &ChartData,
+    edits: &[ChartEdit],
+) -> Result<Vec<u8>, OwnedPatchError> {
+    let plan = match prepared(&xml, data, edits) {
+        Ok(plan) => plan,
+        Err(error) => return Err(OwnedPatchError { xml, error }),
+    };
+    let mut positions = Vec::new();
+    let mut read = 0;
+    let mut write = 0;
+    for p in &plan {
+        let gap = p.span.start - read;
+        xml.copy_within(read..p.span.start, write);
+        write += gap;
+        positions.push(write);
+        read = p.span.end;
+    }
+    let tail = xml.len() - read;
+    xml.copy_within(read.., write);
+    write += tail;
+    xml.truncate(write);
+    let final_len = write + plan.iter().map(|p| p.bytes.len()).sum::<usize>();
+    xml.resize(final_len, 0);
+    let mut read_end = write;
+    let mut write_end = final_len;
+    for (p, position) in plan.iter().zip(positions).rev() {
+        let gap = read_end - position;
+        write_end -= gap;
+        xml.copy_within(position..read_end, write_end);
+        write_end -= p.bytes.len();
+        xml[write_end..write_end + p.bytes.len()].copy_from_slice(&p.bytes);
+        read_end = position;
+    }
+    Ok(xml)
+}
